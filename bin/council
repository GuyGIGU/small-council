#!/usr/bin/env bash
# council — the Small Council's helper for the mechanical steps a model tends to skip.
#
# It opens, tracks and closes runs; runs gates and judges them by exit code; builds the change index;
# checks seat files and citations; and scans the council for drift. Output is short and plain, meant
# for the Chair to read.
#
# Portability: bash 3.2+ (macOS), Git Bash on Windows, Linux — git and POSIX tools only (awk, sed,
# grep, find, date). No associative arrays, no mapfile, no ${var,,}. Values that may hold Windows
# paths reach awk through ENVIRON, never -v (awk -v would eat the backslashes). Internal rows are
# tab-separated and never carry an empty field ("-" stands in), because `read` with IFS=tab merges
# consecutive tabs.
#
# The SessionStart hook sources this file for council_home / list_runs / seat_summary, so the hook
# and the helper always resolve the council home the same way.

set -u

COUNCIL_VERSION="0.7.0"
COUNCIL_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
TAB="$(printf '\t')"

die()     { printf 'council: %s\n' "$*" >&2; exit 2; }
say()     { printf '%s\n' "$*"; }
now_min() { date '+%Y-%m-%d %H:%M'; }
now_sec() { date '+%Y-%m-%d %H:%M:%S'; }
here()    { pwd -W 2>/dev/null || pwd; }
dash()    { if [ -n "$1" ]; then printf '%s' "$1"; else printf '%s' '-'; fi; }
undash()  { if [ "$1" = "-" ]; then printf ''; else printf '%s' "$1"; fi; }

# First "key: value" in a header-style file; carriage returns and trailing "   # comments" stripped.
field() {
  sed -n "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1 | tr -d '\r' | sed 's/[[:space:]]\{2,\}#.*$//'
}

json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\t\r\n' '   '; }

# Shorten each line to about N characters, at a space, so a multibyte character is never cut in half.
clip() { awk -v n="$1" '{ if (length($0) > n) { t = substr($0, 1, n); sub(/ [^ ]*$/, "", t); $0 = t " …" } print }'; }

# Letters and digits only, lowercased — for comparing a seat's ref: line with its doc's title.
norm() { tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'; }

# ------------------------------------------------------------------------------------------------
# Where the council lives
# ------------------------------------------------------------------------------------------------

council_toplevel() { git rev-parse --show-toplevel 2>/dev/null; }

# The .council/ of the MAIN checkout, shared by every linked worktree. A submodule keeps its own; a
# bare repo's worktrees use the first non-bare worktree; outside git it is ./.council.
council_home() {
  local top main
  top="$(council_toplevel)"
  if [ -z "$top" ]; then printf '%s/.council\n' "$(here)"; return 0; fi
  if [ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
    printf '%s/.council\n' "$top"; return 0
  fi
  main="$(git worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { if (w != "" && !b && !done) { print w; done = 1; exit } w = substr($0, 10); b = 0; next }
    /^bare$/     { b = 1 }
    END          { if (!done && w != "" && !b) print w }')"
  [ -n "$main" ] || main="$top"
  if [ ! -d "$main/.council" ] && [ -d "$top/.council" ]; then main="$top"; fi   # a 0.1 council inside a worktree
  printf '%s/.council\n' "$main"
}

# The working tree a run's code-root is compared with.
this_tree() { local t; t="$(council_toplevel)"; [ -n "$t" ] || t="$(here)"; printf '%s' "$t"; }

# The skill that owns a run, from its mode: field (0.2 runs sometimes wrote the short name).
mode_skill() {
  case "$1" in
    council-*|test-architect|spec-writer|context-core) printf '%s' "$1" ;;
    review|plan|implement|research|postgame|init) printf 'council-%s' "$1" ;;
    *) printf 'context-core' ;;
  esac
}

# Runs, newest first, tab-separated, "-" for an empty value: dir mode phase code-root updated status actual.
# $2 caps how many are listed; $3 = open (in-progress or paused, however old) | all (the newest).
list_runs() {
  local home="$1" limit="${2:-30}" which="${3:-open}"
  [ -d "$home/runs" ] || return 0
  if [ "$which" = open ]; then
    grep -l -E '^status:[[:space:]]*(in-progress|paused)' "$home"/runs/*/session-state.md 2>/dev/null | sort -r
  else
    ls -1 "$home/runs" 2>/dev/null | sort -r | while IFS= read -r name; do
      [ -f "$home/runs/$name/session-state.md" ] && printf '%s\n' "$home/runs/$name/session-state.md"
    done
  fi | head -n "$limit" | while IFS= read -r st; do
    [ -n "$st" ] || continue
    status="$(field status "$st")"; status="${status%% *}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${st%/session-state.md}" "$(dash "$(field mode "$st")")" \
      "$(dash "$(field phase "$st")")" "$(dash "$(field code-root "$st")")" "$(dash "$(field updated "$st")")" \
      "$(dash "$status")" "$(dash "$(field actual "$st")")"
  done
}

# Open runs on this working tree (a run with no code-root counts as this tree's): their folders.
# $3, if given, keeps only that status (in-progress or paused).
runs_here() {
  list_runs "$1" 50 open | TOP="$2" ST="${3:-}" awk -F'\t' '
    ($4 == ENVIRON["TOP"] || $4 == "-") && (ENVIRON["ST"] == "" || $6 == ENVIRON["ST"]) { print $1 }'
}

# Run folders (one per line) → "name, name".
names() { awk -F/ '{ printf "%s%s", (NR > 1 ? ", " : ""), $NF }'; }

# "still working: a, b · done: c · failed: d" from a run's seats.tsv; $2 renames "still working".
seat_summary() {
  [ -f "$1/seats.tsv" ] || return 0
  W="${2:-still working}" awk -F'\t' '
    NR > 1 {
      if ($2 == "running" || $2 == "queued") w = w (w ? ", " : "") $1 (($6 ~ /round 2/) ? " (war-room round 2)" : "")
      else if ($2 == "done") d = d (d ? ", " : "") $1
      else if ($2 == "failed" || $2 == "blocked") f = f (f ? ", " : "") $1
    }
    END { s = ""; if (w) s = ENVIRON["W"] ": " w; if (d) s = s (s ? " · " : "") "done: " d; if (f) s = s (s ? " · " : "") "failed: " f; printf "%s", s }' "$1/seats.tsv"
}

# The run a command acts on: --run (a path, or a folder name under runs/), then $COUNCIL_RUN, then
# the one in-progress run on this working tree. Never guesses between several, and never picks a
# paused run on its own.
resolve_run() {
  local home mine count paused
  if [ -n "$RUN_ARG" ]; then
    RUN_ARG="${RUN_ARG%/}"
    if [ ! -f "$RUN_ARG/session-state.md" ] && [ -f "$(council_home)/runs/$RUN_ARG/session-state.md" ]; then
      RUN_ARG="$(council_home)/runs/$RUN_ARG"
    fi
    [ -f "$RUN_ARG/session-state.md" ] || die "not a run folder: $RUN_ARG"
    printf '%s\n' "$RUN_ARG"; return 0
  fi
  if [ -n "${COUNCIL_RUN:-}" ] && [ -f "$COUNCIL_RUN/session-state.md" ]; then printf '%s\n' "$COUNCIL_RUN"; return 0; fi
  home="$(council_home)"
  mine="$(runs_here "$home" "$(this_tree)" in-progress)"
  count="$(printf '%s' "$mine" | grep -c . || true)"
  if [ "${count:-0}" -eq 1 ]; then printf '%s\n' "$mine"; return 0; fi
  if [ "${count:-0}" -gt 1 ]; then
    die "several runs are open on this working tree — pass --run <folder>: $(printf '%s\n' "$mine" | names)"
  fi
  paused="$(runs_here "$home" "$(this_tree)" paused | names)"
  [ -z "$paused" ] || die "no in-progress run on this working tree (paused: $paused) — pass --run <folder> to act on a paused one"
  die "no open run on this working tree — open one with: council run open <mode>   (or pass --run <folder>)"
}

# ------------------------------------------------------------------------------------------------
# Runs
# ------------------------------------------------------------------------------------------------

cmd_run_open() {
  local mode="${1:-}" short home top ts dir n existing paused session
  case "$mode" in
    council-review|council-plan|council-implement|council-research|council-postgame|council-init|test-architect|context-core) ;;
    '') die "usage: council run open <mode> [--alongside] [--session=ID]   (the skill name, e.g. council-review)" ;;
    *) die "unknown mode '$mode' — use a skill name: council-review, council-plan, council-implement, council-research, council-postgame, council-init, test-architect, context-core" ;;
  esac
  case "$mode" in council-*) short="${mode#council-}" ;; context-core) short=core ;; *) short="$mode" ;; esac
  home="$(council_home)"
  if [ ! -d "$home" ]; then
    case "$mode" in
      council-init|council-postgame)    # init maps before a config exists; a post-game may check work done without the council
        mkdir -p "$home" 2>/dev/null || die "cannot create $home"
        [ -f "$home/.gitignore" ] || printf 'runs/\nactive-run\nasks/\n' > "$home/.gitignore" ;;
      *) die "no council home at $home — run council-init first" ;;
    esac
  fi
  top="${CODE_ROOT_ARG:-$(this_tree)}"
  existing="$(runs_here "$home" "$top" in-progress | names)"
  paused="$(runs_here "$home" "$top" paused | names)"
  if [ -n "$existing" ] && [ "$ALONGSIDE" != 1 ]; then
    die "a run is already in progress on this working tree ($existing) — resume it, close it (council run close --run <folder> --status abandoned), or open this one with --alongside and pass --run <folder> to every later command"
  fi
  session="${SESSION_ARG:-${CLAUDE_CODE_SESSION_ID:-}}"      # so a compaction resumes only this session's run
  ts="$(date '+%Y-%m-%d-%H%M%S')"
  dir="$home/runs/$ts-$short"; n=2
  while [ -e "$dir" ]; do dir="$home/runs/$ts-$short-$n"; n=$((n + 1)); done
  mkdir -p "$dir/seats" "$dir/gates" 2>/dev/null || die "cannot create $dir"
  { : > "$dir/.write-check"; } 2>/dev/null && rm -f "$dir/.write-check" || die "cannot write in $dir"
  cat > "$dir/session-state.md" <<EOF
status: in-progress
mode: $mode
phase: convene
updated: $(now_min)
opened: $(now_sec)
code-root: $top
session: $session
size:
base:
deliverable:
next: size the run and ask for the go-ahead
## Decisions so far
EOF
  printf '# Run log — %s · opened %s\n' "$mode" "$(now_sec)" > "$dir/log.md"
  printf 'slug\tstate\tagent\ttokens\tupdated\tnote\tagents\n' > "$dir/seats.tsv"
  [ -z "$existing" ] || printf 'council: another run is in progress on this working tree — pass --run %s to every command for this one\n' "${dir##*/}" >&2
  [ -z "$paused" ] || printf 'council: a paused run is also open here (%s) — it stays paused\n' "$paused" >&2
  case "$mode" in
    council-review|council-plan|council-implement|council-research|council-postgame)
      printf "council: save the user's request word for word in %s/ask.md before anything else\n" "$dir" >&2 ;;
  esac
  say "$dir"
}

cmd_state() {
  local run st kv key tmp
  run="$(resolve_run)" || exit 2
  st="$run/session-state.md"
  if [ $# -eq 0 ]; then awk '/^## /{ exit } { print }' "$st"; return 0; fi
  tmp="$st.tmp$$"; cp "$st" "$tmp" || die "cannot update $st"
  for kv in "$@"; do
    key="${kv%%=*}"
    if [ "$key" = "$kv" ]; then rm -f "$tmp"; die "expected key=value, got: $kv"; fi
    case "$key" in ''|*[!a-z0-9-]*) rm -f "$tmp"; die "bad key: $key (lowercase letters, digits, dashes)" ;; esac
    if [ "$key" = status ]; then
      case "${kv#*=}" in in-progress|paused|complete|abandoned) ;; *) rm -f "$tmp"; die "status must be in-progress, paused, complete or abandoned" ;; esac
    fi
    K="$key" V="$(printf '%s' "${kv#*=}" | tr '\r\n' '  ')" awk '
      BEGIN { k = ENVIRON["K"] ":"; line = ENVIRON["K"] ": " ENVIRON["V"] }
      !done && index($0, k) == 1 { print line; done = 1; next }
      !done && /^## / { print line; done = 1 }
      { print }
      END { if (!done) print line }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  done
  NOW="$(now_min)" awk '
    BEGIN { l = "updated: " ENVIRON["NOW"] }
    !d && index($0, "updated:") == 1 { print l; d = 1; next }
    { print }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  mv "$tmp" "$st"
  say "state: phase $(field phase "$st") · $(field status "$st") · ${run##*/}"
}

# Tokens accumulate per seat (one completion notification = one agent); a new agent id on a seat
# counts as another agent — a resumed or re-dispatched worker never erases the earlier cost.
progress_line() {
  awk -F'\t' '
    NR > 1 && $2 != "skipped" {
      n++
      if ($2 == "done") d++
      else if ($2 == "running" || $2 == "queued") w = w (w ? ", " : "") $1
      else if ($2 == "failed" || $2 == "blocked") f = f (f ? ", " : "") $1
      t += $4
    }
    END {
      printf "agents: %d of %d done", d, n
      if (w) printf " · still working: %s", w
      if (f) printf " · failed: %s", f
      if (t > 0) printf " · ~%dk tokens so far", int((t + 500) / 1000)
      printf "\n"
    }' "$1/seats.tsv"
}

seat_field() {
  [ -f "$1/seats.tsv" ] || return 0
  S="$2" awk -F'\t' -v c="$3" 'NR > 1 && $1 == ENVIRON["S"] { print $c; exit }' "$1/seats.tsv"
}

cmd_seat() {
  local run slug="${1:-}" state="${2:-}" agent="" tokens="" note="" kv f
  [ -n "$slug" ] && [ -n "$state" ] || die "usage: council seat <slug> <queued|running|done|failed|blocked|skipped> [agent=ID] [tokens=N] [note=TEXT]"
  case "$state" in queued|running|done|failed|blocked|skipped) ;; *) die "seat state must be queued, running, done, failed, blocked or skipped" ;; esac
  case "$slug" in *[!A-Za-z0-9._-]*) die "bad seat slug: $slug" ;; esac
  shift 2
  for kv in ${1+"$@"}; do                            # ${1+…}: bash 3.2 calls an empty "$@" unbound under set -u
    case "$kv" in
      agent=*)  agent="${kv#agent=}" ;;
      tokens=*) tokens="$(printf '%s' "${kv#tokens=}" | tr -cd '0-9')" ;;
      note=*)   note="$(printf '%s' "${kv#note=}" | tr '\t\r\n' '   ')" ;;
      *) die "unknown seat field: $kv (use agent=, tokens=, note=)" ;;
    esac
  done
  run="$(resolve_run)" || exit 2
  f="$run/seats.tsv"
  [ -f "$f" ] || printf 'slug\tstate\tagent\ttokens\tupdated\tnote\tagents\n' > "$f"
  SLUG="$slug" STATE="$state" AGENT="$agent" TOKENS="$tokens" NOTE="$note" NOW="$(now_min)" awk -F'\t' -v OFS='\t' '
    NR == 1 { if (NF < 7) $0 = $0 "\tagents"; print; next }
    $1 == ENVIRON["SLUG"] {
      found = 1
      ag = ($7 == "" ? 1 : $7 + 0)
      if (ENVIRON["AGENT"] != "" && $3 != "" && ENVIRON["AGENT"] != $3) ag++
      a = ENVIRON["AGENT"]  != "" ? ENVIRON["AGENT"] : $3
      t = ENVIRON["TOKENS"] != "" ? $4 + ENVIRON["TOKENS"] : $4
      n = ENVIRON["NOTE"]   != "" ? ENVIRON["NOTE"] : $6
      print $1, ENVIRON["STATE"], a, t, ENVIRON["NOW"], n, ag
      next
    }
    { print }
    END { if (!found) print ENVIRON["SLUG"], ENVIRON["STATE"], ENVIRON["AGENT"], ENVIRON["TOKENS"], ENVIRON["NOW"], ENVIRON["NOTE"], 1 }' \
    "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  progress_line "$run"
}

cmd_run_close() {
  local run status home ptr p tok=0 agents=0 line n lg
  status="${STATUS_ARG:-complete}"
  case "$status" in complete|abandoned|paused) ;; *) die "--status must be complete, abandoned or paused" ;; esac
  run="$(resolve_run)" || exit 2
  if [ -f "$run/seats.tsv" ]; then
    line="$(awk -F'\t' 'NR > 1 && $2 != "skipped" && $2 != "queued" { a += ($7 == "" ? 1 : $7); t += $4 } END { printf "%d %d", a, t }' "$run/seats.tsv")"
    agents="${line%% *}"; tok="${line#* }"
  fi
  if [ "$tok" -gt 0 ] 2>/dev/null; then
    RUN_ARG="$run" cmd_state status="$status" closed="$(now_sec)" actual="~$(( (tok + 500) / 1000 ))k tokens across $agents agents" >/dev/null
  else
    RUN_ARG="$run" cmd_state status="$status" closed="$(now_sec)" >/dev/null
  fi
  home="$(council_home)"; ptr="$home/active-run"
  if [ -s "$ptr" ]; then                      # the 0.1/0.2 single pointer: empty it if it names this run
    p="$(head -n 1 "$ptr" | tr -d '\r')"
    case "$p" in /*|[A-Za-z]:*) ;; *) p="$(dirname "$home")/$p" ;; esac
    [ "$p" = "$run" ] && : > "$ptr"
  fi
  if [ "$tok" -gt 0 ] 2>/dev/null; then
    say "closed ${run##*/} — $status · ~$(( (tok + 500) / 1000 ))k tokens across $agents agents"
  else
    say "closed ${run##*/} — $status"
  fi
  if [ "$status" = complete ]; then
    n="$(ledger_record "$run")"
    [ "${n:-0}" -eq 0 ] 2>/dev/null || say "ledger: $n seat row(s) recorded — council ledger shows each seat's record"
    case "$(field mode "$run/session-state.md")" in       # a deliverable without the user's words can't be post-gamed
      council-review|council-plan|council-implement|council-research|council-postgame)
        [ -n "$(field ask-saved "$run/session-state.md")" ] \
          || printf 'council: no request was filed for this run — council ask save --run %s\n' "${run##*/}" >&2 ;;
    esac
    if [ "$(field mode "$run/session-state.md")" = council-implement ]; then
      lg="$(grep -lE "(^|[^0-9A-Za-z-])${run##*/}([^0-9A-Za-z-]|\$)" "$home"/logs/*.md 2>/dev/null | head -n 1)"
      if [ -z "$lg" ]; then
        printf 'council: no build log names this run — write %s/logs/<date>-<slug>.md with "Run: %s" and a "## Shortcuts and concessions" section\n' "$home" "${run##*/}" >&2
      elif ! grep -q '^## Shortcuts and concessions' "$lg"; then
        printf 'council: the log has no "## Shortcuts and concessions" section — say what was traded away, or the single word none: %s\n' "$lg" >&2
      fi
    fi
  fi
}

cmd_run_status() {
  local home which runs
  home="$(council_home)"
  [ -d "$home" ] || { say "no council here (no $home) — run council-init"; return 0; }
  if [ "$ALL" = 1 ]; then which=all; else which=open; fi
  runs="$(list_runs "$home" 20 "$which")"
  if [ -z "$runs" ]; then
    if [ "$which" = open ]; then say "no open council runs"; else say "no council runs yet"; fi
    return 0
  fi
  printf '%s\n' "$runs" | TOP="$(this_tree)" awk -F'\t' '{
    n = split($1, p, "/")
    where = ($4 == ENVIRON["TOP"] || $4 == "-") ? "here" : "elsewhere: " $4
    printf "%s · %s · phase %s · %s · updated %s · %s", p[n], $2, $3, $6, $5, where
    if ($7 != "-") printf " · %s", $7
    printf "\n" }'
}

# ------------------------------------------------------------------------------------------------
# Change index
# ------------------------------------------------------------------------------------------------

default_branch() {
  local b
  b="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  if [ -n "$b" ]; then printf '%s\n' "$b"; return 0; fi
  for b in main master trunk develop; do
    if git rev-parse -q --verify "refs/heads/$b" >/dev/null 2>&1; then printf '%s\n' "$b"; return 0; fi
  done
  return 1
}

not_indexed() {
  case "$1" in
    *package-lock.json|*yarn.lock|*pnpm-lock.yaml|*poetry.lock|*Pipfile.lock|*Cargo.lock|*go.sum|*composer.lock|*Gemfile.lock|*.lock) return 0 ;;
    node_modules/*|*/node_modules/*|vendor/*|*/vendor/*|dist/*|*/dist/*|build/*|*/build/*|*.min.js|*.min.css|*.map) return 0 ;;
  esac
  return 1
}

# Text and data files: their hunks are listed, but they have no symbols worth tracing.
no_symbols() {
  case "$1" in
    *.md|*.markdown|*.txt|*.rst|*.adoc|*.json|*.yml|*.yaml|*.toml|*.ini|*.cfg|*.conf|*.csv|*.tsv|*.svg|*.xml|*.html|*.css|*.scss|*.lock|*.env) return 0 ;;
  esac
  return 1
}

is_test_path() {
  case "$1" in
    test/*|tests/*|spec/*|*/test/*|*/tests/*|*/spec/*|*/__tests__/*|*/testing/*|test_*|*/test_*|*_test.*|*.test.*|*.spec.*|*_spec.*|*Test.*|*Tests.*) return 0 ;;
  esac
  return 1
}

# Definition names from diff lines (+/-) and hunk-header context. Heuristic and language-agnostic:
# def/class/func/fn/…, const-arrow functions, Go methods, shell "name() {", and C-style signatures —
# never a bare call.
diff_symbols() {
  awk '
    function add(s) { if (length(s) < 3 || (s in seen) || (s in skip)) return; seen[s] = 1; out = out (out ? " " : "") s; n++ }
    function def(l,   s, p) {
      p = " " l
      if (match(p, /func[ \t]*\([^)]*\)[ \t]*[A-Za-z_][A-Za-z0-9_]*/)) { s = substr(p, RSTART, RLENGTH); sub(/^.*[) \t]/, "", s); return s }
      if (match(p, /[ \t](def|class|function|func|fn|sub|interface|struct|enum|trait|type|module|signal|class_name)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { s = substr(p, RSTART, RLENGTH); sub(/^.*[ \t]/, "", s); return s }
      if (match(p, /[ \t](const|let|var)[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*(async[ \t]*)?(\(|function)/)) { s = substr(p, RSTART, RLENGTH); sub(/^[ \t]*(const|let|var)[ \t]+/, "", s); sub(/[ \t]*=.*$/, "", s); return s }
      if (match(l, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)[ \t]*(\{|$)/)) { s = substr(l, RSTART, RLENGTH); sub(/^[ \t]*/, "", s); sub(/[ \t]*\(.*$/, "", s); return s }
      if (l !~ /^[ \t]/ && l !~ /;[ \t]*$/ && l !~ /^(if|for|while|switch|return|else|do|case|catch|elif)[ \t(]/ && match(l, /^[A-Za-z_][A-Za-z0-9_:<>,*& \t]*[ \t*&][A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)) {
        s = substr(l, RSTART, RLENGTH); sub(/[ \t]*\($/, "", s); sub(/^.*[ \t*&:]/, "", s); return s
      }
      return ""
    }
    BEGIN {
      split("if for while return switch catch else elif function def class self this true false null none nil new try with from import export async await public private protected static void int string bool var let const func fn match case default print main", k, " ")
      for (i in k) skip[k[i]] = 1
    }
    n >= 8 { exit }
    /^@@/ { ctx = $0; sub(/^@@[^@]*@@[ \t]*/, "", ctx); add(def(ctx)); next }
    /^(\+\+\+|---)/ { next }
    /^[-+]/ { add(def(substr($0, 2))) }
    END { print out }'
}

cmd_index() {
  local run top ref base head list body out st f label add del hunks diff nums syms sym hits callers tests stem note prior np=0
  local n_files=0 n_skip=0 t_add=0 t_del=0 budget=80
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  cd "$top" 2>/dev/null || die "cannot enter the code root: $top"
  git rev-parse --git-dir >/dev/null 2>&1 || die "the code root is not a git repository — the change index needs git"
  if [ -n "$BASE_ARG" ]; then ref="$BASE_ARG"; else ref="$(default_branch)" || ref="HEAD"; fi
  base="$(git merge-base HEAD "$ref" 2>/dev/null)" || base=""
  [ -n "$base" ] || base="$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null)" || base=""
  [ -n "$base" ] || die "unknown base: $ref"
  head="$(git rev-parse --short HEAD 2>/dev/null)"
  list="$run/.index-files"; body="$run/.index-body"; out="$run/index.md"
  { git diff --name-status "$base" -- . 2>/dev/null | awk -F'\t' '{ print substr($1, 1, 1) "\t" $NF }'
    git ls-files --others --exclude-standard 2>/dev/null | awk '{ print "?\t" $0 }'
  } | sort -t "$TAB" -k2,2 -u > "$list"
  : > "$body"
  while IFS="$TAB" read -r st f; do
    [ -n "$f" ] || continue
    case "$f" in .council/*) continue ;; esac          # the council's own files are never part of a change
    if not_indexed "$f" || [ "$n_files" -ge 80 ]; then n_skip=$((n_skip + 1)); continue; fi
    n_files=$((n_files + 1))
    if [ "$st" = "?" ]; then
      label="new, untracked"; add="$(awk 'END { print NR }' "$f" 2>/dev/null)"; del=0
      hunks="1-${add:-0}"; diff="$(head -n 400 "$f" 2>/dev/null | sed 's/^/+/')"
    else
      case "$st" in A) label=added ;; D) label=deleted ;; R) label=renamed ;; *) label=modified ;; esac
      nums="$(git diff --numstat "$base" -- "$f" 2>/dev/null | head -n 1)"
      add="$(printf '%s' "$nums" | cut -f1)"; del="$(printf '%s' "$nums" | cut -f2)"
      if [ "$add" = "-" ]; then printf '## %s  (%s, binary)\n\n' "$f" "$label" >> "$body"; continue; fi
      diff="$(git diff -U0 "$base" -- "$f" 2>/dev/null)"
      hunks="$(printf '%s\n' "$diff" | awk '
        /^@@/ {
          if (match($0, /\+[0-9]+(,[0-9]+)?/)) {
            s = substr($0, RSTART + 1, RLENGTH - 1); c = split(s, a, ","); b = a[1] + 0; k = (c > 1 ? a[2] + 0 : 1)
            r = (k == 0 ? "removed near " b : (k == 1 ? b : b "-" (b + k - 1)))
            out = out (out ? ", " : "") r
          }
        }
        END { print out }')"
    fi
    syms=""; callers=""; tests=""; note=""
    if ! no_symbols "$f"; then
      syms="$(printf '%s\n' "$diff" | diff_symbols)"
      for sym in $syms; do
        if [ "$budget" -le 0 ]; then note="callers and tests not searched (search budget spent)"; break; fi
        budget=$((budget - 1))
        hits="$(git grep -n -I -w -F -e "$sym" -- . ":(exclude)$f" 2>/dev/null | grep -v '^\.council/' | head -n 4 \
          | awk -F: -v s="$sym" '{ printf "%s%s:%s (%s)", (NR > 1 ? " · " : ""), $1, $2, s }')"
        [ -n "$hits" ] && callers="$callers${callers:+ · }$hits"
      done
      stem="${f##*/}"; stem="${stem%.*}"
      if is_test_path "$f"; then
        tests="(this is a test file)"
      elif [ "${#stem}" -ge 3 ] && [ -z "$note" ]; then
        if [ "$budget" -gt 0 ]; then
          budget=$((budget - 1))
          tests="$(git grep -l -I -w -F -e "$stem" -- ':(glob)**/test/**' ':(glob)**/tests/**' ':(glob)**/spec/**' \
            ':(glob)**/__tests__/**' ':(glob)**/test_*' ':(glob)**/*_test.*' ':(glob)**/*.test.*' ':(glob)**/*.spec.*' \
            ':(glob)**/*_spec.*' ':(glob)**/*Test.*' ":(exclude)$f" 2>/dev/null | head -n 4 | paste -sd ',' - | sed 's/,/, /g')"
        else
          note="callers and tests not searched (search budget spent)"
        fi
      fi
    fi
    {
      printf '## %s  (%s, +%s/-%s)\n' "$f" "$label" "${add:-0}" "${del:-0}"
      printf -- '- hunks: %s\n' "${hunks:--}"
      [ -z "$syms" ]    || printf -- '- symbols: %s\n' "$(printf '%s' "$syms" | sed 's/ /, /g')"
      [ -z "$callers" ] || printf -- '- callers: %s\n' "$callers"
      [ -z "$tests" ]   || printf -- '- tests: %s\n' "$tests"
      [ -z "$note" ]    || printf -- '- note: %s\n' "$note"
      printf '\n'
    } >> "$body"
    case "$add" in ''|*[!0-9]*) ;; *) t_add=$((t_add + add)) ;; esac
    case "$del" in ''|*[!0-9]*) ;; *) t_del=$((t_del + del)) ;; esac
  done < "$list"
  {
    printf '# Change index — %s\n' "${run##*/}"
    printf 'base: %s (%s) · head: %s%s · generated: %s\n' "$(git rev-parse --short "$base")" "$ref" "$head" \
      "$(git diff --quiet 2>/dev/null || printf ' + uncommitted changes')" "$(now_sec)"
    printf 'files: %d (+%d/-%d)' "$n_files" "$t_add" "$t_del"
    [ "$n_skip" -eq 0 ] || printf ' · not indexed: %d (lockfiles, vendored or generated files, or past the 80-file cap)' "$n_skip"
    printf '\nSymbols come from definitions in the diff; callers and tests are matched by name (git grep) —\na starting point for tracing, not proof.\n\n'
    cat "$body"
  } > "$out"
  rm -f "$list" "$body"
  prior=""
  if [ "$(field mode "$run/session-state.md")" = council-postgame ]; then
    # A post-game's verifier reads index.md and must never see the plan, the logs or their verdicts;
    # its Chair runs `council prior` for itself.
    say "index: earlier council work left out (a post-game's verifier reads this file) — run council prior yourself"
  else
    prior="$(index_paths "$run" | prior_hits "$(council_home)" | head -n 40)"
  fi
  if [ -n "$prior" ]; then
    np="$(printf '%s\n' "$prior" | grep -c .)"
    { printf '## Earlier council work on these files\n'
      printf '%s\n' "$prior" | awk -F'\t' '{ printf "- %s — %s — %s\n", $1, $2, $3 }'; } >> "$out"
  fi
  RUN_ARG="$run" cmd_state base="$base" >/dev/null
  if [ "$n_files" -eq 0 ]; then
    say "index: nothing changed since $(git rev-parse --short "$base") ($ref) → $out"
  else
    say "index: $n_files files (+$t_add/-$t_del) → $out"
  fi
  [ "$np" -eq 0 ] || say "earlier council work on these files: $np mention(s), listed at the end of the index"
}

# ------------------------------------------------------------------------------------------------
# Gates
# ------------------------------------------------------------------------------------------------

# The config's Gates table as tab-separated rows: name command run-at mandatory cell-count checked
# side-effects needs header-cell-count has-side-effects-column. Columns are found by their header names
# (case, spaces and dashes ignored), so an older table (no Side effects or Needs) still reads.
# Cells split on "|" outside backticks and unescaped, so a quoted pipe can't shift the columns.
config_gates() {
  [ -f "$1" ] || return 0
  awk '
    function cells(line, out,    i, c, cur, inq, n) {
      n = 0; cur = ""; inq = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (c == "\\" && substr(line, i + 1, 1) == "|") { cur = cur "|"; i++; continue }
        if (c == "`") inq = !inq
        if (c == "|" && !inq) { out[++n] = cur; cur = ""; continue }
        cur = cur c
      }
      out[++n] = cur
      return n
    }
    function trim(s) { gsub(/\t/, " ", s); gsub(/^[ \r]+|[ \r]+$/, "", s); return s }
    function dash(s) { return s == "" ? "-" : s }
    /^## / { ing = ($0 ~ /^## Gates/); hdr = 0; next }
    ing && /^\|/ {
      split("", f); k = cells($0, f)
      if (!hdr) {                                   # the header row names the columns; it is never a gate
        hdr = 1; hk = k; cg = 2; cc = 3; ca = 4; cm = 5; ck = 6; cs = 0; cn = 0
        for (i = 2; i < k; i++) {
          h = tolower(trim(f[i])); gsub(/[^a-z]/, "", h)
          if (h == "gate" || h == "name") cg = i; else if (h == "command") cc = i; else if (h == "runat") ca = i
          else if (h == "mandatory") cm = i; else if (h == "checked") ck = i
          else if (h == "sideeffects" || h == "sideeffect") cs = i; else if (h == "needs") cn = i
        }
        next
      }
      name = trim(f[cg]); cmd = trim(f[cc]); at = trim(f[ca]); mand = trim(f[cm]); chk = trim(f[ck])
      side = cs ? trim(f[cs]) : ""; needs = cn ? trim(f[cn]) : ""
      gsub(/`/, "", cmd)
      if (name == "" || name ~ /^:?-+:?$/ || name ~ /^</) next
      if (cmd == "" || cmd ~ /^</) next
      print name "\t" cmd "\t" dash(at) "\t" dash(mand) "\t" k "\t" dash(chk) "\t" dash(side) "\t" dash(needs) "\t" hk "\t" (cs ? 1 : 0)
    }' "$1"
}

cmd_gates() {
  local cfg gates
  cfg="$(council_home)/council.config.md"
  gates="$(config_gates "$cfg")"
  [ -n "$gates" ] || { say "no gates in $cfg"; return 0; }
  printf '%s\n' "$gates" | awk -F'\t' '{
    printf "%s · %s · run at: %s · mandatory: %s", $1, $2, $3, $4
    if ($7 != "-") printf " · side effects: %s", $7
    printf "\n" }'
}

# May `gate --all` run this gate unasked? With a Side effects column: only if every side effect is on
# the safe list (none, writes the tree, network) and Needs names no credentials or hardware — anything
# unlisted or unrecorded runs by name only. An older table without the column falls back to scanning
# the command and Needs for risky words.
gate_safe() {
  local cmd="$1" side="$2" needs="$3" hascol="$4" item
  case "$(printf '%s' "$needs" | tr 'A-Z' 'a-z')" in
    *credential*|*secret*|*token*|*password*|*api?key*|*apikey*|*hardware*|*device*) return 1 ;;
  esac
  if [ "$hascol" != 1 ]; then
    if risky_side "$cmd $needs"; then return 1; fi
    return 0
  fi
  [ "$side" != "-" ] || return 1
  while IFS= read -r item; do
    case "$(printf '%s' "$item" | tr 'A-Z' 'a-z')" in
      none|"writes the tree"|"writes files"|network|-|—) ;;
      *) return 1 ;;
    esac
  done <<ITEMS
$(split_list "$side")
ITEMS
  return 0
}

# Words that mark a command or a need as risky — the fallback for tables without a Side effects column.
risky_side() {
  case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
    *cost*|*money*|*paid*|*billing*|*hardware*|*device*|*flash*|*deploy*|*publish*|*credential*|*secret*|*production*) return 0 ;;
  esac
  return 1
}

gate_base() { printf '%s/gates/%s' "$1" "$(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '_')"; }

# Run one gate; full output to <run>/gates/<name>.txt, the verdict to <name>.json. Returns its exit code.
run_gate() {
  local run="$1" name="$2" cmd="$3" top="$4" base out start ec secs hits
  GATE_EMPTY=0
  base="$(gate_base "$run" "$name")"; out="$base.txt"
  mkdir -p "$run/gates"
  start="$(date +%s)"
  ( cd "$top" 2>/dev/null || exit 97; bash -c "$cmd" < /dev/null ) > "$out" 2>&1
  ec=$?
  secs=$(( $(date +%s) - start ))
  printf '{"gate": "%s", "command": "%s", "exit": %d, "seconds": %d, "when": "%s"}\n' \
    "$(json_esc "$name")" "$(json_esc "$cmd")" "$ec" "$secs" "$(now_sec)" > "$base.json"
  if [ "$ec" -eq 0 ]; then
    if grep -q '^changed: no files matched' "$out" 2>/dev/null; then
      GATE_EMPTY=1                    # it passed because there was nothing to look at, not because it looked
      say "gate $name: pass — but nothing to check (0 files matched)"
    else
      say "gate $name: pass (exit 0, ${secs}s)"
    fi
    return 0
  fi
  [ "$ec" -ne 97 ] || say "gate $name: could not enter the code root: $top"
  say "gate $name: FAIL (exit $ec, ${secs}s) — full output: $out"
  hits="$(grep -n -i -E 'error|fail|exception|traceback|assert|panic|cannot|not found|undefined' "$out" 2>/dev/null | head -n 12)"
  [ -n "$hits" ] || hits="$(tail -n 8 "$out")"
  printf '%s\n' "$hits" | clip 220 | sed 's/^/    /'
  return "$ec"
}

cmd_gate() {
  local run top cfg name cmd at mand k chk side needs hk hascol extra row ran=0 skipped=0 failed=0 gates \
        passed=0 nfail=0 red="" tail="" ismand=0 skipm=0 reds="" empty=0 noth=""
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  cfg="$(council_home)/council.config.md"
  if [ "$ALL" = 1 ]; then
    gates="$(config_gates "$cfg")"
    if [ -z "$gates" ]; then      # a green report with nothing behind it is the worst outcome there is
      say "NOTHING WAS CHECKED — this project has no automated check configured (no Gates row in $cfg)"
      return 4
    fi
    while IFS="$TAB" read -r name cmd at mand k chk side needs hk hascol; do
      [ -n "$name" ] || continue
      if [ "$k" != "$hk" ]; then     # before the --at filter: a shifted row's Run-at cell means nothing
        say "gate $name: skipped — its row has $k cells where the header has $hk (an unescaped | ?); fix the row"
        skipped=$((skipped + 1)); continue
      fi
      case "$(printf '%s' "$mand" | tr 'A-Z' 'a-z')" in yes*|y|true|mandatory) ismand=1 ;; *) ismand=0 ;; esac
      if [ -n "$AT_ARG" ]; then
        case "$at" in
          *"$AT_ARG"*) ;;
          ''|-)                       # no stage at all: it runs in no set, which must never be silent
            say "gate $name: skipped — its Run at cell is empty, so it runs only by name; fill it in (grounding, verify)"
            skipped=$((skipped + 1)); [ "$ismand" -eq 0 ] || { skipm=$((skipm + 1)); reds="${reds:+$reds, }$name"; }
            continue ;;
          *) continue ;;              # it belongs to another stage: ordinary, and not this run's business
        esac
      fi
      case "$(printf '%s' "$chk" | tr 'A-Z' 'a-z')" in
        ✗*|*"not probed"*)
          say "gate $name: skipped — the config marks it not runnable here ($chk)"
          skipped=$((skipped + 1)); [ "$ismand" -eq 0 ] || { skipm=$((skipm + 1)); reds="${reds:+$reds, }$name"; }
          continue ;;
      esac
      if ! gate_safe "$cmd" "$side" "$needs" "$hascol"; then
        extra=""; [ "$needs" = "-" ] || extra=" · needs: $needs"
        if [ "$hascol" != 1 ]; then
          say "gate $name: skipped — its command or needs look risky ($cmd$extra). Run it by name once the user agrees: council gate $name"
        elif [ "$side" = "-" ]; then
          say "gate $name: skipped — side effects not recorded. Fill the cell, or run it by name once the user agrees: council gate $name"
        else
          say "gate $name: skipped — side effects: $side$extra. Run it by name once the user agrees: council gate $name"
        fi
        skipped=$((skipped + 1)); [ "$ismand" -eq 0 ] || { skipm=$((skipm + 1)); reds="${reds:+$reds, }$name"; }
        continue
      fi
      ran=$((ran + 1))
      if run_gate "$run" "$name" "$cmd" "$top"; then
        passed=$((passed + 1))
        [ "$GATE_EMPTY" != 1 ] || { empty=$((empty + 1)); noth="${noth:+$noth, }$name"; }
      else
        red="${red:+$red, }$name"       # already delimited: a gate name may contain spaces
        [ "$ismand" -eq 0 ] || failed=1
      fi
    done <<GATES
$gates
GATES
    if [ "$ran" -eq 0 ]; then
      if [ "$skipped" -eq 0 ]; then
        say "NOTHING WAS CHECKED — no gate in $cfg runs${AT_ARG:+ at '$AT_ARG'}"
      else
        say "NOTHING WAS CHECKED — $skipped gate(s) could not run here${AT_ARG:+ at '$AT_ARG'}; see the reasons above"
      fi
      return 4
    fi
    nfail=$((ran - passed))
    if [ "$skipped" -gt 0 ]; then
      tail=" · $skipped skipped"
      [ "$skipm" -eq 0 ] || tail="$tail ($skipm of them required: $reds — so this run proves less than it looks)"
    fi
    [ "$empty" -eq 0 ] || tail="$tail · $empty had nothing to check ($noth — 0 files matched)"
    if [ "$nfail" -eq 0 ]; then
      say "gates: $ran ran — all pass$tail"
    else
      if [ "$failed" -eq 1 ]; then say "gates: $ran ran — $passed pass, $nfail FAIL ($red — mandatory)$tail"
      else say "gates: $ran ran — $passed pass, $nfail FAIL ($red, not mandatory)$tail"; fi
    fi
    [ "$failed" -eq 0 ] || say "a mandatory gate failed"
    return "$failed"
  fi
  name="${1:-}"
  [ -n "$name" ] || die "usage: council gate <name> [-- '<command>']   |   council gate --all [--at grounding|verify]"
  cmd="$GATE_CMD"
  if [ -z "$cmd" ]; then
    row="$(config_gates "$cfg" | NAME="$name" awk -F'\t' '$1 == ENVIRON["NAME"] { print; exit }')"
    [ -n "$row" ] || die "no gate named '$name' in council.config.md — pass the command after --"
    cmd="$(printf '%s' "$row" | cut -f2)"; chk="$(printf '%s' "$row" | cut -f6)"; side="$(printf '%s' "$row" | cut -f7)"
    needs="$(printf '%s' "$row" | cut -f8)"; hascol="$(printf '%s' "$row" | cut -f10)"
    case "$(printf '%s' "$chk" | tr 'A-Z' 'a-z')" in
      ✗*|*"not probed"*) say "note: the config marks this gate not runnable here ($chk)" ;;
    esac
    if ! gate_safe "$cmd" "$side" "$needs" "$hascol"; then
      extra=""; [ "$needs" = "-" ] || extra=" · needs: $needs"
      say "note: this gate has side effects ($side)$extra — run it only with the user's go-ahead"
    fi
  fi
  case "$cmd" in *'|'*) say "note: this gate command contains a pipe — its exit code may not be the test runner's" ;; esac
  run_gate "$run" "$name" "$cmd" "$top"
}

# ------------------------------------------------------------------------------------------------
# Changed files — so a newly fitted check judges only what this change touched
# ------------------------------------------------------------------------------------------------

# council changed [--base <ref>] [--glob '<pattern>' …] [--each] [-- <command> …]
# The files this change touches: committed on this branch since <base>, staged, unstaged, and new
# files git doesn't track yet. With no command it lists them. With one it runs the command over them
# and exits 0 when nothing matched — so a linter fitted to an old project is green on day one and can
# only ever get stricter, instead of printing a thousand complaints about code that was already there.
# --each runs the command once per file, for tools that only read their first argument (bash -n).
cmd_changed() {
  local top ref base each=0 f worst=0 st
  local -a globs files
  globs=(); files=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --glob)   [ $# -ge 2 ] || die "--glob needs a pattern"; globs+=("$2"); shift 2 ;;
      --glob=*) globs+=("${1#--glob=}"); shift ;;
      --each)   each=1; shift ;;
      *) die "usage: council changed [--base <ref>] [--glob '<pattern>'] [--each] -- <command> …" ;;
    esac
  done
  top="${CODE_ROOT_ARG:-$(this_tree)}"
  cd "$top" 2>/dev/null || die "cannot enter the code root: $top"
  git rev-parse --git-dir >/dev/null 2>&1 || die "council changed needs a git repository"
  if [ -n "$BASE_ARG" ]; then
    ref="$BASE_ARG"
    base="$(git merge-base HEAD "$ref" 2>/dev/null)" \
      || base="$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null)" \
      || die "council changed: '$ref' is not a ref in this repository — the committed half of the change would be skipped in silence"
  else
    ref="$(default_branch)" || ref="HEAD"
    base="$(git merge-base HEAD "$ref" 2>/dev/null)" || base=""
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in '"'*) f="$(printf '%s' "$f" | sed 's/^"//; s/"$//')" ;; esac   # git quotes odd names
    [ -f "$f" ] || continue                       # deleted, or renamed away: there is nothing to check
    files+=("$f")
  done <<FILES
$( { [ -z "$base" ] || git -c core.quotePath=false diff --name-only --diff-filter=ACMR "$base"...HEAD -- ${globs[@]+"${globs[@]}"} 2>/dev/null
     git -c core.quotePath=false diff --name-only --diff-filter=ACMR HEAD -- ${globs[@]+"${globs[@]}"} 2>/dev/null
     git -c core.quotePath=false ls-files -o --exclude-standard -- ${globs[@]+"${globs[@]}"} 2>/dev/null; } | sort -u )
FILES
  if [ "${#files[@]}" -eq 0 ]; then
    say "changed: no files matched — nothing to check (this is a pass, not a skip)"
    return 0
  fi
  if [ "${#AFTER_DD[@]}" -eq 0 ]; then printf '%s\n' "${files[@]}"; return 0; fi
  printf 'changed: %s file(s) to check\n' "${#files[@]}" >&2
  if [ "$each" = 1 ]; then
    for f in "${files[@]}"; do
      "${AFTER_DD[@]}" "$f" || { st=$?; [ "$st" -le "$worst" ] || worst="$st"; }
    done
    return "$worst"
  fi
  "${AFTER_DD[@]}" "${files[@]}"
}

# ------------------------------------------------------------------------------------------------
# Seat files and citations
# ------------------------------------------------------------------------------------------------

# The brief's "## Seats" blocks as rows: slug refs out cap. A paired worker's block has one "- ref:"
# line per doc; they come out joined by " ;; ". Backticks and quotes around values are stripped.
brief_seats() {
  awk '
    function clean(v) { gsub(/[`"\r]/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v); return v }
    /^## / { ins = ($0 ~ /^## Seats[ \t\r]*$/); next }
    !ins { next }
    /^### / {
      if (slug != "") print slug "\t" ref "\t" out "\t" cap
      slug = $0; sub(/^###[ \t]*/, "", slug); sub(/[ \t].*$/, "", slug); gsub(/[`"\r]/, "", slug)
      ref = "none"; out = "seats/" slug ".md"; cap = 8; next
    }
    /^- ref:/ { v = $0; sub(/^- ref:[ \t]*/, "", v); v = clean(v); if (v != "" && v != "none") ref = (ref == "none" ? v : ref " ;; " v); next }
    /^- out:/ { v = $0; sub(/^- out:[ \t]*/, "", v); v = clean(v); if (v != "") out = v; next }
    /^- cap:/ { v = $0; sub(/^- cap:[ \t]*/, "", v); if (match(v, /[0-9]+/)) cap = substr(v, RSTART, RLENGTH); next }
    END { if (slug != "") print slug "\t" ref "\t" out "\t" cap }' "$1"
}

ref_title() { awk 'NR == 1 { sub(/^\357\273\277/, ""); sub(/^#+[ \t]*/, ""); print; exit }' "$1" 2>/dev/null | norm; }

# Index lines — "<n> · <severity> · <principle> · <path:line> · <title>[ · …]", optionally written as a
# list item ("- 1 · …", "1. · …") — as rows: n sev principle cite title ("-" for an empty value).
index_lines() {
  awk '
    function dash(s) { return s == "" ? "-" : s }
    /^[-*]?[ \t]*C?[0-9]+\.?[ \t]+(·|\|)[ \t]/ {
      line = $0; gsub(/\r/, "", line); sub(/^[-*]?[ \t]*/, "", line)
      k = split(line, f, /[ \t]+(·|\|)[ \t]+/)
      if (k < 4) next
      n = f[1]; sub(/\.$/, "", n)
      c = f[4]; gsub(/[`"]/, "", c)
      printf "%s\t%s\t%s\t%s\t%s\n", n, dash(f[2]), dash(f[3]), dash(c), dash(k >= 5 ? f[5] : "")
    }' "$1" 2>/dev/null
}

# The ## Index section's shape: "<parsed items> <item lines that don't parse> <has a (none) line>".
# A line counts as an attempted item if it starts with a number (after an optional bullet) or holds
# " · "; any other prose under the heading is ignored.
index_shape() {
  awk '
    /^## Index/ { ins = 1; next }
    ins && /^##/ { ins = 0 }
    ins {
      l = $0; gsub(/\r/, "", l)
      if (l ~ /^[ \t]*$/) next
      if (l ~ /^[ \t]*\(none\)/) { none = 1; next }
      if (l ~ /^[-*]?[ \t]*C?[0-9]+\.?[ \t]+(·|\|)[ \t]/) { ok++; next }
      if (l ~ /^[ \t]*([-*+][ \t]+)?[*_]*C?[0-9]+/ || l ~ / · /) bad++
    }
    END { printf "%d %d %d\n", ok, bad, none }' "$1" 2>/dev/null
}

# The line part of a citation — "12", "7-9", or a comma list of both in any mix, such as "12,40-55" —
# as "start,end" words, one per piece. Fails on an empty or malformed piece and, given the file's line
# count as $2, on any piece that runs past the end. Blanks around a number are fine: "12, 40-55".
cite_ranges() {
  local rest="$1," piece s e out=""
  while [ -n "$rest" ]; do
    piece="${rest%%,*}"; rest="${rest#*,}"
    s="${piece%%-*}"; e="${piece#*-}"                      # a single line gives s = e
    case "$s$e" in *[!0-9[:blank:]]*) return 1 ;; esac      # no signs, no second dash
    # test takes blanks around a number but not inside one: "1 2" is an error, so false.
    [ "$s" -ge 1 ] 2>/dev/null && [ "$e" -ge "$s" ] 2>/dev/null || return 1
    [ $# -lt 2 ] || [ "$e" -le "$2" ] 2>/dev/null || return 1
    out="$out${out:+ }${s//[[:blank:]]/},${e//[[:blank:]]/}"
  done
  printf '%s\n' "$out"
}

# ok | missing-file | bad-line (…) | n/a — for a "path:line[-line][,line[-line]…]" citation.
cite_status() {
  local top="$1" c p n
  c="$(printf '%s' "$2" | sed 's/–/-/g')"
  case "$c" in http:*|https:*|-) printf 'n/a'; return ;; *:[0-9]*) ;; *) printf 'n/a'; return ;; esac
  p="${c%:*}"
  case "$p" in /*|[A-Za-z]:*) ;; *) p="$top/$p" ;; esac
  [ -f "$p" ] || { printf 'missing-file'; return; }
  n="$(awk 'END { print NR }' "$p")"
  if cite_ranges "${c##*:}" "$n" >/dev/null; then printf 'ok'; return; fi
  printf 'bad-line (the file has %s lines)' "$n"
}

# introduced | touched | pre-existing | new file — from git blame of the cited lines against the base.
# A list is blamed whole, not just its first piece: git blame takes one -L per piece (in any order,
# overlaps allowed), so old and new lines in one list make it "touched", as they would in one range.
cite_origin() {
  local top="$1" c base="$3" p ranges r shas sha old=0 new=0
  c="$(printf '%s' "$2" | sed 's/–/-/g')"
  p="${c%:*}"
  case "$p" in "$top"/*) p="${p#"$top"/}" ;; esac
  ranges="$(cite_ranges "${c##*:}")" || return 0          # no lines to blame, so no origin
  set --
  for r in $ranges; do set -- ${1+"$@"} -L "$r"; done       # the words are digits and commas only
  shas="$(cd "$top" 2>/dev/null && git blame --porcelain "$@" -- "$p" 2>/dev/null \
    | awk '$1 ~ /^[0-9a-f]+$/ && length($1) == 40 && NF >= 3 { print $1 }' | sort -u)"
  [ -n "$shas" ] || { printf 'new file'; return; }
  for sha in $shas; do
    case "$sha" in 0000000000000000000000000000000000000000) new=$((new + 1)); continue ;; esac
    if (cd "$top" && git merge-base --is-ancestor "$sha" "$base" 2>/dev/null); then old=$((old + 1)); else new=$((new + 1)); fi
  done
  if [ "$new" -eq 0 ]; then printf 'pre-existing'; elif [ "$old" -eq 0 ]; then printf 'introduced'; else printf 'touched'; fi
}

# A seat-file problem. It's a hard one unless the seat's worker is still running: its file may just not
# be done yet, so the Chair waits instead of resuming or re-dispatching it.
collect_flag() { bad=1; [ "${live:-0}" = 1 ] || hard=1; }

cmd_collect() {
  local run top brief seats slug ref out cap f size refok r got shape items unparsed hasnone okc allc n sev pr cite title tok state bad=0 total=0 note hard=0 live=0
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  brief="$run/brief.md"
  [ -f "$brief" ] || die "no brief.md in $run — write the brief first"
  seats="$(brief_seats "$brief")"
  [ -n "$seats" ] || die "brief.md has no seat blocks under '## Seats' (### <slug> — …)"
  [ ! -f "$run/debate.md" ] || seats="$seats
$(brief_seats "$run/debate.md")"                      # a war room's round-2 files, from debate.md's own ## Seats
  printf '%-16s %-8s %-7s %-4s %-9s %-7s %s\n' seat file items KB ref cites tokens
  while IFS="$TAB" read -r slug ref out cap; do
    [ -n "$slug" ] || continue
    total=$((total + 1)); note=""
    case "$out" in /*|[A-Za-z]:*) f="$out" ;; *) f="$run/$out" ;; esac
    if [ "${slug%-r2}" != "$slug" ] && [ -z "$(seat_field "$run" "$slug" 2)" ]; then
      tok="-"; state="$(seat_field "$run" "${slug%-r2}" 2)"     # round 2 by the round-1 worker, resumed
    else                                                         # (a fresh round-2 worker has its own row)
      tok="$(seat_field "$run" "$slug" 4)"
      if [ -n "$tok" ] && [ "$tok" -gt 0 ] 2>/dev/null; then tok="~$(( (tok + 500) / 1000 ))k"; else tok="-"; fi
      state="$(seat_field "$run" "$slug" 2)"
    fi
    # A fresh round-2 worker (<slug>-r2) took over a lost round-1 worker: judge the round-1 row by its file.
    if [ "${slug%-r2}" = "$slug" ] && [ -n "$(seat_field "$run" "$slug-r2" 2)" ]; then state=done; fi
    live=0; case "$state" in running|queued) live=1 ;; esac     # its file may simply not be done yet
    case "$state" in failed|blocked|running|queued) note=" state:$state"; collect_flag ;; esac
    if [ ! -s "$f" ]; then
      printf '%-16s %-8s %-7s %-4s %-9s %-7s %s%s\n' "$slug" missing - - - - "$tok" "$note"; collect_flag; continue
    fi
    if sed -n '2,9p' "$f" | grep -q '^BLOCKED'; then
      printf '%-16s %-8s %s\n' "$slug" blocked "$(sed -n '2,9p' "$f" | grep -m 1 '^BLOCKED' | tr -d '\r' | clip 140)"; collect_flag; continue
    fi
    size="$(( ($(wc -c < "$f") + 1023) / 1024 ))"
    refok=ok
    if [ "$ref" = none ]; then
      refok=n/a
    else
      got="$(sed -n '2,9p' "$f" | grep '^ref:' | sed 's/^ref:[[:space:]]*//' | while IFS= read -r l; do printf '%s' "$l" | norm; printf '\n'; done)"
      while IFS= read -r r; do
        [ -n "$r" ] || continue
        if [ ! -f "$r" ]; then refok=no-doc; collect_flag; break; fi
        printf '%s\n' "$got" | grep -qxF "$(ref_title "$r")" || { refok=MISMATCH; collect_flag; }
      done <<REFS
$(printf '%s\n' "$ref" | awk -F' ;; ' '{ for (i = 1; i <= NF; i++) print $i }')
REFS
    fi
    shape="$(index_shape "$f")"; items="${shape%% *}"; unparsed="${shape#* }"; hasnone="${unparsed#* }"; unparsed="${unparsed%% *}"
    grep -q '^## Index' "$f" || { note="$note no-index"; collect_flag; }
    [ "${unparsed:-0}" -eq 0 ] || { note="$note unparsed-index($unparsed)"; collect_flag; }
    if [ "${items:-0}" -eq 0 ] && [ "${hasnone:-0}" -eq 0 ]; then note="$note empty-index"; collect_flag; fi
    [ "${items:-0}" -le "${cap:-8}" ] || { note="$note over-cap"; collect_flag; }
    [ "$size" -le 16 ] || { note="$note over-16KB"; collect_flag; }
    okc=0; allc=0
    while IFS="$TAB" read -r n sev pr cite title; do
      [ -n "$n" ] || continue
      case "$(cite_status "$top" "$cite")" in n/a) ;; ok) allc=$((allc + 1)); okc=$((okc + 1)) ;; *) allc=$((allc + 1)) ;; esac
    done <<ITEMS
$(index_lines "$f")
ITEMS
    [ "$okc" -eq "$allc" ] || { note="$note broken-cites"; collect_flag; }
    printf '%-16s %-8s %-7s %-4s %-9s %-7s %s%s\n' "$slug" ok "${items:-0}/${cap:-8}" "$size" "$refok" "$okc/$allc" "$tok" "${note:+ ·$note}"
  done <<SEATS
$seats
SEATS
  if [ "$bad" -eq 0 ]; then say "collect: all $total seats in order"; return 0; fi
  if [ "$hard" -eq 0 ]; then
    say "collect: seats still working — after a compaction, wait for their notifications; if the session that started them has ended they are gone: mark them failed and re-dispatch each once (a war-room round-2 seat gets a fresh <slug>-r2 worker)"; return 1
  fi
  say "collect: fix the rows above — resume that worker (message its agent id) or re-dispatch it once"
  return 1
}

# The last path in a gate command that is a real test file the project keeps: a regular file whose
# name or folder says test or spec, either tracked by git or present and not ignored (the test a build
# just wrote isn't staged yet). A source file, a directory or a config file is never "a saved test".
# Globbing off: a command may contain * and we only want its words.
gate_test_path() {
  ( set -f
    cd "$1" 2>/dev/null || exit 1
    hit=""; base=""
    for tok in $2; do
      tok="$(printf '%s' "$tok" | tr -d "\"'\`")"
      case "$tok" in *::*) tok="${tok%%::*}" ;; esac
      case "$tok" in -*|.|./|*"*"*|*"?"*) continue ;; *[/.]*) ;; *) continue ;; esac
      base="$(printf '%s' "${tok##*/}" | tr 'A-Z' 'a-z')"
      case "$base" in                 # a config, a log or a report is never the test that was saved
        *.log|*.ini|*.cfg|*.conf|*.toml|*.json|*.yaml|*.yml|*.xml|*.txt|*.md|*.lock|*.csv) continue ;;
      esac
      case "$base" in                 # the file's own name has to say it is a test
        test_*|test-*|*_test.*|*-test.*|*.test.*|*.spec.*|*_spec.*|*-spec.*|spec_*|tests.*|test.*) ;;
        *) continue ;;
      esac
      [ -f "$tok" ] || continue
      if git ls-files --error-unmatch -- "$tok" >/dev/null 2>&1; then hit="$tok"
      elif ! git check-ignore -q -- "$tok" 2>/dev/null; then hit="$tok"; fi
      [ -z "$hit" ] || break          # the first real test named wins
    done
    [ -n "$hit" ] || exit 1
    printf '%s' "$hit" )
}

# A gate verdict json is one line, written by run_gate: {"gate": .., "command": .., "exit": N, ..}
gate_exit() { sed -n 's/.*"exit": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -n 1; }
gate_cmd()  { sed -n 's/.*"command": "\(.*\)", "exit".*/\1/p' "$1" 2>/dev/null | head -n 1 \
                | sed 's/\\\(.\)/\1/g'; }

cmd_check() {
  local run top base out f lab n sev pr cite title st origin rows=0 bad=0 a req qn=0 qok=0 \
        bf af bex aex bcmd acmd tp pn proofs=0 saved=0 broke=0 note what
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  base="${BASE_ARG:-$(field base "$run/session-state.md")}"
  if [ $# -eq 0 ]; then
    if [ -f "$run/synthesis.md" ]; then set -- "$run/synthesis.md"; else set -- "$run"/seats/*.md; fi
  fi
  # The user's own words — ask.md and the filed request, from "## In your words" on, whitespace
  # collapsed — for the quote: check (a post-game's parts quote the request word for word).
  req="$run/.request.txt"
  a="$(field ask "$run/session-state.md")"
  [ -n "$a" ] || a="$(field continues "$run/ask.md" | tr -d '`<>' | sed 's/[[:space:]].*$//')"   # not filed yet
  if [ -n "$a" ]; then case "$a" in /*|[A-Za-z]:*) ;; *) a="$(dirname "$(council_home)")/$a" ;; esac; fi
  for f in "$run/ask.md" "$a"; do          # the words only: no headings, no "(no new words)"
    if [ -n "$f" ] && [ -f "$f" ]; then
      awk '/^## In your words/ { on = 1; next }
           on && (/^## Later/ || /^## [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] / || /^\(no new words\)[ \t\r]*$/) { next }
           on' "$f"
    fi
  done | tr -s ' \t\r\n' '    ' > "$req" 2>/dev/null
  out="$run/check.md"
  {
    printf '# Citation check — %s\n' "$(now_sec)"
    printf 'base: %s\n\n' "${base:-unknown — origin not checked}"
    printf '| item | cite | status | origin |\n|---|---|---|---|\n'
  } > "$out"
  for f in "$@"; do
    [ -f "$f" ] || continue
    lab="$(basename "$f" .md)"
    while IFS="$TAB" read -r n sev pr cite title; do
      [ -n "$n" ] || continue
      rows=$((rows + 1))
      st="$(cite_status "$top" "$cite")"
      origin=""
      if [ "$st" = ok ] && [ -n "$base" ]; then origin="$(cite_origin "$top" "$cite" "$base")"; fi
      case "$st" in ok|n/a) ;; *) bad=$((bad + 1)) ;; esac
      printf '| %s#%s | %s | %s | %s |\n' "$lab" "$n" "$cite" "$st" "${origin:--}" >> "$out"
      say "$lab#$n  $cite  $st${origin:+ · $origin}"
    done <<ITEMS
$(index_lines "$f")
ITEMS
    while IFS="$TAB" read -r n st; do
      [ -n "$n" ] || continue
      qn=$((qn + 1))
      if [ "$st" = ok ]; then qok=$((qok + 1)); else bad=$((bad + 1)); fi
      printf '| %s#%s | quote | %s | - |\n' "$lab" "$n" "$st" >> "$out"
      say "$lab#$n  quote  $st"
    done <<QUOTES
$(REQF="$req" LC_ALL=C awk '
  function alnum(c) { return c ~ /[A-Za-z0-9]/ }
  function lastidx(s, x,   i, pos, base) {
    pos = 0; base = 0
    while ((i = index(s, x)) > 0) { pos = base + i; base += i + length(x) - 1; s = substr(s, i + length(x)) }
    return pos
  }
  function found(r, q,   s, p, off) {                # q inside r as whole words: "port" never matches "export"
    s = r; off = 0
    while ((p = index(s, q)) > 0) {
      if ((off + p == 1 || !alnum(substr(r, off + p - 1, 1))) && !alnum(substr(r, off + p + length(q), 1))) return 1
      off += p; s = substr(r, off + 1)
    }
    return 0
  }
  FILENAME == ENVIRON["REQF"] { r = r $0; next }
  {
    line = $0; gsub(/\r/, "", line)
    n = line; sub(/^[-*]?[ \t]*/, "", n); sub(/[ \t].*$/, "", n); sub(/\.$/, "", n)
    k = split(line, fld, /[ \t]+(·|\|)[ \t]+/)
    if (!(k >= 4 && n ~ /^C?[0-9]+$/ && fld[3] == "ask")) next    # only a post-game part quotes the request
    p = index(tolower(line), "quote:")
    if (!p) { printf "%s\tNO-QUOTE\n", n; next }
    q = substr(line, p + 6); sub(/^[ \t]+/, "", q)
    if (substr(q, 1, 1) == "\"") { q = substr(q, 2); e = lastidx(q, "\"") }
    else if (substr(q, 1, 3) == "“") { q = substr(q, 4); e = lastidx(q, "”") }
    else { printf "%s\tNO-QUOTE\n", n; next }
    if (e) q = substr(q, 1, e - 1)
    gsub(/[ \t]+/, " ", q); sub(/^ /, "", q); sub(/ $/, "", q)
    whole = r; sub(/^ /, "", whole); sub(/ $/, "", whole)
    if (q == "") st = "NO-QUOTE"
    else if (split(q, wd, " ") < 3 && q != whole) st = "TOO-SHORT"
    else st = found(r, q) ? "ok" : "NOT-IN-THE-REQUEST"
    printf "%s\t%s\n", n, st
  }' "$req" "$f" 2>/dev/null)
QUOTES
  done
  rm -f "$req"
  # council-implement: every fix's own proof, checked rather than taken on trust.
  if [ "$(field mode "$run/session-state.md")" = council-implement ]; then
    for bf in "$run"/gates/before-*.json; do
      [ -f "$bf" ] || continue
      pn="${bf##*/}"; pn="${pn%.json}"; pn="${pn#before-}"
      af="$run/gates/after-$pn.json"
      bex="$(gate_exit "$bf")"; bcmd="$(gate_cmd "$bf")"
      proofs=$((proofs + 1)); note="-"; tp=""
      if [ ! -f "$af" ]; then
        st="NO-AFTER"
      else
        aex="$(gate_exit "$af")"; acmd="$(gate_cmd "$af")"
        if [ "${bex:-0}" -eq 0 ] 2>/dev/null; then st="BEFORE-PASSED"
        elif [ "${aex:-1}" -ne 0 ] 2>/dev/null; then st="AFTER-FAILED"
        elif [ -n "$acmd" ] && [ -n "$bcmd" ] && [ "$acmd" != "$bcmd" ]; then st="DIFFERENT-COMMAND"
        else st=ok
        fi
        tp="$(gate_test_path "$top" "${acmd:-$bcmd}")" || tp=""
        if [ -n "$tp" ]; then note="test saved: $tp"; else note="couldn't confirm a saved test"; fi
      fi
      rows=$((rows + 1))
      if [ "$st" = ok ]; then
        [ -z "$tp" ] || saved=$((saved + 1))       # only a proof that held counts as a test kept
      else
        bad=$((bad + 1)); broke=$((broke + 1))
      fi
      printf '| task %s | proof | %s | %s |\n' "$pn" "$st" "$note" >> "$out"
      say "task $pn  proof  $st · $note"
    done
    for af in "$run"/gates/after-*.json; do        # an after-check with nothing before it proves nothing
      [ -f "$af" ] || continue
      pn="${af##*/}"; pn="${pn%.json}"; pn="${pn#after-}"
      [ ! -f "$run/gates/before-$pn.json" ] || continue
      proofs=$((proofs + 1)); rows=$((rows + 1)); bad=$((bad + 1)); broke=$((broke + 1))
      printf '| task %s | proof | %s | %s |\n' "$pn" "NO-BEFORE" "-" >> "$out"
      say "task $pn  proof  NO-BEFORE · nothing showed the problem first"
    done
    if [ "$proofs" -eq 0 ]; then
      bad=$((bad + 1))
      say "check: NO PROOF — this build recorded no before-and-after evidence (council gate before-<n> -- '<check>', then after-<n>)"
    else
      say "check: $((proofs - broke)) of $proofs fix(es) proved · $broke broken · $saved left a test behind in the project"
    fi
  fi
  if [ "$qn" -eq 0 ] && [ "$(field mode "$run/session-state.md")" = council-postgame ]; then
    bad=$((bad + 1)); say "check: no quotes found — each part of a post-game quotes the request (quote: \"…\")"
  fi
  if [ "$qn" -gt 0 ] && [ "$proofs" -gt 0 ]; then what="(citations, quotes and proof)"
  elif [ "$qn" -gt 0 ]; then what="(citations and quotes)"
  elif [ "$proofs" -gt 0 ]; then what="(citations and proof)"
  else what="citation(s)"
  fi
  if [ "$qn" -gt 0 ]; then
    say "check: $rows items, $bad broken $what · $qok of $qn quotes found in the request → $out"
  else
    say "check: $rows items, $bad broken $what → $out"
  fi
  [ "$bad" -eq 0 ]
}

# ------------------------------------------------------------------------------------------------
# Map and drift
# ------------------------------------------------------------------------------------------------

cmd_map() {
  local home map sha behind
  [ "${1:-}" = status ] || die "usage: council map status"
  home="$(council_home)"; map="$home/map.md"
  [ -f "$map" ] || { say "no map yet — council-init builds .council/map.md"; return 0; }
  sha="$(sed -n 's/^map-commit:[[:space:]]*\([0-9a-fA-F]\{7,40\}\).*/\1/p' "$map" | head -n 1)"
  [ -n "$sha" ] || { say "map.md has no map-commit stamp — refresh the map and stamp it"; return 0; }
  git cat-file -e "$sha^{commit}" 2>/dev/null || { say "map-commit $sha isn't in this repo's history — rebuild the map"; return 0; }
  behind="$(git rev-list --count "$sha..HEAD" 2>/dev/null)"
  if [ "${behind:-0}" -eq 0 ]; then say "map: up to date (map-commit $(printf '%.9s' "$sha"))"; return 0; fi
  say "map: $behind commits behind HEAD (map-commit $(printf '%.9s' "$sha")). Files changed since, by area:"
  git diff --name-only "$sha" HEAD -- . 2>/dev/null | grep -v '^\.council/' \
    | awk -F/ '{ a = (NF > 1 ? $1 "/" : $1); c[a]++ } END { for (k in c) printf "  %4d  %s\n", c[k], k }' | sort -rn | head -n 12
}

# The config's Roster table as rows: slug seat reference ("-" for an empty value). Columns are found
# by their header names.
roster_rows() {
  awk -F'|' '
    function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); gsub(/[`*]/, "", s); return s }
    /^## / { inr = ($0 ~ /^## Roster/); hdr = 0; next }
    inr && /^\|/ {
      if (!hdr) {
        hdr = 1; cs = 2; cl = 0; cr = 0
        for (i = 2; i < NF; i++) { h = tolower(trim($i)); if (h == "seat") cs = i; else if (h == "slug") cl = i; else if (h == "reference") cr = i }
        next
      }
      seat = trim($cs); slug = cl ? trim($cl) : ""; ref = cr ? trim($cr) : ""
      if (seat == "" || seat ~ /^:?-+:?$/ || seat ~ /^</) next
      if (slug ~ /^</) slug = ""
      if (ref ~ /^</ || ref ~ /^:?-+:?$/) ref = ""
      printf "%s\t%s\t%s\n", (slug == "" ? "-" : slug), seat, (ref == "" ? "-" : ref)
    }' "$1" 2>/dev/null
}

# A roster or card reference as a file path: references/… is in the plugin, anything else in the repo ($2).
ref_path() {
  case "$1" in
    references/*) printf '%s/%s' "$COUNCIL_PLUGIN_ROOT" "$1" ;;
    /*|[A-Za-z]:*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$2" "$1" ;;
  esac
}

cmd_doctor() {
  local home root cfg errs=0 warns=0 refs slug seat ref p card src dups gates g gc gat gm gk gchk gside gneeds ghk ghas dir mode phase croot upd status actual ptr mem size pend stale fp map sha behind
  home="$(council_home)"; root="$(dirname "$home")"
  finding() {
    printf '%s  %s\n       Fix: %s\n' "$1" "$2" "$3"
    if [ "$1" = ERROR ]; then errs=$((errs + 1)); else warns=$((warns + 1)); fi
  }
  if [ ! -d "$home" ]; then finding ERROR "no council home at $home" "run council-init in this repo"; say "doctor: 1 error(s), 0 warning(s)"; return 1; fi
  cfg="$home/council.config.md"
  if [ ! -f "$cfg" ]; then
    finding ERROR "no council.config.md" "run council-init"
  else
    grep -q '^last-verified:' "$cfg" || finding WARN "the config has no last-verified stamp (an older layout)" "run council-init refresh to migrate it to the current template"
    refs="$(roster_rows "$cfg")"
    if [ -z "$refs" ]; then
      finding WARN "couldn't read a Roster table in council.config.md" "run council-init refresh (older configs list seats instead of a table)"
    else
      [ -d "$home/cards" ] || finding WARN "no seat cards yet (.council/cards/ is missing)" "a council-init refresh writes one per seat — workers read them instead of the generic docs"
      while IFS="$TAB" read -r slug seat ref; do
        [ -n "$seat" ] || continue
        case "$ref" in
          none|n/a|-) ;;
          *) [ -f "$(ref_path "$ref" "$root")" ] || finding ERROR "seat '$seat' points at a reference doc that doesn't exist: $ref" "restore the doc, or point the seat at another one in council.config.md" ;;
        esac
        if [ "$slug" = "-" ]; then
          finding WARN "seat '$seat' has no slug" "give it a lowercase slug in the roster — it names the seat's file and card"
          continue
        fi
        [ -d "$home/cards" ] || continue
        card="$home/cards/$slug.md"
        if [ ! -f "$card" ]; then
          finding WARN "seat '$seat' has no card (cards/$slug.md)" "council-init refresh writes one from references/templates/seat-card.md"
          continue
        fi
        src="$(field source "$card" | sed 's/[[:space:]]*·.*$//' | tr -d '`')"
        if [ -n "$src" ] && [ ! -f "$(ref_path "$src" "$root")" ]; then
          finding ERROR "the card for '$seat' names a source doc that doesn't exist: $src" "point the card's source: line at the seat's reference doc"
        fi
        [ "$(wc -c < "$card" | tr -d ' ')" -le 8192 ] || finding WARN "the card for '$seat' is over 8 KB" "cut it to one line per principle — the full doc holds the detail"
      done <<REFS
$refs
REFS
      dups="$(printf '%s\n' "$refs" | cut -f1 | grep -v '^-$' | sort | uniq -d | paste -sd ' ' -)"
      [ -z "$dups" ] || finding ERROR "the roster repeats a slug: $dups" "give each row its own slug — a lens that covers two areas gets two (dodds-web, dodds-admin)"
    fi
    gates="$(config_gates "$cfg")"
    if [ -z "$gates" ]; then
      if grep -qiE '^[-*[:space:]]*guardrails: *declined' "$cfg" 2>/dev/null; then
        finding WARN "no gates in council.config.md (guardrails declined) — every council report on this project says NOTHING WAS CHECKED" "delete the 'guardrails: declined' line and run a council-init refresh whenever you want them fitted"
      else
        finding ERROR "no gates in council.config.md — every council report on this project says NOTHING WAS CHECKED" "add the project's real test / lint / build commands (a council-init refresh detects them, and offers the ones you are missing)"
      fi
    else
      while IFS="$TAB" read -r g gc gat gm gk gchk gside gneeds ghk ghas; do
        [ -n "$g" ] || continue
        if [ "$gk" != "$ghk" ]; then
          finding WARN "gate '$g' has $gk cells where the header has $ghk — the columns have shifted (an unescaped pipe?)" "wrap the command in backticks and escape any pipe as \\|, or remove it"
        fi
        case "$gc" in *'|'*) finding WARN "gate '$g' pipes its output — its exit code may not be the test runner's" "remove the pipe from that command in council.config.md" ;; esac
      done <<GATES
$gates
GATES
      awk '/^## / { g = ($0 ~ /^## Gates/); next } g && /^\|/ { print; exit }' "$cfg" | grep -qi 'side effects' \
        || finding WARN "the Gates table has no Side effects column (an older layout)" "council-init refresh adds Probe and Side effects, so a gate that costs money or touches hardware never runs unasked"
    fi
  fi
  while IFS="$TAB" read -r dir mode phase croot upd status actual; do
    [ -n "$dir" ] || continue
    if [ -n "$(find "$dir/session-state.md" -mtime +2 2>/dev/null)" ]; then
      finding WARN "run ${dir##*/} ($(mode_skill "$(undash "$mode")"), phase $phase) has been open since $upd" "resume it, or: council run close --run \"$dir\" --status abandoned"
    fi
  done <<RUNS
$(list_runs "$home" 200 open)
RUNS
  ptr="$home/active-run"
  if [ -s "$ptr" ]; then
    p="$(head -n 1 "$ptr" | tr -d '\r')"
    case "$p" in /*|[A-Za-z]:*) ;; *) p="$root/$p" ;; esac
    if [ -f "$p/session-state.md" ]; then
      case "$(field status "$p/session-state.md")" in
        complete*|abandoned*) finding WARN "active-run still points at a closed run" "empty .council/active-run (0.3 doesn't use it)" ;;
        *) finding WARN "an older run is still marked open: $p" "resume it, or: council run close --run \"$p\" --status abandoned" ;;
      esac
    else
      finding WARN "active-run points at a folder that no longer exists: $p" "empty .council/active-run"
    fi
  fi
  mem="$(memory_file "$home")"
  if [ -f "$mem" ]; then
    stale="$(cmd_memory check 2>/dev/null | grep -c '^STALE' || true)"
    [ "${stale:-0}" -eq 0 ] || finding WARN "$stale memory anchor(s) point at code that moved or no longer exists" "council memory check lists them; propose re-anchoring or retiring each at the next Learn"
    size="$(wc -c < "$mem" | tr -d ' ')"
    [ "$size" -le 25600 ] || finding WARN "memory is $(( size / 1024 )) KB — past the ~25 KB every run reads" "at the end of the next run, propose a consolidation (merge duplicates, retire superseded entries)"
    pend="$(grep -c '^- PROPOSED' "$mem" 2>/dev/null)"
    [ "${pend:-0}" -eq 0 ] || finding WARN "$pend memory proposal(s) await the user's yes/no" "raise them at the next natural pause"
  else
    finding WARN "no memory file found" "council-init creates .council/conventions.md"
  fi
  map="$home/map.md"
  if [ -f "$map" ]; then
    sha="$(sed -n 's/^map-commit:[[:space:]]*\([0-9a-fA-F]\{7,40\}\).*/\1/p' "$map" | head -n 1)"
    if [ -n "$sha" ]; then
      behind="$(git rev-list --count "$sha..HEAD" 2>/dev/null)"
      [ "${behind:-0}" -le 50 ] 2>/dev/null || finding WARN "the map is $behind commits behind HEAD" "refresh the changed areas (council map status lists them)"
    else
      finding WARN "map.md has no map-commit stamp" "refresh the map and stamp map-commit"
    fi
  else
    finding WARN "no map.md" "council-init builds it"
  fi
  if [ -f "$cfg" ] && git rev-parse --git-dir >/dev/null 2>&1; then
    fp="$(cmd_fingerprint check 2>/dev/null)"
    case "$fp" in
      "fingerprint: the stack changed"*) fp="${fp#fingerprint: }"; finding WARN "${fp%. Suggest*}" "run a council-init refresh — it re-checks the roster, cards and gates against the new stack" ;;
      "no stack-fingerprint"*) finding WARN "the config has no stack-fingerprint" "a council-init refresh records one, so a changed stack gets noticed" ;;
    esac
  fi
  grep -q '^runs/' "$home/.gitignore" 2>/dev/null || finding WARN ".council/.gitignore doesn't ignore runs/" "add a line 'runs/' to .council/.gitignore"
  say "doctor: $errs error(s), $warns warning(s)"
  [ "$errs" -eq 0 ]
}

# ------------------------------------------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# Stack fingerprint
# ------------------------------------------------------------------------------------------------

# "manifests: a, b · languages: x, y": build manifests up to two folders deep, and the code languages
# with at least 3 tracked files. Everyday edits don't move it; a new language or build system does.
stack_summary() {
  local files man lang
  files="$(cd "$(council_toplevel)" 2>/dev/null && git -c core.quotePath=false ls-files 2>/dev/null)"   # the whole repo, from any folder
  man="$(printf '%s\n' "$files" | awk -F/ 'NF <= 3 { print $NF }' | grep -x -E \
    'package\.json|deno\.json|tsconfig\.json|pyproject\.toml|requirements\.txt|setup\.py|Pipfile|environment\.yml|go\.mod|Cargo\.toml|pom\.xml|build\.gradle(\.kts)?|settings\.gradle(\.kts)?|Gemfile|composer\.json|mix\.exs|rebar\.config|pubspec\.yaml|Package\.swift|project\.pbxproj|Podfile|project\.godot|ProjectVersion\.txt|.*\.uproject|CMakeLists\.txt|meson\.build|Makefile|west\.yml|platformio\.ini|Dockerfile|compose\.ya?ml|docker-compose\.ya?ml|.*\.csproj|.*\.fsproj|.*\.sln|.*\.tf|flake\.nix|BUILD(\.bazel)?|WORKSPACE' \
    | sed -E 's/.*\.(tf|csproj|fsproj|sln|uproject)$/*.\1/' | LC_ALL=C sort -u | paste -sd ',' - | sed 's/,/, /g')"
  lang="$(printf '%s\n' "$files" | sed -n 's/.*\.\([A-Za-z0-9+]\{1,10\}\)$/\1/p' | tr 'A-Z' 'a-z' | grep -x -E \
    'py|pyx|ipynb|ts|tsx|js|jsx|mjs|cjs|vue|svelte|go|rs|java|kt|kts|scala|clj|groovy|swift|m|mm|c|h|cc|cpp|cxx|hh|hpp|cs|fs|vb|rb|php|ex|exs|erl|hrl|dart|lua|gd|r|jl|sql|sh|bash|ps1|tf|hcl|proto|graphql|zig|nim|ml|hs|elm|sol|asm|s|ino|glsl|hlsl|wgsl|shader|tscn|nix' \
    | LC_ALL=C sort | uniq -c | awk '$1 >= 3 { print $2 }' | paste -sd ',' - | sed 's/,/, /g')"
  printf 'manifests: %s · languages: %s' "${man:-none}" "${lang:-none}"
}

# Items in summary $1 that summary $2 lacks.
summary_minus() {
  A="$1" B="$2" awk 'BEGIN {
    n = split(ENVIRON["B"], b, /(, | · |: )/); for (i = 1; i <= n; i++) have[b[i]] = 1
    n = split(ENVIRON["A"], a, /(, | · |: )/)
    for (i = 1; i <= n; i++) if (a[i] != "" && a[i] != "manifests" && a[i] != "languages" && a[i] != "none" && !(a[i] in have)) out = out (out ? ", " : "") a[i]
    print out }'
}

cmd_fingerprint() {
  local sum hash cfg line old added removed
  git rev-parse --git-dir >/dev/null 2>&1 || die "the stack fingerprint needs a git repository"
  sum="$(stack_summary)"
  hash="$(printf '%s' "$sum" | git hash-object --stdin | cut -c1-12)"
  if [ "${1:-}" != check ]; then say "stack-fingerprint: $hash — $sum"; return 0; fi
  cfg="$(council_home)/council.config.md"
  line="$(field stack-fingerprint "$cfg")"
  line="${line#stack-fingerprint: }"                 # a pasted line that repeats the key still reads
  if [ -z "$line" ]; then say "no stack-fingerprint in the config — a council-init refresh records one: stack-fingerprint: $hash — $sum"; return 0; fi
  old="${line%% *}"
  if [ "$old" = "$hash" ]; then say "fingerprint: the stack is unchanged since council-init ($hash)"; return 0; fi
  added="$(summary_minus "$sum" "${line#* — }")"; removed="$(summary_minus "${line#* — }" "$sum")"
  say "fingerprint: the stack changed since council-init — added: ${added:-nothing} · removed: ${removed:-nothing}. Suggest a council-init refresh."
  return 1
}

# ------------------------------------------------------------------------------------------------
# Memory — scoped entries, earlier council work
# ------------------------------------------------------------------------------------------------

# The memory file: the config's "- conventions:" path, else .council/conventions.md, else a root one.
memory_file() {
  local home="$1" root mem
  root="$(dirname "$home")"
  mem="$(sed -n 's/^-[[:space:]]*conventions:[[:space:]]*//p' "$home/council.config.md" 2>/dev/null | head -n 1 | tr -d '\r`' | sed 's/[[:space:]].*$//')"
  if [ -n "$mem" ]; then
    case "$mem" in /*|[A-Za-z]:*) ;; *) mem="$root/$mem" ;; esac
  elif [ -f "$home/conventions.md" ]; then mem="$home/conventions.md"
  else mem="$root/conventions.md"; fi
  printf '%s' "$mem"
}

# Memory entries as rows: id title scope anchor ("-" when empty). An entry is a "### AP-3: title"
# heading; its **Scope:** and **Anchor:** fields may sit anywhere in its body.
memory_entries() {
  awk '
    function flush() { if (id != "") printf "%s\t%s\t%s\t%s\n", id, (title == "" ? "-" : title), (scope == "" ? "-" : scope), (anchor == "" ? "-" : anchor) }
    function fieldval(line, name,    v) {
      if (!match(line, "\\*\\*" name ":\\*\\*")) return ""
      v = substr(line, RSTART + RLENGTH); sub(/[ \t]+·[ \t]+\*\*.*$/, "", v)
      gsub(/^[ \t]+|[ \t\r]+$/, "", v); gsub(/`/, "", v); return v
    }
    /^### (AP|EC|D)-[0-9]+/ {
      flush(); line = $0; gsub(/\r/, "", line); sub(/^### /, "", line)
      id = line; sub(/[: ].*$/, "", id); title = line; sub(/^[^:]*:[ \t]*/, "", title); scope = ""; anchor = ""; next
    }
    /^## / { flush(); id = ""; next }
    id != "" { v = fieldval($0, "Scope"); if (v != "") scope = v; v = fieldval($0, "Anchor"); if (v != "") anchor = v }
    END { flush() }' "$1" 2>/dev/null
}

# Is path $1 inside scope item $2? A glob (* and ** cross folders), a folder, or an exact path.
in_scope() {
  local p="$1" g="${2%/}" g2
  [ -n "$g" ] || return 1
  case "$p" in "$g"|"$g"/*) return 0 ;; esac
  # shellcheck disable=SC2254
  case "$p" in $g) return 0 ;; esac
  g2="$(printf '%s' "$g" | sed -e 's#^\*\*/##' -e 's#/\*\*/#/#g')"      # **/ also matches no folder at all
  if [ "$g2" != "$g" ]; then
    # shellcheck disable=SC2254
    case "$p" in $g2) return 0 ;; esac
  fi
  return 1
}

# The changed files listed in a run's change index, one per line.
index_paths() { sed -n 's/^## \(.*\)  (.*$/\1/p' "$1/index.md" 2>/dev/null; }

# One item per line from a comma-separated list, trimmed.
split_list() { printf '%s\n' "$1" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'; }

# One anchor per line from an **Anchor:** list, trimmed. A piece that is only a line or a range
# ("3", "40-55", blanks allowed) belongs to the path:line before it, as it would in a citation, so
# "src/a.py:1,3, summary" is two anchors: "src/a.py:1,3" and "summary". The piece is judged by its
# shape, not its value: "0" or "9-2" makes the citation bad-line rather than pass as a symbol
# wherever the code has that word.
split_anchors() {
  printf '%s\n' "$1" | awk '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function emit() { if (cur != "") print trim(cur); cur = "" }
    {
      n = split($0, piece, ",")
      for (i = 1; i <= n; i++) {
        p = trim(piece[i]); gsub(/–/, "-", p)
        if (p == "") continue
        if (cur ~ /:[0-9]/ && p ~ /^[0-9]+([ \t]*-[ \t]*[0-9]+)?$/) cur = cur "," piece[i]   # as written
        else { emit(); cur = piece[i] }
      }
      emit()
    }'
}

cmd_memory() {
  local sub="${1:-index}" home mem entries n=0 hit=0 unscoped=0 stale=0 id title scope anchor item key keys match top st run
  home="$(council_home)"; mem="$(memory_file "$home")"
  [ -f "$mem" ] || die "no memory file ($mem) — council-init creates .council/conventions.md"
  entries="$(memory_entries "$mem")"
  [ $# -eq 0 ] || shift
  case "$sub" in
    index)
      [ -n "$entries" ] || { say "memory: no entries yet in $mem"; return 0; }
      printf '%s\n' "$entries" | awk -F'\t' '{
        printf "%s · %s", $1, $2
        if ($3 != "-") printf " · scope: %s", $3; else printf " · every run"
        if ($4 != "-") printf " · anchor: %s", $4
        printf "\n" }'
      ;;
    select)
      if [ $# -gt 0 ]; then keys="$(printf '%s\n' "$@")"
      else
        run="$(resolve_run)" || exit 2
        keys="$(index_paths "$run"; awk -F'\t' 'NR > 1 && $2 != "skipped" { print $1 }' "$run/seats.tsv" 2>/dev/null
                field mode "$run/session-state.md")"       # a lesson may be scoped to a mode, e.g. council-plan
        if ! awk -F'\t' 'NR > 1 { found = 1 } END { exit !found }' "$run/seats.tsv" 2>/dev/null; then
          keys="$keys
$(roster_rows "$home/council.config.md" | cut -f1 | grep -v '^-$')"            # no seats recorded yet: the whole roster
        fi
      fi
      while IFS="$TAB" read -r id title scope anchor; do
        [ -n "$id" ] || continue
        n=$((n + 1))
        if [ "$scope" = "-" ]; then unscoped=$((unscoped + 1)); say "$id · $title · every run"; continue; fi
        match=""
        while IFS= read -r item; do
          while IFS= read -r key; do
            [ -n "$key" ] || continue
            if [ "$item" = "$key" ] || in_scope "$key" "$item"; then match=1; break; fi
          done <<KEYS
$keys
KEYS
          [ -z "$match" ] || break
        done <<ITEMS
$(split_list "$scope")
ITEMS
        if [ -n "$match" ]; then hit=$((hit + 1)); say "$id · $title · scope: $scope"; fi
      done <<ENTRIES
$entries
ENTRIES
      say "memory: $hit scoped and $unscoped every-run entries of $n apply — quote them in the brief by id"
      ;;
    check)
      top="$(dirname "$home")"
      while IFS="$TAB" read -r id title scope anchor; do
        [ -n "$id" ] || continue
        n=$((n + 1))
        [ "$anchor" != "-" ] || continue
        while IFS= read -r item; do
          [ -n "$item" ] || continue
          case "$item" in
            *:[0-9]*)
              st="$(cite_status "$top" "$item")"
              [ "$st" = ok ] || { stale=$((stale + 1)); say "STALE  $id — anchor $item: $st"; } ;;
            */*)
              [ -e "$top/$item" ] || { stale=$((stale + 1)); say "STALE  $id — anchor $item no longer exists"; } ;;
            *)
              if [ ! -e "$top/$item" ] && ! (cd "$top" && git grep -q -w -F -e "$item" -- . ':(exclude).council' 2>/dev/null); then
                stale=$((stale + 1)); say "STALE  $id — nothing in the code is named $item any more"
              fi ;;
          esac
        done <<ITEMS
$(split_anchors "$anchor")
ITEMS
      done <<ENTRIES
$entries
ENTRIES
      [ "$stale" -eq 0 ] || say "→ at the next Learn, propose re-anchoring or retiring each stale entry — the user decides"
      say "memory check: $stale stale anchor(s) across $n entries"
      [ "$stale" -eq 0 ]
      ;;
    *) die "usage: council memory [index | select [path|slug …] | check]" ;;
  esac
}

# Earlier council work that mentions these paths (one per line on stdin): tracked deliverables in
# reviews/, logs/, research/, plans/ and postgames/ that name a path, or whose frontmatter areas: cover
# it. Rows: path · deliverable[:line] · the matching line or area.
prior_hits() {
  local home="$1" paths dir f
  paths="$(cat)"
  [ -n "$paths" ] || return 0
  set --
  for dir in reviews logs research plans postgames; do
    for f in "$home/$dir"/*.md; do [ -f "$f" ] && set -- ${1+"$@"} "$f"; done
  done
  [ $# -gt 0 ] || return 0
  # One pass over every deliverable. A path counts where it appears whole (not inside a longer path),
  # else where the frontmatter's areas: (inline, [bracketed] or a - list) cover it.
  PATHS="$paths" awk '
    function esc(s,   r, i, c) {
      r = ""
      for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (index("\\^$.[]|()+{}", c)) r = r "\\" c; else r = r c }
      return r
    }
    function glob_re(g,   r, i, c) {
      r = ""; i = 1
      while (i <= length(g)) {
        if (substr(g, i, 3) == "**/") { r = r "(.*/)?"; i += 3; continue }
        if (substr(g, i, 2) == "**") { r = r ".*"; i += 2; continue }
        c = substr(g, i, 1)
        if (c == "*") r = r "[^/]*"; else if (c == "?") r = r "[^/]"; else r = r esc(c)
        i++
      }
      return "^" r "$"
    }
    function covers(p, a) {
      sub(/\/+$/, "", a)
      if (a == "") return 0
      if (p == a || index(p, a "/") == 1) return 1
      return p ~ glob_re(a)
    }
    function clip(t) { if (length(t) <= 120) return t; t = substr(t, 1, 120); sub(/ [^ ]*$/, "", t); return t " …" }
    function add_area(x) { gsub(/[`"]/, "", x); gsub(/\[|\]/, "", x); gsub(/^[ \t]+|[ \t]+$/, "", x); if (x != "") A[++na] = x }
    function flush(   i, j) {
      if (disp == "") return
      for (i = 1; i <= np; i++) {
        if (P[i] == "") continue
        if (hit[i] != "") { print P[i] "\t" hit[i]; continue }
        for (j = 1; j <= na; j++) if (covers(P[i], A[j])) { print P[i] "\t" disp "\t(its areas cover " A[j] ")"; break }
      }
    }
    BEGIN { np = split(ENVIRON["PATHS"], P, "\n") }
    FNR == 1 {
      flush(); m = split(FILENAME, fp, "/"); disp = fp[m - 1] "/" fp[m]; na = 0; infm = 0; inareas = 0
      for (i = 1; i <= np; i++) hit[i] = ""
    }
    { line = $0; sub(/\r$/, "", line) }
    FNR == 1 && line == "---" { infm = 1; next }
    infm {
      if (line == "---") { infm = 0; next }
      if (line ~ /^areas:/) {
        v = line; sub(/^areas:[ \t]*/, "", v)
        if (v == "") inareas = 1
        else { inareas = 0; k = split(v, t, ","); for (i = 1; i <= k; i++) add_area(t[i]) }
        next
      }
      if (inareas && line ~ /^[ \t]*-/) { x = line; sub(/^[ \t]*-[ \t]*/, "", x); add_area(x); next }
      inareas = 0; next
    }
    {
      for (i = 1; i <= np; i++) {
        if (P[i] == "" || hit[i] != "") continue
        s = line; base = 0
        while ((pos = index(s, P[i])) > 0) {
          at = base + pos
          before = (at == 1) ? "" : substr(line, at - 1, 1)
          after = substr(line, at + length(P[i]), 1)
          if (before !~ /[A-Za-z0-9_.\/-]/ && after !~ /[A-Za-z0-9_\/-]/) {
            txt = line; sub(/^[ \t]+/, "", txt); hit[i] = disp ":" FNR "\t" clip(txt); break
          }
          base = at; s = substr(line, at + 1)
        }
      }
    }
    END { flush() }' "$@"
}

cmd_prior() {
  local home run hits
  home="$(council_home)"
  if [ $# -gt 0 ]; then
    hits="$(printf '%s\n' "$@" | prior_hits "$home" | head -n 40)"
  else
    run="$(resolve_run)" || exit 2
    [ -f "$run/index.md" ] || die "no paths given and no change index in this run — pass them: council prior <path> …"
    hits="$(index_paths "$run" | prior_hits "$home" | head -n 40)"
  fi
  if [ -z "$hits" ]; then say "prior: no earlier council work mentions these paths"; return 0; fi
  printf '%s\n' "$hits" | awk -F'\t' '{ printf "%s — %s — %s\n", $1, $2, $3 }'
  say "prior: $(printf '%s\n' "$hits" | grep -c .) mention(s) — list them in the brief's Landscape as ids plus one line"
}

# ------------------------------------------------------------------------------------------------
# The user's request, word for word — filed where later runs, and a post-game, can find it
# ------------------------------------------------------------------------------------------------

# A case-insensitive pattern for a word: token → [tT][oO][kK][eE][nN] (BSD sed has no I flag).
ci() {
  printf '%s' "$1" | awk '{ for (i = 1; i <= length($0); i++) { c = substr($0, i, 1); l = tolower(c); u = toupper(c)
    printf "%s", (l != u) ? "[" l u "]" : c } }'
}

# Copy $1 to $2 with secret-looking strings redacted, and print how many were: keys and tokens by their
# shape, "password: …"-style values of 8+ characters, whole private-key blocks. One sed -E pass — not
# awk: old macOS awk has no {n,} bounds, and Git Bash's sed and awk drop carriage returns unless sed
# gets -b (GNU sed takes it everywhere; BSD sed has no text mode to switch off). LC_ALL=C passes every
# byte through untouched.
sed_b() { if sed -b -e '' </dev/null >/dev/null 2>&1; then printf '%s' '-b'; fi; }

# An ask.md's "In your words" body, and its "Later" lines — straight to stdout, byte for byte. Only
# those two headings end a section, so a pasted PR or issue with its own "## Summary" stays whole. Write
# them to files directly: Git Bash's $(…) drops carriage returns, so a variable is only good for tests.
ask_words() { LC_ALL=C sed $(sed_b) -n -e '/^## In your words/,/^## Later/{' -e '/^## In your words/d' -e '/^## Later/d' -e 'p' -e '}' "$1"; }
ask_later() { LC_ALL=C sed $(sed_b) -n -e '/^## Later/,${' -e '/^## Later/d' -e '/^[[:space:]]*$/d' -e 'p' -e '}' "$1"; }

# Line numbers of the sections continuing runs add to a filed request ("## <date> — <mode>, run <folder>");
# $2, a run's folder name, keeps only that run's — the whole name, so run …-review never matches …-review-2.
ask_sections() {
  local who
  who="$(printf '%s' "${2:-}" | sed 's/[.[()*+?{|^$\]/\\&/g')"
  LC_ALL=C grep -n -E "^## [0-9]{4}-[0-9]{2}-[0-9]{2} .*, run ${who:-[^ ]+}[[:space:]]*\$" "$1" 2>/dev/null | cut -d: -f1
}

redact_copy() {
  local kw q val sent before after sedb
  kw="($(ci password)|$(ci passwd)|$(ci secret)|$(ci token)|$(ci api)[_-]?$(ci key)|$(ci access)[_-]?$(ci key))"
  q="[\"'\`]"                                   # a quote around a key or a value
  sent="$(printf '\001')"                       # marks a value that only looks secret: a date, "15-minute-…"
  val="[^[:space:]\"'\`,;}${sent}]"             # one character of a value
  sedb="$(sed_b)"
  # Shapes first (each anchored, so task-list-… or flask-… never match); then key = value, where the
  # value needs a digit or 20+ characters, so "token: short-lived" survives; then private-key blocks,
  # whose base64 lines go and whose surrounding text stays even when the END line was snipped off.
  LC_ALL=C sed $sedb -E \
    -e 's/(^|[^A-Za-z0-9_-])(sk|rk)(-|_live_|_test_)[A-Za-z0-9_-]{20,}/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{22,})/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9])(AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9_-])xox[baprs]-[A-Za-z0-9-]{10,}/\1[redacted]/g' \
    -e 's/eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/[redacted]/g' \
    -e 's/([Bb]earer[[:space:]]+)[A-Za-z0-9._~+\/=-]{16,}/\1[redacted]/g' \
    -e 's#(://[^/:@[:space:]]+:)[^/@[:space:]]+@#\1[redacted]@#g' \
    -e "s/([A-Za-z0-9_]*${kw}${q}?[[:space:]]*[:=][[:space:]]*${q}?)([0-9]{4}-[0-9]{2}-[0-9]{2}[T0-9:.Z+-]*|[0-9]+(-[A-Za-z]+)+)/\\1${sent}\\3/g" \
    -e "s/([A-Za-z0-9_]*${kw}${q}?[[:space:]]*[:=][[:space:]]*${q}?)(${val}{7,}[0-9]${val}*|${val}*[0-9]${val}{7,}|${val}{20,})/\\1[redacted]/g" \
    -e '/-----BEGIN [A-Z ]*PRIVATE KEY-----/,/-----END [A-Z ]*PRIVATE KEY-----/{' \
    -e 's/-----BEGIN [A-Z ]*PRIVATE KEY-----/[redacted private key]/' \
    -e '/-----END [A-Z ]*PRIVATE KEY-----/d' \
    -e '/^[A-Za-z0-9+\/=]{16,}[[:space:]]*$/d' \
    -e '}' \
    -e "s/${sent}//g" "$1" > "$2" || return 1
  before="$(LC_ALL=C grep -o '\[redacted' "$1" 2>/dev/null | wc -l | tr -d ' ')"
  after="$(LC_ALL=C grep -o '\[redacted' "$2" 2>/dev/null | wc -l | tr -d ' ')"
  printf '%s' "$(( ${after:-0} - ${before:-0} ))"
}

# council ask save [slug] — file <run>/ask.md. A new request becomes .council/asks/<date>-<slug>.md
# (line 1, then run: and mode:, then the rest of ask.md as written); a run that continues one (the
# state's ask:) appends its new words under a dated heading. Either way the state records ask=.
cmd_ask() {
  local sub="${1:-}" slug run name st ask home root mode cur target base n=2 rel tmp red=0 status body later nowords="" own="" \
        rdir rasks at next keep
  [ "$sub" = save ] || die "usage: council ask save [slug]   (after writing the user's words to <run>/ask.md)"
  shift
  slug="${1:-}"
  run="$(resolve_run)" || exit 2
  name="${run##*/}"; st="$run/session-state.md"; ask="$run/ask.md"
  [ -f "$ask" ] || die "no ask.md in $run — write the user's words there first"
  body="$(ask_words "$ask")"; later="$(ask_later "$ask")"          # for the checks below only
  printf '%s' "$body" | grep -q '[^[:space:]]' || die "ask.md has no words under '## In your words'"
  [ "$(printf '%s\n' "$body" | tr -d '\r' | grep -v '^[[:space:]]*$')" != "(no new words)" ] || nowords=1
  home="$(council_home)"; root="$(dirname "$home")"
  mode="$(field mode "$st")"
  # The request this run continues: the state's ask=, else ask.md's own continues: line.
  cur="$(field ask "$st")"
  [ -n "$cur" ] || cur="$(field continues "$ask" | tr -d '`<>' | sed 's/[[:space:]].*$//')"
  if [ -n "$cur" ]; then
    cur="$(printf '%s' "$cur" | tr '\\' '/')"
    case "$cur" in /*|[A-Za-z]:*) target="$cur" ;; *) target="$root/$cur" ;; esac
    # Only a real file inside asks/: no ".." step, no link, and the folder it resolves to is asks/ (or
    # below it) — compared after resolving both, so C:/…, /c/… and a relative path all work.
    case "/$cur/" in */../*) die "a request is filed under $home/asks/, not $cur — copy the words into ask.md instead" ;; esac
    rdir="$(cd -P "$(dirname "$target")" 2>/dev/null && here)"
    rasks="$(cd -P "$home/asks" 2>/dev/null && here)"
    case "$rdir/" in
      "$rasks"/*) [ -n "$rasks" ] || die "the request this run continues is missing: $cur"
                  target="$home/asks${rdir#"$rasks"}/${target##*/}" ;;
      *) die "a request is filed under $home/asks/, not $cur — copy the words into ask.md instead" ;;
    esac
    [ -f "$target" ] || die "the request this run continues is missing: $cur"
    [ ! -L "$target" ] || die "a request is filed under $home/asks/, not $cur (a link) — copy the words into ask.md instead"
    [ "$(sed -n '2p' "$target" | tr -d '\r')" != "run: $name" ] || own=1        # this run filed it: re-file its words
  elif [ -n "$nowords" ]; then
    die "ask.md says (no new words) but names no request to continue — add continues: <path> to it, or run council state ask=<path>"
  fi
  if [ ! -d "$home/asks" ]; then                    # the user's own words stay on their machine
    mkdir -p "$home/asks" 2>/dev/null || die "cannot create $home/asks"
    if [ -f "$home/.gitignore" ]; then
      if ! grep -q '^[[:space:]]*asks/\{0,1\}[[:space:]]*$' "$home/.gitignore"; then
        [ -z "$(tail -c 1 "$home/.gitignore" 2>/dev/null)" ] || printf '\n' >> "$home/.gitignore"
        printf 'asks/\n' >> "$home/.gitignore" 2>/dev/null || true
      fi
    else
      printf 'runs/\nactive-run\nasks/\n' > "$home/.gitignore" 2>/dev/null || true
    fi
  fi
  tmp="$run/.ask.tmp"
  rm -f "$tmp" "$tmp.2" "$tmp.3"
  if [ -z "$cur" ] || [ -n "$own" ]; then
   if [ -z "$cur" ]; then
    if [ -z "$slug" ]; then                           # from the title as filed, so a pasted key never names the file
      head -n 1 "$ask" > "$tmp.3" && redact_copy "$tmp.3" "$tmp.2" >/dev/null
      slug="$(sed 's/^#[[:space:]]*[Aa]sk//; s/\[redacted[^]]*\]//g' "$tmp.2" 2>/dev/null)"
    fi
    slug="$(printf '%s' "$slug" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//' | cut -c1-40 | sed 's/-*$//')"
    [ -n "$slug" ] || slug=request
    base="$home/asks/$(date '+%Y-%m-%d')-$slug"; target="$base.md"
    while [ -e "$target" ] || [ -L "$target" ]; do target="$base-$n.md"; n=$((n + 1)); done
   fi
    { head -n 1 "$ask"; printf 'run: %s\nmode: %s\n' "${run##*/}" "${mode:--}"; tail -n +2 "$ask"; } > "$tmp" || die "cannot write $tmp"
    red="$(redact_copy "$tmp" "$tmp.2")" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot write $target"; }
    if [ -n "$own" ]; then                            # re-filed: the sections later runs added stay, as written
      at="$(ask_sections "$target" | head -n 1)"
      if [ -n "$at" ]; then printf '\n' >> "$tmp.2"; LC_ALL=C sed $(sed_b) -n "$at,\$p" "$target" >> "$tmp.2"; fi
    fi
    cat "$tmp.2" > "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot write $target"; }
    status=new
  else
    # A continuing request: this run's words go in one dated section — replaced where it stands, if this run
    # saved before; every other run's section stays.
    : > "$tmp.2"
    if [ -n "$nowords" ] && [ -z "$later" ]; then
      status="no new words"
    else
      { printf '\n## %s — %s, run %s\n' "$(date '+%Y-%m-%d')" "${mode:--}" "${run##*/}"
        ask_words "$ask"; ask_later "$ask"; } > "$tmp" || die "cannot write $tmp"
      red="$(redact_copy "$tmp" "$tmp.2")" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot append to $target"; }
      status=continued
    fi
    at="$(ask_sections "$target" "$name" | head -n 1)"
    if [ -n "$at" ]; then
      next="$(ask_sections "$target" | awk -v at="$at" '$1 > at + 0 { print; exit }')"
      keep=$((at - 1))                                 # the blank line before the heading goes with it
      if [ "$keep" -ge 1 ] && [ -z "$(sed -n "${keep}p" "$target" | tr -d '[:space:]')" ]; then keep=$((keep - 1)); fi
      { [ "$keep" -lt 1 ] || LC_ALL=C sed $(sed_b) -n "1,${keep}p" "$target"
        cat "$tmp.2"
        if [ -n "$next" ]; then printf '\n'; LC_ALL=C sed $(sed_b) -n "$next,\$p" "$target"; fi
      } > "$tmp.3" && cat "$tmp.3" > "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot update $target"; }
    elif [ -s "$tmp.2" ]; then
      cat "$tmp.2" >> "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot append to $target"; }
    fi
  fi
  rm -f "$tmp" "$tmp.2" "$tmp.3"
  case "$target" in "$root"/*) rel="${target#"$root"/}" ;; *) rel="$target" ;; esac
  RUN_ARG="$run" cmd_state ask="$rel" ask-saved="$(now_min)" >/dev/null
  [ "${red:-0}" -eq 0 ] 2>/dev/null || say "ask: redacted $red secret-looking string(s) — tell the user"
  say "ask: $rel ($status)"
}

# ------------------------------------------------------------------------------------------------
# Seat ledger — one row per seat per completed run, tracked in the council home
# ------------------------------------------------------------------------------------------------

# A seat's output file, from its brief block (default seats/<slug>.md).
seat_out() {
  local out
  out="$(brief_seats "$1/brief.md" 2>/dev/null | SLUG="$2" awk -F'\t' '$1 == ENVIRON["SLUG"] { print $3; exit }')"
  [ -n "$out" ] || out="seats/$2.md"
  case "$out" in /*|[A-Za-z]:*) printf '%s' "$out" ;; *) printf '%s/%s' "$1" "$out" ;; esac
}

# Per-seat kept / cut / refuted counts for a run, from synthesis.md's "from:" provenance and the
# REFUTED rows of its verify-*.md tables. Rows: slug kept cut refuted.
synthesis_counts() {
  local run="$1"
  [ -f "$run/synthesis.md" ] || return 0
  set -- "$run"/verify-*.md
  [ -e "$1" ] || set --
  SYN="$run/synthesis.md" awk '
    FNR == 1 { sec = ""; vcol = 0 }
    FILENAME == ENVIRON["SYN"] {
      if ($0 ~ /^## /) { sec = ($0 ~ /^## Kept/) ? "k" : (($0 ~ /^## Cut/) ? "c" : ""); next }
      if (sec == "" || index($0, "from:") == 0) next
      n = $0; sub(/^[-* \t]*/, "", n); sub(/[ \t].*$/, "", n); sub(/\.$/, "", n)
      f = substr($0, index($0, "from:") + 5); sub(/[ \t]+·.*$/, "", f); gsub(/[`\r]/, "", f)   # the first from: only
      m = split(f, parts, /[ \t]*,[ \t]*/)
      for (i = 1; i <= m; i++) {
        s = parts[i]; sub(/#.*$/, "", s); gsub(/[ \t]/, "", s)
        if (s == "") continue
        seen[s] = 1
        if (sec == "k") { kept[s]++; owners[n] = owners[n] " " s } else cut[s]++
      }
      next
    }
    /^\|/ {                                          # a verify table: find its Verdict column, then read it exactly
      k = split($0, c, "|")
      if (!vcol) { for (i = 2; i < k; i++) { h = c[i]; gsub(/[ \t\r*]/, "", h); if (tolower(h) == "verdict") vcol = i }; next }
      v = c[vcol]; gsub(/[ \t\r*]/, "", v); num = c[2]; gsub(/[ \t\r*]/, "", num)
      if (v == "REFUTED" && num ~ /^[0-9]+$/) refd[num] = 1
    }
    END {
      for (v in refd) { k = split(owners[v], o, " "); for (i = 1; i <= k; i++) if (o[i] != "") refuted[o[i]]++ }
      for (s in seen) printf "%s\t%d\t%d\t%d\n", s, kept[s], cut[s], refuted[s]
    }' "$run/synthesis.md" ${1+"$@"}
}

# Record a completed run's seats in the ledger; re-recording a run replaces its rows. Prints the count.
ledger_record() {
  local run="$1" home ledger name mode date counts new="" slug tok f raised line rows=0 vt=0
  case "$run" in */runs/*) home="${run%/runs/*}" ;; *) home="$(council_home)" ;; esac   # the run's own council home
  ledger="$home/ledger.tsv"
  [ -f "$run/seats.tsv" ] || { printf '0'; return 0; }
  name="${run##*/}"; mode="$(field mode "$run/session-state.md")"; date="$(printf '%s' "$name" | cut -c1-10)"
  counts="$(synthesis_counts "$run")"
  while IFS="$TAB" read -r slug tok; do
    [ -n "$slug" ] || continue
    case "$slug" in verify-*|diagnose-*) vt=$((vt + tok)); continue ;; esac
    f="$(seat_out "$run" "$slug")"
    case "$slug" in
      *-r[0-9]*) raised=0 ;;                           # a war room's round 2 raises nothing new: from: cites round 1
      *) raised="$(index_lines "$f" | grep -c . || true)" ;;
    esac
    line="$(printf '%s\n' "$counts" | SLUG="$slug" awk -F'\t' '$1 == ENVIRON["SLUG"] { print $2 "\t" $3 "\t" $4; exit }')"
    [ -n "$line" ] || line="$(printf '0\t0\t0')"
    new="$new$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$date" "$name" "${mode:--}" "$slug" "${raised:-0}" "$line" "$tok")
"
    rows=$((rows + 1))
  done <<SEATS
$(awk -F'\t' 'NR > 1 && $2 != "skipped" && $2 != "queued" { print $1 "\t" (($4 ~ /^[0-9]+$/) ? $4 : 0) }' "$run/seats.tsv")
SEATS
  [ "$vt" -eq 0 ] || new="$new$(printf '%s\t%s\t%s\t(verifiers)\t-\t-\t-\t-\t%s' "$date" "$name" "${mode:--}" "$vt")
"
  [ -n "$new" ] || { printf '0'; return 0; }
  if [ ! -f "$ledger" ] && ! printf 'date\trun\tmode\tseat\traised\tkept\tcut\trefuted\ttokens\n' > "$ledger" 2>/dev/null; then
    printf 'council: could not write %s — the ledger was not updated\n' "$ledger" >&2; printf '0'; return 0
  fi
  if { RUN="$name" awk -F'\t' '$2 != ENVIRON["RUN"]' "$ledger"; printf '%s' "$new"; } > "$ledger.tmp$$" 2>/dev/null \
     && mv "$ledger.tmp$$" "$ledger" 2>/dev/null; then
    printf '%s' "$rows"
  else
    rm -f "$ledger.tmp$$" 2>/dev/null
    printf 'council: could not write %s — the ledger was not updated\n' "$ledger" >&2; printf '0'
  fi
}

cmd_ledger() {
  local ledger last="${1:-10}"
  ledger="$(council_home)/ledger.tsv"
  case "$last" in ''|*[!0-9]*) die "usage: council ledger [how many recent runs, default 10]" ;; esac
  [ -f "$ledger" ] || { say "no ledger yet — every completed run adds its seats to $ledger"; return 0; }
  LAST="$last" awk -F'\t' '
    NR == 1 { next }
    { row[NR] = $0; if (!($2 in seen)) { seen[$2] = 1; order[++nr] = $2 } }
    END {
      if (nr == 0) { print "the ledger has no runs yet"; exit }
      first = nr - ENVIRON["LAST"] + 1; if (first < 1) first = 1
      for (i = first; i <= nr; i++) keep[order[i]] = 1
      for (r = 2; r <= NR; r++) {
        if (!(r in row)) continue
        split(row[r], f, "\t"); if (!(f[2] in keep)) continue
        s = f[4]; sub(/-(r[0-9]+|[a-z])$/, "", s)        # a split worker (hunt-a) or a fresh round-2 one (hunt-r2) is its seat
        if (!(s in runs)) { names[++ns] = s; runs[s] = 0 }
        if (!((f[2], s) in counted)) { counted[f[2], s] = 1; runs[s]++ }
        raised[s] += f[5]; kept[s] += f[6]; cut[s] += f[7]; refd[s] += f[8]; tok[s] += f[9]
      }
      printf "%-16s %4s %6s %5s %4s %7s %8s %9s\n", "seat", "runs", "raised", "kept", "cut", "refuted", "~k/run", "shipped"
      for (i = 1; i <= ns; i++) {
        s = names[i]; ship = kept[s] - refd[s]
        pct = (raised[s] > 0) ? int(100 * ship / raised[s] + 0.5) "%" : "-"
        printf "%-16s %4d %6d %5d %4d %7d %8d %9s\n", s, runs[s], raised[s], kept[s], cut[s], refd[s], int(tok[s] / runs[s] / 1000 + 0.5), pct
      }
      printf "over the last %d completed run(s) · shipped = kept and not refuted, as a share of items raised\n", nr - first + 1
    }' "$ledger"
}

# ------------------------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
council — the Small Council's helper (bash + git)

  council home                           where the council lives (.council/ of the main checkout)
  council run open <mode> [--alongside] [--session=ID]
                                         open a run for a mode, e.g. council-review; prints its folder
  council run status [--all]             open runs (the last 20 with --all)
  council run close [--status complete|abandoned|paused]
  council state [key=value …]            show or update the run's session-state header
  council seat <slug> <state> [agent=ID] [tokens=N] [note=TEXT]
                                         record a worker: queued|running|done|failed|blocked|skipped
  council index [--base REF]             change index → <run>/index.md (hunks, symbols, callers, tests)
  council gate <name> [-- '<command>']   run one gate — quote the whole command, so && and quotes stay
                                         inside it; output and exit code → <run>/gates/
  council gate --all [--at grounding|verify]
                                         run the configured gates
  council gates                          list the configured gates
  council changed [--glob '<pat>'] [--each] -- <cmd>
                                         run <cmd> over just the files this change touches (0 when none)
  council collect                        check every seat file named in the brief (and a war room's debate.md)
  council check [file …] [--base REF]    check citations and origin (default: synthesis.md)
  council map status                     how far the map is behind HEAD, by area
  council fingerprint [check]            the stack's fingerprint; check compares it with the config
  council memory [index|check]           memory's one-line index · anchors that went stale
  council memory select [path|slug …]    the entries in scope (default: the run's files and seats)
  council prior [path …]                 earlier council work on these paths (default: the index)
  council ask save [slug]                file the run's ask.md — the user's words — under .council/asks/;
                                         secret-looking strings are redacted; records ask= in the state
  council ledger [N]                     each seat's record over the last N completed runs (default 10)
  council doctor                         drift scan; every finding comes with a fix

Run-scoped commands act on the one in-progress run on this working tree; otherwise pass --run <folder>
(a path, or a folder name under runs/).
EOF
}

main() {
  RUN_ARG="" CODE_ROOT_ARG="" STATUS_ARG="" BASE_ARG="" AT_ARG="" ALL=0 GATE_CMD="" SESSION_ARG="" ALONGSIDE=0
  AFTER_DD=()
  local -a pos
  local cmd sub
  pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --run)       [ $# -ge 2 ] || die "--run needs a folder";          RUN_ARG="$2"; shift 2 ;;
      --run=*)     RUN_ARG="${1#--run=}"; shift ;;
      --code-root) [ $# -ge 2 ] || die "--code-root needs a folder";    CODE_ROOT_ARG="$2"; shift 2 ;;
      --status)    [ $# -ge 2 ] || die "--status needs a value";        STATUS_ARG="$2"; shift 2 ;;
      --base)      [ $# -ge 2 ] || die "--base needs a ref";            BASE_ARG="$2"; shift 2 ;;
      --at)        [ $# -ge 2 ] || die "--at needs grounding or verify"; AT_ARG="$2"; shift 2 ;;
      --session=*) SESSION_ARG="${1#--session=}"; shift ;;
      --alongside) ALONGSIDE=1; shift ;;
      --all)       ALL=1; shift ;;
      --)          shift
                   AFTER_DD=(${1+"$@"})                                 # the words themselves, for council changed
                   if [ $# -eq 1 ]; then GATE_CMD="$1"                  # one quoted string: a shell command, as written
                   elif [ $# -gt 1 ]; then GATE_CMD="$(printf '%q ' "$@")"; GATE_CMD="${GATE_CMD% }"   # separate words: kept intact
                   fi
                   break ;;
      -h|--help)   usage; exit 0 ;;
      *)           pos+=("$1"); shift ;;
    esac
  done
  set -- "${pos[@]+"${pos[@]}"}"
  [ $# -gt 0 ] || { usage; exit 0; }
  cmd="$1"; shift
  case "$cmd" in
    home)    council_home ;;
    run)
      sub="${1:-}"; [ $# -eq 0 ] || shift
      case "$sub" in
        open)   cmd_run_open ${1+"$@"} ;;
        close)  cmd_run_close ;;
        status) cmd_run_status ;;
        *) die "usage: council run open <mode> | run status [--all] | run close [--status …]" ;;
      esac ;;
    state)   cmd_state ${1+"$@"} ;;
    seat)    cmd_seat ${1+"$@"} ;;
    index)   cmd_index ;;
    gate)    cmd_gate ${1+"$@"} ;;
    gates)   cmd_gates ;;
    changed) cmd_changed ${1+"$@"} ;;
    collect) cmd_collect ;;
    check)   cmd_check ${1+"$@"} ;;
    map)     cmd_map ${1+"$@"} ;;
    fingerprint) cmd_fingerprint ${1+"$@"} ;;
    memory)  cmd_memory ${1+"$@"} ;;
    prior)   cmd_prior ${1+"$@"} ;;
    ask)     cmd_ask ${1+"$@"} ;;
    ledger)  cmd_ledger ${1+"$@"} ;;
    doctor)  cmd_doctor ;;
    version) say "council $COUNCIL_VERSION" ;;
    help)    usage ;;
    *) die "unknown command '$cmd' — see: council help" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
