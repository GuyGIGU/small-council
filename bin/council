#!/usr/bin/env bash
# council — the Small Council's helper for the mechanical steps a model tends to skip.
#
# It opens, tracks and closes runs; runs gates and judges them by exit code; builds the change index;
# checks seat files and citations; and scans the council for drift. Output is short and plain, meant
# for the Chair to read.
#
# Portability: bash 3.2+ (macOS), Git Bash on Windows, Linux — git and POSIX tools only (awk, sed,
# grep, find, date). No associative arrays, no mapfile, no ${var,,}. Values that may hold Windows
# paths reach awk through ENVIRON, never -v (awk -v would eat the backslashes). Internal rows are
# tab-separated and never carry an empty field ("-" stands in), because `read` with IFS=tab merges
# consecutive tabs.
#
# The SessionStart hook sources this file for council_home / list_runs / seat_summary, so the hook
# and the helper always resolve the council home the same way.

set -u

COUNCIL_VERSION="0.7.1"
COUNCIL_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
TAB="$(printf '\t')"
BOM=$'\357\273\277'          # a UTF-8 byte-order mark (PowerShell 5.1 writes one): never part of the first line
NL='
'
CITE_AREA=0; CITE_NEEDS_PLACE=0; CITE_ROWS=""

die()     { printf 'council: %s\n' "$*" >&2; exit 2; }
say()     { printf '%s\n' "$*"; }
now_min() { date '+%Y-%m-%d %H:%M'; }
now_sec() { date '+%Y-%m-%d %H:%M:%S'; }
here()    { pwd -W 2>/dev/null || pwd; }
dash()    { if [ -n "$1" ]; then printf '%s' "$1"; else printf '%s' '-'; fi; }
undash()  { if [ "$1" = "-" ]; then printf ''; else printf '%s' "$1"; fi; }

# First "key: value" in a header-style file; a byte-order mark, carriage returns and trailing
# "   # comments" stripped.
field() {
  sed -n -e "1s/^$BOM//" -e "s/^$1:[[:space:]]*//p" "$2" 2>/dev/null | head -n 1 | tr -d '\r' | sed 's/[[:space:]]\{2,\}#.*$//'
}

json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\t\r\n' '   '; }

# Shorten each line to about N characters, at a space, so a multibyte character is never cut in half.
clip() { awk -v n="$1" '{ if (length($0) > n) { t = substr($0, 1, n); sub(/ [^ ]*$/, "", t); $0 = t " …" } print }'; }

# Letters and digits only, lowercased — for comparing a seat's ref: line with its doc's title.
norm() { tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'; }

# The same, but keeping letters no ASCII rule knows — a title written in Hebrew, Chinese or Greek
# would otherwise come out empty, and an empty title can prove nothing. Punctuation that looks like
# a letter to a byte-wise tool (curly quotes, dashes, ellipses, emoji) still goes.
norm_wide() {
  LC_ALL=C awk '{
    gsub(/\342\200[\200-\277]|\342\201[\200-\277]|\342[\206-\254][\200-\277]/, "")   # dashes, quotes, arrows, symbols
    gsub(/\302[\200-\277]|\343\200[\200-\277]|\357\270[\200-\217]|\357\273\277/, "") # NBSP, "·", CJK marks, BOM
    gsub(/\360\237[\200-\277][\200-\277]/, "")                                       # emoji
    gsub(/[^A-Za-z0-9\200-\377]/, ""); printf "%s", tolower($0)
  } END { printf "\n" }' | tr -d '\r'
}

# ------------------------------------------------------------------------------------------------
# Where the council lives
# ------------------------------------------------------------------------------------------------

council_toplevel() { git rev-parse --show-toplevel 2>/dev/null; }

# The .council/ of the MAIN checkout, shared by every linked worktree. A submodule keeps its own; a
# bare repo's worktrees use the one that holds the council's config (else one with a .council/, else
# this one) — never whichever name sorts first; outside git it is ./.council.
council_home() {
  local top main list wt cfg any
  top="$(council_toplevel)"
  if [ -z "$top" ]; then printf '%s/.council\n' "$(here)"; return 0; fi
  if [ -n "$(git rev-parse --show-superproject-working-tree 2>/dev/null)" ]; then
    printf '%s/.council\n' "$top"; return 0
  fi
  # Every non-bare worktree, the main checkout first; "(bare)" first when the repository itself is bare.
  list="$(git worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { if (w != "" && !b) print w; w = substr($0, 10); b = 0; n++; next }
    /^bare$/     { b = 1; if (n == 1) print "(bare)" }
    END          { if (w != "" && !b) print w }')"
  main="${list%%"$NL"*}"
  if [ "$main" = "(bare)" ]; then
    main=""; cfg=""; any=""
    while IFS= read -r wt; do
      [ -n "$wt" ] && [ "$wt" != "(bare)" ] || continue
      if [ -z "$cfg" ] && [ -f "$wt/.council/council.config.md" ]; then cfg="$wt"; fi
      if [ -z "$any" ] && [ -d "$wt/.council" ]; then any="$wt"; fi
    done <<WORKTREES
$list
WORKTREES
    main="${cfg:-$any}"
  fi
  [ -n "$main" ] || main="$top"
  if [ ! -d "$main/.council" ] && [ -d "$top/.council" ]; then main="$top"; fi   # a 0.1 council inside a worktree
  printf '%s/.council\n' "$main"
}

# The working tree a run's code-root is compared with.
this_tree() { local t; t="$(council_toplevel)"; [ -n "$t" ] || t="$(here)"; printf '%s' "$t"; }

# The skill that owns a run, from its mode: field (0.2 runs sometimes wrote the short name).
mode_skill() {
  case "$1" in
    council-*|test-architect|spec-writer|context-core) printf '%s' "$1" ;;
    review|plan|implement|research|postgame|init) printf 'council-%s' "$1" ;;
    *) printf 'context-core' ;;
  esac
}

# Runs, newest first, tab-separated, "-" for an empty value:
#   dir mode phase code-root updated status actual session
# $2 caps how many are listed; $3 = open (in-progress or paused, however old) | all (the newest).
# Every state file is read in one awk pass (the same rules as field), so the cost barely grows with
# the number of runs — the SessionStart hook has 15 s.
list_runs() {
  local home="$1" limit="${2:-30}" which="${3:-open}"
  [ -d "$home/runs" ] || return 0
  if [ "$which" = open ]; then
    grep -l -E "^($BOM)?status:[[:space:]]*(in-progress|paused)" "$home"/runs/*/session-state.md 2>/dev/null | sort -r
  else
    ls -1 "$home/runs" 2>/dev/null | sort -r | while IFS= read -r name; do
      [ -f "$home/runs/$name/session-state.md" ] && printf '%s\n' "$home/runs/$name/session-state.md"
    done
  fi | head -n "$limit" | awk '
    function out(s) { return s == "" ? "-" : s }
    $0 != "" {
      st = $0; split("", v); n = 0
      while ((getline line < st) > 0) {
        if (++n == 1) sub(/^\357\273\277/, "", line)
        gsub(/\r/, "", line)
        if (!match(line, /^[a-z][a-z0-9-]*:/)) continue
        k = substr(line, 1, RLENGTH - 1)
        if (k in v) continue
        val = substr(line, RLENGTH + 1); sub(/^[ \t]+/, "", val); sub(/[ \t][ \t]+#.*$/, "", val); gsub(/\t/, " ", val)
        v[k] = val
      }
      close(st)
      if (n == 0) next
      s = v["status"]; sub(/ .*$/, "", s)
      d = st; sub(/\/session-state\.md$/, "", d)
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", d, out(v["mode"]), out(v["phase"]), out(v["code-root"]), out(v["updated"]), out(s), out(v["actual"]), out(v["session"])
    }'
}

# Open runs on this working tree (a run with no code-root counts as this tree's): their folders — all of
# them, however many other trees' runs are open. $3, if given, keeps only that status.
runs_here() {
  list_runs "$1" 1000000 open | TOP="$2" ST="${3:-}" awk -F'\t' '
    ($4 == ENVIRON["TOP"] || $4 == "-") && (ENVIRON["ST"] == "" || $6 == ENVIRON["ST"]) { print $1 }'
}

# Run folders (one per line) → "name, name".
names() { awk -F/ '{ printf "%s%s", (NR > 1 ? ", " : ""), $NF }'; }

# "still working: a, b · done: c · failed: d" from a run's seats.tsv; $2 renames "still working".
seat_summary() {
  [ -f "$1/seats.tsv" ] || return 0
  W="${2:-still working}" awk -F'\t' '
    NR > 1 {
      if ($2 == "running" || $2 == "queued") w = w (w ? ", " : "") $1 (($6 ~ /round 2/) ? " (war-room round 2)" : "")
      else if ($2 == "done") d = d (d ? ", " : "") $1
      else if ($2 == "failed" || $2 == "blocked") f = f (f ? ", " : "") $1
    }
    END { s = ""; if (w) s = ENVIRON["W"] ": " w; if (d) s = s (s ? " · " : "") "done: " d; if (f) s = s (s ? " · " : "") "failed: " f; printf "%s", s }' "$1/seats.tsv"
}

# The run a command acts on: --run (a path, or a folder name under runs/), then $COUNCIL_RUN, then
# the one in-progress run on this working tree. Never guesses between several, and never picks a
# paused run on its own.
resolve_run() {
  local home mine count paused p
  if [ -n "$RUN_ARG" ]; then
    RUN_ARG="$(run_path "$RUN_ARG")"
    [ -f "$RUN_ARG/session-state.md" ] || die "not a run folder: $RUN_ARG"
    printf '%s\n' "$RUN_ARG"; return 0
  fi
  if [ -n "${COUNCIL_RUN:-}" ] && [ -f "$COUNCIL_RUN/session-state.md" ]; then printf '%s\n' "$COUNCIL_RUN"; return 0; fi
  home="$(council_home)"
  mine="$(runs_here "$home" "$(this_tree)" in-progress)"
  count="$(printf '%s' "$mine" | grep -c . || true)"
  if [ "${count:-0}" -eq 1 ]; then printf '%s\n' "$mine"; return 0; fi
  if [ "${count:-0}" -gt 1 ]; then
    die "several runs are open on this working tree — pass --run <folder>: $(printf '%s\n' "$mine" | names)"
  fi
  paused="$(runs_here "$home" "$(this_tree)" paused)"
  if [ -n "$paused" ]; then
    case "$paused" in *"$NL"*) p="<folder>" ;; *) p="${paused##*/}" ;; esac
    die "no in-progress run on this working tree (paused: $(printf '%s\n' "$paused" | names)) — to carry on with it: council run resume --run $p; to act on it while it stays paused, pass --run <folder>"
  fi
  die "no open run on this working tree — open one with: council run open <mode>   (or pass --run <folder>)"
}

# A --run value as a run folder: backslashes read as /, trailing separators dropped, a relative path
# made absolute (commands may change folder), a bare name looked up under runs/.
run_path() {
  local bs='\' r
  r="${1//"$bs"//}"
  while [ "${r%/}" != "$r" ] && [ -n "${r%/}" ]; do r="${r%/}"; done
  if [ -f "$r/session-state.md" ]; then
    case "$r" in /*|[A-Za-z]:/*) ;; *) r="$(cd "$r" 2>/dev/null && here)" || r="$1" ;; esac
  elif [ -f "$(council_home)/runs/$r/session-state.md" ]; then
    r="$(council_home)/runs/$r"
  fi
  printf '%s' "$r"
}

# ------------------------------------------------------------------------------------------------
# Runs
# ------------------------------------------------------------------------------------------------

# Does git ignore this path under a council home ($1)? Patterns only, so a file already tracked doesn't
# change the answer. Outside git (check-ignore can't answer), the home's .gitignore has the line or not.
home_ignores() {
  local rc=0
  git -C "$(dirname "$1")" check-ignore --no-index -q -- "${1##*/}/$2" 2>/dev/null || rc=$?
  [ "$rc" -gt 1 ] || return "$rc"
  grep -q -x -E "[[:space:]]*/?${2%%/*}/?[[:space:]]*" "$1/.gitignore" 2>/dev/null
}

# The user chose to share their requests with the team: a "!asks/" line in <home>/.gitignore.
asks_shared() { grep -q -E '^[[:space:]]*!/?asks/?[[:space:]]*$' "$1/.gitignore" 2>/dev/null; }

# Keep run scratch and the user's own words out of git: add runs/, asks/ and active-run to <home>/.gitignore
# unless git already ignores them (asks/ also not when the user shares requests) — in the file's own line
# endings, each on a line of its own. Requests already in git stay tracked, so adding asks/ then says so,
# and how to keep sharing them instead (a 0.7.0 home shared them by leaving the line out).
ensure_ignored() {
  local gi="$1/.gitignore" cr="" want probe added=""
  [ ! -f "$gi" ] || [ "$(tr -cd '\r' < "$gi" | wc -c | tr -d ' ')" = 0 ] || cr="$(printf '\r')"
  for want in runs/ asks/ active-run; do
    case "$want" in */) probe="${want}x" ;; *) probe="$want" ;; esac      # a folder's pattern needs a path inside it
    home_ignores "$1" "$probe" && continue
    if [ "$want" = asks/ ] && asks_shared "$1"; then continue; fi
    if [ -s "$gi" ] && [ -n "$(tail -c 1 "$gi")" ]; then printf '%s\n' "$cr" >> "$gi"; fi
    printf '%s%s\n' "$want" "$cr" >> "$gi" || continue
    [ "$want" != asks/ ] || added=1
  done 2>/dev/null
  if [ -n "$added" ] && [ -n "$(git -C "$(dirname "$1")" ls-files -- "${1##*/}/asks" 2>/dev/null | head -n 1)" ]; then
    printf "council: %s now ignores asks/, so new requests stay on this machine; the ones already in git stay tracked. To share requests with the team, write '!asks/' in place of that line.\n" "${1##*/}/.gitignore" >&2
  fi
  return 0
}

cmd_run_open() {
  local mode="${1:-}" short home top ts dir n existing paused session
  case "$mode" in
    council-review|council-plan|council-implement|council-research|council-postgame|council-init|test-architect|context-core) ;;
    '') die "usage: council run open <mode> [--alongside] [--session=ID]   (the skill name, e.g. council-review)" ;;
    *) die "unknown mode '$mode' — use a skill name: council-review, council-plan, council-implement, council-research, council-postgame, council-init, test-architect, context-core" ;;
  esac
  case "$mode" in council-*) short="${mode#council-}" ;; context-core) short=core ;; *) short="$mode" ;; esac
  home="$(council_home)"
  if [ ! -d "$home" ]; then
    case "$mode" in
      council-init|council-postgame)    # init maps before a config exists; a post-game may check work done without the council
        mkdir -p "$home" 2>/dev/null || die "cannot create $home" ;;
      *) die "no council home at $home — run council-init first" ;;
    esac
  fi
  ensure_ignored "$home"                          # before any words land in runs/ — older homes too
  top="${CODE_ROOT_ARG:-$(this_tree)}"
  existing="$(runs_here "$home" "$top" in-progress | names)"
  paused="$(runs_here "$home" "$top" paused | names)"
  if [ -n "$existing" ] && [ "$ALONGSIDE" != 1 ]; then
    die "a run is already in progress on this working tree ($existing) — resume it, close it (council run close --run <folder> --status abandoned), or open this one with --alongside and pass --run <folder> to every later command"
  fi
  session="${SESSION_ARG:-${CLAUDE_CODE_SESSION_ID:-}}"      # so a compaction resumes only this session's run
  ts="$(date '+%Y-%m-%d-%H%M%S')"
  dir="$home/runs/$ts-$short"; n=2
  while [ -e "$dir" ]; do dir="$home/runs/$ts-$short-$n"; n=$((n + 1)); done
  mkdir -p "$dir/seats" "$dir/gates" 2>/dev/null || die "cannot create $dir"
  { : > "$dir/.write-check"; } 2>/dev/null && rm -f "$dir/.write-check" || die "cannot write in $dir"
  cat > "$dir/session-state.md" <<EOF
status: in-progress
mode: $mode
phase: convene
updated: $(now_min)
opened: $(now_sec)
code-root: $top
session: $session
size:
base:
deliverable:
next: size the run and ask for the go-ahead
## Decisions so far
EOF
  printf '# Run log — %s · opened %s\n' "$mode" "$(now_sec)" > "$dir/log.md"
  printf 'slug\tstate\tagent\ttokens\tupdated\tnote\tagents\n' > "$dir/seats.tsv"
  [ -z "$existing" ] || printf 'council: another run is in progress on this working tree — pass --run %s to every command for this one\n' "${dir##*/}" >&2
  [ -z "$paused" ] || printf 'council: a paused run is also open here (%s) — it stays paused\n' "$paused" >&2
  case "$mode" in
    council-review|council-plan|council-implement|council-research|council-postgame)
      printf "council: save the user's request word for word in %s/ask.md before anything else\n" "$dir" >&2 ;;
  esac
  say "$dir"
}

cmd_state() {
  local run st kv key tmp
  run="$(resolve_run)" || exit 2
  st="$run/session-state.md"
  if [ $# -eq 0 ]; then awk '/^## /{ exit } { print }' "$st"; return 0; fi
  tmp="$st.tmp$$"                                      # a leading byte-order mark would hide the first key
  awk 'NR == 1 { sub(/^\357\273\277/, "") } { print }' "$st" > "$tmp" || { rm -f "$tmp"; die "cannot update $st"; }
  for kv in ${1+"$@"}; do
    key="${kv%%=*}"
    if [ "$key" = "$kv" ]; then rm -f "$tmp"; die "expected key=value, got: $kv"; fi
    case "$key" in ''|*[!a-z0-9-]*) rm -f "$tmp"; die "bad key: $key (lowercase letters, digits, dashes)" ;; esac
    if [ "$key" = status ]; then
      case "${kv#*=}" in in-progress|paused|complete|abandoned) ;; *) rm -f "$tmp"; die "status must be in-progress, paused, complete or abandoned" ;; esac
    fi
    K="$key" V="$(printf '%s' "${kv#*=}" | tr '\r\n' '  ')" awk '
      BEGIN { k = ENVIRON["K"] ":"; line = ENVIRON["K"] ": " ENVIRON["V"] }
      !done && index($0, k) == 1 { print line; done = 1; next }
      !done && /^## / { print line; done = 1 }
      { print }
      END { if (!done) print line }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  done
  NOW="$(now_min)" awk '
    BEGIN { l = "updated: " ENVIRON["NOW"] }
    !d && index($0, "updated:") == 1 { print l; d = 1; next }
    { print }' "$tmp" > "$tmp.2" && mv "$tmp.2" "$tmp"
  mv "$tmp" "$st"
  say "state: phase $(field phase "$st") · $(field status "$st") · ${run##*/}"
}

# Carry on with an open run — a paused one, or one another session was driving: mark it in progress,
# drop a pause's closed: stamp and record this session as its driver, so a compaction here resumes it.
# Plain state and seat calls never do this: taking a run over is always asked for.
cmd_run_resume() {
  local run st name status old session mine count others croot drv
  if [ -n "$RUN_ARG" ]; then
    run="$(resolve_run)" || exit 2
  else
    mine="$(runs_here "$(council_home)" "$(this_tree)")"
    count="$(printf '%s' "$mine" | grep -c . || true)"
    [ "${count:-0}" -gt 0 ] || die "no open run on this working tree to resume — council run status lists the runs"
    [ "$count" -eq 1 ] || die "several runs are open on this working tree — pass --run <folder>: $(printf '%s\n' "$mine" | names)"
    run="$mine"
  fi
  st="$run/session-state.md"; name="${run##*/}"
  status="$(field status "$st")"; status="${status%% *}"
  case "$status" in
    complete|abandoned) die "$name is closed ($status) — open a new run instead: council run open $(mode_skill "$(field mode "$st")")" ;;
  esac
  old="$(field session "$st")"
  session="${SESSION_ARG:-${CLAUDE_CODE_SESSION_ID:-}}"
  RUN_ARG="$run" cmd_state status=in-progress session="$session" >/dev/null || exit 2
  awk '/^## / { body = 1 } !body && index($0, "closed:") == 1 { next } { print }' "$st" > "$st.tmp$$" \
    && mv "$st.tmp$$" "$st" || { rm -f "$st.tmp$$"; die "cannot update $st"; }
  if [ -n "$session" ]; then drv="driven by this session"; else drv="no session id to record"; fi
  say "resumed $name — in progress · phase $(field phase "$st") · $drv"
  if [ -n "$old" ] && [ "$old" != "$session" ]; then
    say "it was driven by session $old — if that session is still open, it may still be working on this run: ask the user before re-dispatching any seat"
  fi
  [ -z "$(seat_summary "$run")" ] || say "seats — $(seat_summary "$run")"
  others="$(runs_here "$(council_home)" "$(this_tree)" in-progress | N="$name" awk -F/ '$NF != ENVIRON["N"]' | names)"
  [ -z "$others" ] || printf 'council: another run is in progress on this working tree (%s) — pass --run %s to every command for this one\n' "$others" "$name" >&2
  croot="$(field code-root "$st")"
  if [ -n "$croot" ] && [ "$croot" != "$(this_tree)" ]; then
    if [ -d "$croot" ]; then
      printf 'council: its code root is %s, not this working tree — work there\n' "$croot" >&2
    else
      printf 'council: its code root %s no longer exists — the run cannot go on; close it: council run close --run %s --status abandoned\n' "$croot" "$name" >&2
    fi
  fi
}

# Tokens accumulate per seat (one completion notification = one agent); a new agent id on a seat
# counts as another agent — a resumed or re-dispatched worker never erases the earlier cost.
progress_line() {
  awk -F'\t' '
    NR > 1 && $2 != "skipped" {
      n++
      if ($2 == "done") d++
      else if ($2 == "running" || $2 == "queued") w = w (w ? ", " : "") $1
      else if ($2 == "failed" || $2 == "blocked") f = f (f ? ", " : "") $1
      t += $4
    }
    END {
      printf "agents: %d of %d done", d, n
      if (w) printf " · still working: %s", w
      if (f) printf " · failed: %s", f
      if (t > 0) printf " · ~%dk tokens so far", int((t + 500) / 1000)
      printf "\n"
    }' "$1/seats.tsv"
}

seat_field() {
  [ -f "$1/seats.tsv" ] || return 0
  S="$2" awk -F'\t' -v c="$3" 'NR > 1 && $1 == ENVIRON["S"] { print $c; exit }' "$1/seats.tsv"
}

cmd_seat() {
  local run slug="${1:-}" state="${2:-}" agent="" tokens="" note="" kv f
  [ -n "$slug" ] && [ -n "$state" ] || die "usage: council seat <slug> <queued|running|done|failed|blocked|skipped> [agent=ID] [tokens=N] [note=TEXT]"
  case "$state" in queued|running|done|failed|blocked|skipped) ;; *) die "seat state must be queued, running, done, failed, blocked or skipped" ;; esac
  case "$slug" in *[!A-Za-z0-9._-]*) die "bad seat slug: $slug" ;; esac
  shift 2
  for kv in ${1+"$@"}; do                            # ${1+…}: bash 3.2 calls an empty "$@" unbound under set -u
    case "$kv" in
      agent=*)  agent="${kv#agent=}" ;;
      tokens=*) tokens="$(seat_tokens "${kv#tokens=}")" \
                  || die "tokens= takes a number of tokens (74304, 74,304 or 74.3k), got: ${kv#tokens=}" ;;
      note=*)   note="$(printf '%s' "${kv#note=}" | tr '\t\r\n' '   ')" ;;
      *) die "unknown seat field: $kv (use agent=, tokens=, note=)" ;;
    esac
  done
  run="$(resolve_run)" || exit 2
  f="$run/seats.tsv"
  lock_file "$f"                                     # calls made at the same moment take turns
  [ -s "$f" ] || printf 'slug\tstate\tagent\ttokens\tupdated\tnote\tagents\n' > "$f"
  SLUG="$slug" STATE="$state" AGENT="$agent" TOKENS="$tokens" NOTE="$note" NOW="$(now_min)" awk -F'\t' -v OFS='\t' '
    NR == 1 && $1 == "slug" { if (NF < 7) $0 = $0 "\tagents"; print; next }
    NR == 1 { print "slug", "state", "agent", "tokens", "updated", "note", "agents" }   # a lost header comes back
    $1 == ENVIRON["SLUG"] {
      found = 1
      ag = ($7 == "" ? 1 : $7 + 0)
      if (ENVIRON["AGENT"] != "" && $3 != "" && ENVIRON["AGENT"] != $3) ag++
      a = ENVIRON["AGENT"]  != "" ? ENVIRON["AGENT"] : $3
      t = ENVIRON["TOKENS"] != "" ? $4 + ENVIRON["TOKENS"] : $4
      n = ENVIRON["NOTE"]   != "" ? ENVIRON["NOTE"] : $6
      print $1, ENVIRON["STATE"], a, t, ENVIRON["NOW"], n, ag
      next
    }
    { print }
    END { if (!found) print ENVIRON["SLUG"], ENVIRON["STATE"], ENVIRON["AGENT"], ENVIRON["TOKENS"], ENVIRON["NOW"], ENVIRON["NOTE"], 1 }' \
    "$f" > "$f.tmp$$" && mv "$f.tmp$$" "$f"
  rm -f "$f.tmp$$"; rmdir "$f.lock" 2>/dev/null
  progress_line "$run"
}

# A token count as a notification or the UI gives it: 74304, 74,304, "74 304", "74304 tokens", 74.3k,
# 1.2M. Empty stays empty; anything with no number fails.
seat_tokens() {
  [ -n "$1" ] || return 0
  V="$1" awk 'BEGIN {
    s = ENVIRON["V"]; gsub(/,/, "", s)
    while (match(s, /[0-9][ \t]+[0-9]/))              # a space between digits is a thousands separator
      s = substr(s, 1, RSTART) substr(s, RSTART + RLENGTH - 1)
    if (!match(s, /[0-9]+(\.[0-9]+)?[ \t]*[kKmM]?/)) exit 1
    t = substr(s, RSTART, RLENGTH); m = 1
    if (t ~ /[kK]$/) m = 1000; else if (t ~ /[mM]$/) m = 1000000
    sub(/[ \t]*[kKmM]$/, "", t)
    printf "%d", int(t * m + 0.5)
  }'
}

# Take a lock folder next to a file; a lock left by a killed call is broken after ~10 s. The wait is
# measured on the clock, not in loops: a fork costs far more on Git Bash than the sleep it runs.
lock_file() {
  local start tries=0
  start="$(date +%s)"
  while ! mkdir "$1.lock" 2>/dev/null; do
    if [ $(( $(date +%s) - start )) -ge 10 ]; then
      tries=$((tries + 1))
      [ "$tries" -le 2 ] || return 0            # twice broken by someone else: carry on rather than hang
      rm -rf "$1.lock"                          # what a killed call left behind
      mkdir "$1.lock" 2>/dev/null && return 0   # lost the race: the other caller holds it, so wait again
      start="$(date +%s)"
    fi
    sleep 0.1 2>/dev/null || sleep 1
  done
}

cmd_run_close() {
  local run status home ptr p tok=0 agents=0 line n lg busy=""
  status="${STATUS_ARG:-complete}"
  case "$status" in complete|abandoned|paused) ;; *) die "--status must be complete, abandoned or paused" ;; esac
  run="$(resolve_run)" || exit 2
  if [ -f "$run/seats.tsv" ]; then
    line="$(awk -F'\t' 'NR > 1 && $2 != "skipped" && $2 != "queued" { a += ($7 == "" ? 1 : $7); t += $4 } END { printf "%d %d", a, t }' "$run/seats.tsv")"
    agents="${line%% *}"; tok="${line#* }"
    busy="$(awk -F'\t' 'NR > 1 && ($2 == "running" || $2 == "queued") { printf "%s%s", (n++ ? ", " : ""), $1 }' "$run/seats.tsv")"
  fi
  if [ "$tok" -gt 0 ] 2>/dev/null; then
    RUN_ARG="$run" cmd_state status="$status" closed="$(now_sec)" actual="~$(( (tok + 500) / 1000 ))k tokens across $agents agents" >/dev/null
  else
    RUN_ARG="$run" cmd_state status="$status" closed="$(now_sec)" >/dev/null
  fi
  home="$(council_home)"; ptr="$home/active-run"
  if [ -s "$ptr" ]; then                      # the 0.1/0.2 single pointer: empty it if it names this run
    p="$(head -n 1 "$ptr" | tr -d '\r')"
    case "$p" in /*|[A-Za-z]:*) ;; *) p="$(dirname "$home")/$p" ;; esac
    [ "$p" = "$run" ] && : > "$ptr"
  fi
  if [ "$tok" -gt 0 ] 2>/dev/null; then
    say "closed ${run##*/} — $status · ~$(( (tok + 500) / 1000 ))k tokens across $agents agents"
  else
    say "closed ${run##*/} — $status"
  fi
  if [ -n "$busy" ] && [ "$status" != abandoned ]; then
    printf 'council: seats still marked running or queued: %s — their results will not be collected; wait for them, or record each (council seat <slug> failed or skipped) before closing\n' "$busy" >&2
  fi
  if [ "$status" = complete ]; then
    n="$(ledger_record "$run")"
    [ "${n:-0}" -eq 0 ] 2>/dev/null || say "ledger: $n seat row(s) recorded — council ledger shows each seat's record"
    case "$(field mode "$run/session-state.md")" in       # a deliverable without the user's words can't be post-gamed
      council-review|council-plan|council-implement|council-research|council-postgame)
        [ -n "$(field ask-saved "$run/session-state.md")" ] \
          || printf 'council: no request was filed for this run — council ask save --run %s\n' "${run##*/}" >&2 ;;
    esac
    if [ "$(field mode "$run/session-state.md")" = council-implement ]; then
      # The log whose Run: line names this run — as a name or as the folder's full path, which is what
      # council run open prints; failing that, the first log that mentions it.
      lg="$(grep -lE "Run:[^|]*${run##*/}([^0-9A-Za-z-]|\$)" "$home"/logs/*.md 2>/dev/null | head -n 1)"
      [ -n "$lg" ] || lg="$(grep -lE "(^|[^0-9A-Za-z-])${run##*/}([^0-9A-Za-z-]|\$)" "$home"/logs/*.md 2>/dev/null | head -n 1)"
      if [ -z "$lg" ]; then
        printf 'council: no build log names this run — write %s/logs/<date>-<slug>.md with "Run: %s" and a "## Shortcuts and concessions" section\n' "$home" "${run##*/}" >&2
      elif ! grep -q '^## Shortcuts and concessions' "$lg"; then
        printf 'council: the log has no "## Shortcuts and concessions" section — say what was traded away, or the single word none: %s\n' "$lg" >&2
      fi
    fi
  fi
}

cmd_run_status() {
  local home which runs
  home="$(council_home)"
  [ -d "$home" ] || { say "no council here (no $home) — run council-init"; return 0; }
  # With --all, the newest 20 runs. Otherwise every open run on this tree, first, then other trees'
  # open runs up to 20 lines in all, and a count of the rest.
  if [ "$ALL" = 1 ]; then which=all; runs="$(list_runs "$home" 20 all)"; else which=open; runs="$(list_runs "$home" 1000000 open)"; fi
  if [ -z "$runs" ]; then
    if [ "$which" = open ]; then say "no open council runs"; else say "no council runs yet"; fi
    return 0
  fi
  printf '%s\n' "$runs" | TOP="$(this_tree)" ALL="$ALL" awk -F'\t' '
    {
      n = split($1, p, "/"); here = ($4 == ENVIRON["TOP"] || $4 == "-")
      s = sprintf("%s · %s · phase %s · %s · updated %s · %s", p[n], $2, $3, $6, $5, here ? "here" : "elsewhere: " $4)
      if ($7 != "-") s = s " · " $7
      if (here || ENVIRON["ALL"] == "1") { print s; shown++ } else other[++no] = s
    }
    END {
      room = 20 - shown; if (room < 0) room = 0
      for (i = 1; i <= no && i <= room; i++) print other[i]
      if (no > room) printf "… and %d more open in other working trees\n", no - room
    }'
}

# ------------------------------------------------------------------------------------------------
# Change index
# ------------------------------------------------------------------------------------------------

default_branch() {
  local b
  b="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  if [ -n "$b" ]; then printf '%s\n' "$b"; return 0; fi
  for b in main master trunk develop; do
    if git rev-parse -q --verify "refs/heads/$b" >/dev/null 2>&1; then printf '%s\n' "$b"; return 0; fi
  done
  return 1
}

not_indexed() {
  case "$1" in
    *package-lock.json|*yarn.lock|*pnpm-lock.yaml|*poetry.lock|*Pipfile.lock|*Cargo.lock|*go.sum|*composer.lock|*Gemfile.lock|*.lock) return 0 ;;
    node_modules/*|*/node_modules/*|vendor/*|*/vendor/*|dist/*|*/dist/*|build/*|*/build/*|*.min.js|*.min.css|*.map) return 0 ;;
  esac
  return 1
}

# Text and data files: their hunks are listed, but they have no symbols worth tracing.
no_symbols() {
  case "$1" in
    *.md|*.markdown|*.txt|*.rst|*.adoc|*.json|*.yml|*.yaml|*.toml|*.ini|*.cfg|*.conf|*.csv|*.tsv|*.svg|*.xml|*.html|*.css|*.scss|*.lock|*.env) return 0 ;;
  esac
  return 1
}

is_test_path() {
  case "$1" in
    test/*|tests/*|spec/*|*/test/*|*/tests/*|*/spec/*|*/__tests__/*|*/testing/*|test_*|*/test_*|*_test.*|*.test.*|*.spec.*|*_spec.*|*Test.*|*Tests.*) return 0 ;;
  esac
  return 1
}

# Definition names from diff lines (+/-) and hunk-header context. Heuristic and language-agnostic:
# def/class/func/fn/…, const-arrow functions, Go methods, shell "name() {", and C-style signatures —
# never a bare call.
diff_symbols() {
  awk '
    function add(s) { if (length(s) < 3 || (s in seen) || (s in skip)) return; seen[s] = 1; out = out (out ? " " : "") s; n++ }
    function def(l,   s, p) {
      p = " " l
      if (match(p, /func[ \t]*\([^)]*\)[ \t]*[A-Za-z_][A-Za-z0-9_]*/)) { s = substr(p, RSTART, RLENGTH); sub(/^.*[) \t]/, "", s); return s }
      if (match(p, /[ \t](def|class|function|func|fn|sub|interface|struct|enum|trait|type|module|signal|class_name)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { s = substr(p, RSTART, RLENGTH); sub(/^.*[ \t]/, "", s); return s }
      if (match(p, /[ \t](const|let|var)[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*(async[ \t]*)?(\(|function)/)) { s = substr(p, RSTART, RLENGTH); sub(/^[ \t]*(const|let|var)[ \t]+/, "", s); sub(/[ \t]*=.*$/, "", s); return s }
      if (match(l, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)[ \t]*(\{|$)/)) { s = substr(l, RSTART, RLENGTH); sub(/^[ \t]*/, "", s); sub(/[ \t]*\(.*$/, "", s); return s }
      if (l !~ /^[ \t]/ && l !~ /;[ \t]*$/ && l !~ /^(if|for|while|switch|return|else|do|case|catch|elif)[ \t(]/ && match(l, /^[A-Za-z_][A-Za-z0-9_:<>,*& \t]*[ \t*&][A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)) {
        s = substr(l, RSTART, RLENGTH); sub(/[ \t]*\($/, "", s); sub(/^.*[ \t*&:]/, "", s); return s
      }
      return ""
    }
    BEGIN {
      split("if for while return switch catch else elif function def class self this true false null none nil new try with from import export async await public private protected static void int string bool var let const func fn match case default print main", k, " ")
      for (i in k) skip[k[i]] = 1
    }
    n >= 8 { exit }
    /^@@/ { ctx = $0; sub(/^@@[^@]*@@[ \t]*/, "", ctx); add(def(ctx)); next }
    /^(\+\+\+|---)/ { next }
    /^[-+]/ { add(def(substr($0, 2))) }
    END { print out }'
}

cmd_index() {
  local run top ref base head list body over out st f old label add del hunks diff nums syms sym hits callers tests stem note prior np=0
  local n_files=0 n_skip=0 n_over=0 n_new=0 t_add=0 t_del=0 budget=80 dirty=""
  local cap="${COUNCIL_INDEX_CAP:-80}"                # files indexed in full (the evals lower it to stay quick)
  local namecap="${COUNCIL_INDEX_NAMECAP:-200}"       # past the cap: how many are named one by one
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  cd "$top" 2>/dev/null || die "cannot enter the code root: $top"
  git rev-parse --git-dir >/dev/null 2>&1 || die "the code root is not a git repository — the change index needs git"
  if [ -n "$BASE_ARG" ]; then ref="$BASE_ARG"; else ref="$(default_branch)" || ref="HEAD"; fi
  base="$(git merge-base HEAD "$ref" 2>/dev/null)" || base=""
  [ -n "$base" ] || base="$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null)" || base=""
  [ -n "$base" ] || die "unknown base: $ref"
  head="$(git rev-parse --short HEAD 2>/dev/null)"
  list="$run/.index-files"; body="$run/.index-body"; over="$run/.index-over"; out="$run/index.md"
  # status, path, old path (a rename's, else "-"); names as they are (no \ooo quoting); an untracked
  # folder (a nested repository or worktree) is not a changed file.
  { git -c core.quotePath=false diff -M --name-status "$base" -- . 2>/dev/null \
      | awk -F'\t' '{ s = substr($1, 1, 1); if (s == "R" || s == "C") print s "\t" $3 "\t" $2; else print s "\t" $2 "\t-" }'
    git -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null | awk '!/\/$/ { print "?\t" $0 "\t-" }'
  } | sort -t "$TAB" -k2,2 -u > "$list"
  : > "$body"; : > "$over"
  while IFS="$TAB" read -r st f old; do
    [ -n "$f" ] || continue
    case "$f" in .council/*) continue ;; esac          # the council's own files are never part of a change
    if not_indexed "$f"; then n_skip=$((n_skip + 1)); continue; fi
    case "$st" in
      A) label=added ;; D) label=deleted ;; R) label="renamed from $old" ;; C) label="copied from $old" ;;
      "?") label="new, untracked"; n_new=$((n_new + 1)) ;; *) label=modified ;;
    esac
    if [ "$n_files" -ge "$cap" ]; then                 # past the cap: named, so it still gets an owner
      # Named, so each still gets an owner — but a repo-wide change would put hundreds of KB into a
      # file every seat reads, so past namecap they are counted instead of listed.
      n_over=$((n_over + 1))
      [ "$n_over" -gt "$namecap" ] \
        || printf '## %s  (%s — past the %s-file cap: not indexed)\n' "$f" "$label" "$cap" >> "$over"
      continue
    fi
    n_files=$((n_files + 1))
    if [ "$st" = "?" ]; then
      if [ -s "$f" ] && ! LC_ALL=C grep -qI -e '' "$f" 2>/dev/null; then
        printf '## %s  (%s, binary)\n\n' "$f" "$label" >> "$body"; continue
      fi
      add="$(awk 'END { print NR }' "$f" 2>/dev/null)"; del=0
      hunks="1-${add:-0}"; diff="$(head -n 400 "$f" 2>/dev/null | sed 's/^/+/')"
    else
      if [ "$st" = R ] || [ "$st" = C ]; then set -- "$old" "$f"; else set -- "$f"; fi   # both paths, so git pairs them
      nums="$(git diff -M --numstat "$base" -- "$@" 2>/dev/null | head -n 1)"
      add="$(printf '%s' "$nums" | cut -f1)"; del="$(printf '%s' "$nums" | cut -f2)"
      if [ "$add" = "-" ]; then printf '## %s  (%s, binary)\n\n' "$f" "$label" >> "$body"; continue; fi
      diff="$(git diff -M -U0 "$base" -- "$@" 2>/dev/null)"
      hunks="$(printf '%s\n' "$diff" | awk '
        /^@@/ {
          if (match($0, /\+[0-9]+(,[0-9]+)?/)) {
            s = substr($0, RSTART + 1, RLENGTH - 1); c = split(s, a, ","); b = a[1] + 0; k = (c > 1 ? a[2] + 0 : 1)
            r = (k == 0 ? "removed near " b : (k == 1 ? b : b "-" (b + k - 1)))
            out = out (out ? ", " : "") r
          }
        }
        END { print out }')"
    fi
    syms=""; callers=""; tests=""; note=""
    if ! no_symbols "$f"; then
      syms="$(printf '%s\n' "$diff" | diff_symbols)"
      for sym in $syms; do
        if [ "$budget" -le 0 ]; then note="callers and tests not searched (search budget spent)"; break; fi
        budget=$((budget - 1))
        hits="$(git grep -n -I -w -F -e "$sym" -- . ":(exclude)$f" 2>/dev/null | grep -v '^\.council/' | head -n 4 \
          | awk -F: -v s="$sym" '{ printf "%s%s:%s (%s)", (NR > 1 ? " · " : ""), $1, $2, s }')"
        [ -n "$hits" ] && callers="$callers${callers:+ · }$hits"
      done
      stem="${f##*/}"; stem="${stem%.*}"
      if is_test_path "$f"; then
        tests="(this is a test file)"
      elif [ "${#stem}" -ge 3 ] && [ -z "$note" ]; then
        if [ "$budget" -gt 0 ]; then
          budget=$((budget - 1))
          tests="$(git grep -l -I -w -F -e "$stem" -- ':(glob)**/test/**' ':(glob)**/tests/**' ':(glob)**/spec/**' \
            ':(glob)**/__tests__/**' ':(glob)**/test_*' ':(glob)**/*_test.*' ':(glob)**/*.test.*' ':(glob)**/*.spec.*' \
            ':(glob)**/*_spec.*' ':(glob)**/*Test.*' ":(exclude)$f" 2>/dev/null | head -n 4 | paste -sd ',' - | sed 's/,/, /g')"
        else
          note="callers and tests not searched (search budget spent)"
        fi
      fi
    fi
    {
      printf '## %s  (%s, +%s/-%s)\n' "$f" "$label" "${add:-0}" "${del:-0}"
      printf -- '- hunks: %s\n' "${hunks:--}"
      [ -z "$syms" ]    || printf -- '- symbols: %s\n' "$(printf '%s' "$syms" | sed 's/ /, /g')"
      [ -z "$callers" ] || printf -- '- callers: %s\n' "$callers"
      [ -z "$tests" ]   || printf -- '- tests: %s\n' "$tests"
      [ -z "$note" ]    || printf -- '- note: %s\n' "$note"
      printf '\n'
    } >> "$body"
    case "$add" in ''|*[!0-9]*) ;; *) t_add=$((t_add + add)) ;; esac
    case "$del" in ''|*[!0-9]*) ;; *) t_del=$((t_del + del)) ;; esac
  done < "$list"
  # Uncommitted: staged or unstaged edits to tracked files, or new files in the change.
  if [ "$n_new" -gt 0 ] || [ -n "$(git --no-optional-locks status --porcelain --untracked-files=no 2>/dev/null | head -n 1)" ]; then
    dirty=" + uncommitted changes"
  fi
  {
    printf '# Change index — %s\n' "${run##*/}"
    printf 'base: %s (%s) · head: %s%s · generated: %s\n' "$(git rev-parse --short "$base")" "$ref" "$head" "$dirty" "$(now_sec)"
    printf 'files: %d (+%d/-%d)' "$n_files" "$t_add" "$t_del"
    [ "$n_over" -eq 0 ] || printf ' · past the %s-file cap: %d (named at the end, not indexed — they still need an owner)' "$cap" "$n_over"
    [ "$n_skip" -eq 0 ] || printf ' · not indexed: %d (lockfiles, vendored or generated files)' "$n_skip"
    printf '\nSymbols come from definitions in the diff; callers and tests are matched by name (git grep) —\na starting point for tracing, not proof.\n\n'
    cat "$body"
    if [ "$n_over" -gt 0 ]; then
      printf '## Past the %s-file cap — %d more changed files, named but not indexed; each still needs an owner\n' "$cap" "$n_over"
      cat "$over"
      [ "$n_over" -le "$namecap" ] \
        || printf '## … and %d more, not named one by one: git diff --name-only %s\n' "$((n_over - namecap))" "$(git rev-parse --short "$base")"
      printf '\n'
    fi
  } > "$out"
  rm -f "$list" "$body" "$over"
  prior=""
  if [ "$(field mode "$run/session-state.md")" = council-postgame ]; then
    # A post-game's verifier reads index.md and must never see the plan, the logs or their verdicts;
    # its Chair runs `council prior` for itself.
    say "index: earlier council work left out (a post-game's verifier reads this file) — run council prior yourself"
  else
    prior="$(index_paths "$run" | prior_hits "$(council_home)" | head -n 40)"
  fi
  if [ -n "$prior" ]; then
    np="$(printf '%s\n' "$prior" | grep -c .)"
    { printf '## Earlier council work on these files\n'
      printf '%s\n' "$prior" | awk -F'\t' '{ printf "- %s — %s — %s\n", $1, $2, $3 }'; } >> "$out"
  fi
  RUN_ARG="$run" cmd_state base="$base" >/dev/null
  if [ "$n_files" -eq 0 ]; then
    say "index: nothing changed since $(git rev-parse --short "$base") ($ref) → $out"
  else
    say "index: $n_files files (+$t_add/-$t_del) → $out"
  fi
  [ "$n_over" -eq 0 ] || say "index: $n_over more past the $cap-file cap — named at the end of the index but not indexed; give them an owner too"
  [ "$np" -eq 0 ] || say "earlier council work on these files: $np mention(s), listed at the end of the index"
}

# ------------------------------------------------------------------------------------------------
# Gates
# ------------------------------------------------------------------------------------------------

# The config's Gates table as tab-separated rows: name command run-at mandatory cell-count checked
# side-effects needs header-cell-count has-side-effects-column, then the three small vocabularies, read
# once, here: stages (g, v, gv; m = by name only; - = an empty cell; a ? is added for a word that names
# no stage) · mandatory (yes, no, ?) · checked (ok, not, ?). Case, markdown bold and punctuation don't
# matter; for Mandatory and Checked the first word that decides wins and the rest of the cell is a note.
# Columns are found by their header names (case, spaces and dashes ignored), so an older table (no Side
# effects or Needs) still reads. Cells split on "|" outside backticks and unescaped, so a quoted pipe
# can't shift the columns.
config_gates() {
  [ -f "$1" ] || return 0
  awk '
    function cells(line, out,    i, c, cur, inq, n) {
      n = 0; cur = ""; inq = 0
      for (i = 1; i <= length(line); i++) {
        c = substr(line, i, 1)
        if (c == "\\" && substr(line, i + 1, 1) == "|") { cur = cur "|"; i++; continue }
        if (c == "`") inq = !inq
        if (c == "|" && !inq) { out[++n] = cur; cur = ""; continue }
        cur = cur c
      }
      out[++n] = cur
      return n
    }
    function trim(s) { gsub(/\t/, " ", s); gsub(/^[ \r]+|[ \r]+$/, "", s); return s }
    function dash(s) { return s == "" ? "-" : s }
    function words(s, w) {
      s = tolower(s); gsub(/✓|✔|✅|☑/, " yes ", s); gsub(/✗|✘|❌|×/, " no ", s)
      gsub(/·|→|›|»|–|—|\302\240/, " ", s)              # separators and a non-breaking space
      gsub(/[]*_`()[,;\/+&:.!?"]/, " ", s)
      return split(s, w, /[ \t]+/)
    }
    function stages(s,    w, n, i, g, v, m, bad) {
      gsub(/\([^)]*\)/, " ", s)                         # a note in brackets is a note: "verify (phase 10)"
      n = words(s, w)
      for (i = 1; i <= n; i++) {
        if (w[i] == "" || w[i] ~ /^(and|or|only|by|on|at|stage|stages|-)$/) continue
        if (w[i] ~ /^(grounding|baseline)$/) g = 1
        else if (w[i] ~ /^(verify|verification)$/) v = 1
        else if (w[i] ~ /^(both|all|always|every)$/) g = v = 1
        else if (w[i] ~ /^(manual|manually|never|none|no|name|hand|demand)$/) m = 1
        else bad = 1
      }
      s = (g ? "g" : "") (v ? "v" : "") (bad ? "?" : ((!g && !v && m) ? "m" : ""))
      return s == "" ? "-" : s
    }
    function mandatory(s,    w, n, i) {
      n = words(s, w)
      for (i = 1; i <= n; i++) {
        if (w[i] ~ /^(yes|y|true|mandatory|required|require|must|always|blocking|blocks|blocker|1)$/) return "yes"
        if (w[i] ~ /^(no|n|false|not|optional|advisory|never|informational|0)$/) return "no"
        if (w[i] ~ /^(non|not)-(blocking|blocker|mandatory|required|require|must|gating)$/) return "no"
      }
      return "?"
    }
    function checked(s,    w, n, i, d) {
      n = words(s, w)
      for (i = 1; i <= n; i++) {
        if (w[i] ~ /^(yes|y|true|ok|okay|pass|passed|passes|passing|green|probed|checked|verified|runs|ran|works|runnable)$/) return "ok"
        if (w[i] ~ /^(no|n|false|not|never|fails|failed|failing|broken|blocked|skip|skipped|unrunnable|unprobed)$/) return "not"
        if (w[i] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) d = 1     # a bare date: when it was checked
      }
      return d ? "ok" : "?"
    }
    /^## / { ing = ($0 ~ /^## Gates/); hdr = 0; next }
    ing && /^\|/ {
      split("", f); k = cells($0, f)
      if (!hdr) {                                   # the header row names the columns; it is never a gate
        hdr = 1; hk = k; cg = 2; cc = 3; ca = 4; cm = 5; ck = 6; cs = 0; cn = 0
        for (i = 2; i < k; i++) {
          h = tolower(trim(f[i])); gsub(/[^a-z]/, "", h)
          if (h == "gate" || h == "name") cg = i; else if (h == "command") cc = i; else if (h == "runat") ca = i
          else if (h == "mandatory") cm = i; else if (h == "checked") ck = i
          else if (h ~ /^sideeffects?/) cs = i; else if (h ~ /^needs/) cn = i
        }
        next
      }
      name = trim(f[cg]); cmd = trim(f[cc]); at = trim(f[ca]); mand = trim(f[cm]); chk = trim(f[ck])
      side = cs ? trim(f[cs]) : ""; needs = cn ? trim(f[cn]) : ""
      gsub(/`/, "", cmd)
      if (name == "" || name ~ /^:?-+:?$/ || name ~ /^</) next
      if (cmd == "" || cmd ~ /^</) next
      print name "\t" cmd "\t" dash(at) "\t" dash(mand) "\t" k "\t" dash(chk) "\t" dash(side) "\t" dash(needs) "\t" hk "\t" (cs ? 1 : 0) \
        "\t" stages(at) "\t" mandatory(mand) "\t" checked(chk)
    }' "$1"
}

# A Gates section still written as a list (the layout before the table): a backticked command in a list
# item — "- `pytest`", "- **Tests:** `pytest`", "- tests: `pytest`" — or on an indented line under one,
# and no table. Only list items count, and a backticked council command is a note, not a gate, so the
# template's own HTML comment, prose, or "fit them later with a `council-init` refresh" is not mistaken
# for a layout to migrate.
gates_listed() {
  awk '
    function cmd(l) { return l ~ /`[^`]+`/ && l !~ /`council[ -]/ }
    /^## / { g = ($0 ~ /^## Gates/); li = 0; next }
    !g { next }
    /^[ \t]*<!--/ { cm = 1 } cm { if (/-->/) cm = 0; next }
    /^\|/ { t = 1; li = 0; next }
    /^[ \t]*([-*+]|[0-9]+[.)])[ \t]/ { li = 1; if (cmd($0)) c = 1; next }
    /^[ \t]*$/ { next }
    /^[ \t]/ { if (li && cmd($0)) c = 1; next }          # a line under a list item
    { li = 0 }
    END { exit !(c && !t) }' "$1" 2>/dev/null
}

# A backslash outside quotes before a letter or digit: bash drops it, so tools\run.ps1 reaches the tool
# as toolsrun.ps1.
gate_backslash() {
  C="$1" awk 'BEGIN {
    s = ENVIRON["C"]; sq = sprintf("%c", 39); q = ""
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (q == sq) { if (c == sq) q = ""; continue }
      if (c == "\\") { if (q == "" && substr(s, i + 1, 1) ~ /[A-Za-z0-9_]/) exit 0; i++; continue }
      if (q == "\"") { if (c == "\"") q = ""; continue }
      if (c == sq || c == "\"") q = c
    }
    exit 1 }'
}
backslash_note() { printf '%s' 'has a backslash outside quotes, which bash drops (tools\run.ps1 reaches the tool as toolsrun.ps1) — write paths with /, or put them in quotes'; }

# A word that starts with one / and reads as a Windows switch (/p:Name=Value, /t:Build, /nologo). Git Bash
# turns it into a path before a Windows tool sees it, quoted or not; only cmd's /c and /k are rewritten.
gate_winswitch() {
  C="$1" awk 'BEGIN {
    s = ENVIRON["C"]; prev = " "
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1); rest = substr(s, i + 1)
      if (c == "/" && prev ~ /[ \t"\047=]/ && (rest ~ /^[A-Za-z][A-Za-z0-9_-]*:([^\/]|$)/ || rest ~ /^nologo([^A-Za-z0-9_-]|$)/)) exit 0
      prev = c
    }
    exit 1 }'
}
winswitch_note() { printf '%s' 'has a Windows switch such as /p:… that Git Bash on Windows turns into a path (/p:Configuration=Release reaches the tool as p:Configuration=Release) — write -p:… where the tool takes it (msbuild and dotnet do), else //p:…'; }

# A gate name as the user would type it back: quoted when it holds a space or anything unusual.
qname() { case "$1" in *[!A-Za-z0-9._-]*) printf '"%s"' "$1" ;; *) printf '%s' "$1" ;; esac; }

cmd_gates() {
  local cfg gates name cmd at mand rest side
  cfg="$(council_home)/council.config.md"
  gates="$(config_gates "$cfg")"
  if [ -z "$gates" ]; then
    if gates_listed "$cfg"; then
      say "the Gates section of $cfg is in an older layout (a list, not a table), so no gate can run — a council-init refresh migrates it"
    else
      say "no gates in $cfg"
    fi
    return 0
  fi
  while IFS="$TAB" read -r name cmd at mand rest rest side rest; do
    [ -n "$name" ] || continue
    printf '%s · %s · run at: %s · mandatory: %s' "$name" "$cmd" "$at" "$mand"
    [ "$side" = "-" ] || printf ' · side effects: %s' "$side"
    if gate_backslash "$cmd"; then printf ' · note: the command %s' "$(backslash_note)"; fi
    if gate_winswitch "$cmd"; then printf ' · note: the command %s' "$(winswitch_note)"; fi
    printf '\n'
  done <<GATES
$gates
GATES
}

# May `gate --all` run this gate unasked? Only if the table has a Side effects column, every side effect
# is on the safe list (none, writes the tree, network) and Needs names no credentials or hardware.
# Anything unlisted or unrecorded runs by name only — and so does every gate of an older table, which
# records nothing about what its gates do: a command's wording is no evidence that it is safe.
gate_safe() {
  local side="$1" needs="$2" hascol="$3" item
  case "$(printf '%s' "$needs" | tr 'A-Z' 'a-z')" in
    *credential*|*secret*|*token*|*password*|*api?key*|*apikey*|*hardware*|*device*) return 1 ;;
  esac
  [ "$hascol" = 1 ] || return 1
  [ "$side" != "-" ] || return 1
  while IFS= read -r item; do
    case "$(printf '%s' "$item" | tr 'A-Z' 'a-z')" in
      none|"writes the tree"|"writes files"|network|-|—) ;;
      *) return 1 ;;
    esac
  done <<ITEMS
$(split_list "$side")
ITEMS
  return 0
}

gate_base() { printf '%s/gates/%s' "$1" "$(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '_')"; }

# The failing tests a runner's output names, one id per line, in the order they appear and without
# repeats: pytest (FAILED x::y, x::y FAILED), go (--- FAIL: Name), unittest (FAIL: test_x), node --test
# and jest/vitest (✖ name, ✕ name), TAP (not ok 3 - name), cargo (test x ... FAILED). Run times are
# dropped, so the same failure reads the same in two runs; a summary count line names no test and is
# ignored, which is why a whole-line comparison could not be trusted.
failure_ids() {
  awk '
    function norm(s) {
      sub(/[ \t]*\([0-9][0-9.,]*[ \t]*(ms|s|sec|secs|seconds)\)[ \t]*$/, "", s)
      sub(/[ \t]+-[ \t].*$/, "", s)                     # pytest appends " - AssertionError: …"
      gsub(/^[ \t\[]+|[ \t,.:;\]]+$/, "", s)
      return s
    }
    function emit(s) { s = norm(s); if (s != "" && !(s in seen)) { seen[s] = 1; print s } }
    {
      l = $0; gsub(/\r/, "", l); gsub(/\033\[[0-9;]*[A-Za-z]/, "", l)
      if (match(l, /^[ \t]*(FAILED|ERROR)[ \t]+[^ \t]/))            { emit(substr(l, RSTART + RLENGTH - 1)); next }
      if (match(l, /^[ \t]*---[ \t]+(FAIL|ERROR):[ \t]+[^ \t]/))    { emit(substr(l, RSTART + RLENGTH - 1)); next }
      if (match(l, /^[ \t]*(FAIL|ERROR):[ \t]+[^ \t]/))             { emit(substr(l, RSTART + RLENGTH - 1)); next }
      if (match(l, /^[ \t]*(✖|✗|✕|×|❌)[ \t]+[^ \t]/))               { emit(substr(l, RSTART + RLENGTH - 1)); next }
      if (match(l, /^[ \t]*not ok[ \t]+[0-9]+[ \t]*-?[ \t]*/))      { emit(substr(l, RSTART + RLENGTH)); next }
      if (match(l, /^[ \t]*test[ \t]+[^ \t]+[ \t]+\.\.\.[ \t]+(FAILED|failed)/)) { emit($2); next }
      if (match(l, /^[ \t]*[^ \t]+[ \t]+FAILED([ \t]|$)/))          { emit($1); next }
      if (match(l, /^[ \t]*FAIL[ \t]+[^ \t]/))                      { emit(substr(l, RSTART + RLENGTH - 1)); next }
    }' "$1" 2>/dev/null
}

# cmd.exe that never got its /c switch prints its version banner, then a prompt, and exits 0 — a green
# gate for a command that never ran. Its whole output is that banner and a trailing prompt.
cmd_never_ran() {
  [ -s "$1" ] || return 1
  head -n 1 "$1" | grep -q '^Microsoft Windows \[Version' || return 1
  tail -n 1 "$1" | tr -d '\r' | grep -q '>[ ]*$'
}

# Run one gate; full output to <run>/gates/<name>.txt, the verdict to <name>.json. Returns its exit code.
# In a baseline set (GATE_BASELINE=1) a gate's first output is also kept as gates/baseline/<name>.txt,
# so a later failure can be told apart from one the untouched code already had.
run_gate() {
  local run="$1" name="$2" cmd="$3" top="$4" base out start ec secs hits bl pat fresh=0 rcmd never=0 nnote=""
  GATE_EMPTY=0
  base="$(gate_base "$run" "$name")"; out="$base.txt"; bl="$run/gates/baseline/${base##*/}"
  pat='error|fail|exception|traceback|assert|panic|cannot|not found|undefined'
  mkdir -p "$run/gates"
  # On Git Bash a lone /c is turned into a drive path before cmd sees it, so cmd opens a prompt, reads
  # end-of-input and exits 0 without running anything. Written //c it survives as /c, so that is how
  # the command is run. Nothing else in the command is touched: a /c/… path a Windows tool is given
  # (python "$PWD/x.py") still has to be converted.
  rcmd="$cmd"
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      rcmd="$(printf '%s' "$cmd" \
        | sed -E 's#(^|[[:space:];&|(])([cC][mM][dD](\.[eE][xX][eE])?)([[:space:]]+)/([cCkK])([[:space:]]|$)#\1\2\4//\5\6#g')" ;;
  esac
  start="$(date +%s)"
  ( cd "$top" 2>/dev/null || exit 97; bash -c "$rcmd" < /dev/null ) > "$out" 2>&1
  ec=$?
  secs=$(( $(date +%s) - start ))
  if [ "$ec" -eq 0 ] && cmd_never_ran "$out"; then   # a prompt and a banner: the command never ran
    ec=1; never=1; nnote=', "note": "cmd opened its prompt and ran nothing"'
  fi
  printf '{"gate": "%s", "command": "%s", "exit": %d, "seconds": %d, "when": "%s"%s}\n' \
    "$(json_esc "$name")" "$(json_esc "$cmd")" "$ec" "$secs" "$(now_sec)" "$nnote" > "$base.json"
  if [ "${GATE_BASELINE:-0}" = 1 ] && [ ! -f "$bl.txt" ]; then
    mkdir -p "$run/gates/baseline" && cp "$out" "$bl.txt" && cp "$base.json" "$bl.json" && fresh=1
  fi
  if [ "$ec" -eq 0 ]; then
    if grep -q '^changed: no files matched' "$out" 2>/dev/null; then
      GATE_EMPTY=1                    # it passed because there was nothing to look at, not because it looked
      say "gate $name: pass — but nothing to check (0 files matched)"
    else
      say "gate $name: pass (exit 0, ${secs}s)"
    fi
    return 0
  fi
  [ "$ec" -ne 97 ] || say "gate $name: could not enter the code root: $top"
  if [ "$never" = 1 ]; then
    say "gate $name: FAIL — cmd opened its prompt and ran nothing (${secs}s): write its switch as //c, e.g. cmd //c \"<command>\" — full output: $out"
  else
    say "gate $name: FAIL (exit $ec, ${secs}s) — full output: $out"
  fi
  hits="$(grep -n -i -E "$pat" "$out" 2>/dev/null | head -n 12)"
  [ -n "$hits" ] || hits="$(tail -n 8 "$out")"
  printf '%s\n' "$hits" | clip 220 | sed 's/^/    /'
  if [ "$fresh" = 0 ] && [ -f "$bl.txt" ]; then   # it may have been red before the change too: say what is new
    failure_ids "$bl.txt" > "$base.seen"; failure_ids "$out" > "$base.now"
    if [ -s "$base.now" ] && [ -s "$base.seen" ]; then
      hits="$(grep -v -x -F -f "$base.seen" "$base.now" | head -n 12)"
      if [ -n "$hits" ]; then
        say "    failing now and not at the baseline (gates/baseline/${bl##*/}.txt):"
        printf '%s\n' "$hits" | clip 220 | sed 's/^/      /'
      else
        say "    the same test(s) are failing as at the baseline (gates/baseline/${bl##*/}.txt) — no new one is named"
      fi
    elif [ -s "$base.now" ]; then
      say "    the baseline's output names no failing test, so nothing can be compared — read gates/baseline/${bl##*/}.txt next to this one yourself"
    else
      say "    this output names no failing test, so nothing can be compared — read it next to gates/baseline/${bl##*/}.txt yourself"
    fi
    rm -f "$base.seen" "$base.now"
  fi
  return "$ec"
}

# One gate left out of `gate --all`: said, counted, and named if it was required (cmd_gate's locals).
skip_gate() {
  say "gate $name: skipped — $1"
  skipped=$((skipped + 1)); [ "$ismand" -eq 0 ] || { skipm=$((skipm + 1)); reds="${reds:+$reds, }$name"; }
}

cmd_gate() {
  local run top cfg name cmd at mand k chk side needs hk hascol stg ism ckd extra row ran=0 skipped=0 failed=0 gates \
        passed=0 nfail=0 red="" tail="" ismand=0 skipm=0 reds="" empty=0 noth="" atl="" old=0 GATE_BASELINE=0
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  cfg="$(council_home)/council.config.md"
  if [ "$ALL" = 1 ]; then
    if [ -n "$AT_ARG" ]; then
      case "$(printf '%s' "$AT_ARG" | tr 'A-Z' 'a-z')" in
        grounding) atl=g; AT_ARG=grounding ;;
        verify|verification) atl=v; AT_ARG=verify ;;
        *) die "--at takes grounding or verify (got '$AT_ARG')" ;;
      esac
    fi
    [ "$atl" = v ] || GATE_BASELINE=1    # the untouched code: each gate's first output is its baseline
    gates="$(config_gates "$cfg")"
    if [ -z "$gates" ]; then      # a green report with nothing behind it is the worst outcome there is
      if gates_listed "$cfg"; then
        say "NOTHING WAS CHECKED — the Gates section of $cfg is in an older layout (a list, not a table), so no gate could be read; a council-init refresh migrates it"
      else
        say "NOTHING WAS CHECKED — this project has no automated check configured (no Gates row in $cfg)"
      fi
      return 4
    fi
    while IFS="$TAB" read -r name cmd at mand k chk side needs hk hascol stg ism ckd; do
      [ -n "$name" ] || continue
      ismand=0
      if [ "$k" != "$hk" ]; then     # before the --at filter: a shifted row's Run-at cell means nothing
        skip_gate "its row has $k cells where the header has $hk (an unescaped | ?); fix the row"
        continue
      fi
      [ "$ism" = no ] || ismand=1      # a Mandatory word nobody can read counts as yes
      if [ -n "$atl" ]; then
        case "$stg" in
          *"$atl"*) ;;
          -)                          # no stage at all: it runs in no set, which must never be silent
            skip_gate "its Run at cell is empty, so it runs only by name; fill it in (grounding, verify)"
            continue ;;
          *'?'*)
            skip_gate "its Run at cell says '$at', which names no stage here; write grounding, verify, both or manual"
            continue ;;
          m)
            [ "$ismand" -eq 0 ] || skip_gate "its Run at cell says '$at', so it runs only by name: council gate $(qname "$name")"
            continue ;;
          *) continue ;;              # it belongs to another stage: ordinary, and not this run's business
        esac
      elif [ "$stg" = m ]; then
        [ "$ismand" -eq 0 ] || skip_gate "its Run at cell says '$at', so it runs only by name: council gate $(qname "$name")"
        continue
      fi
      [ "$ism" != '?' ] || say "note: gate $name — its Mandatory cell says '$mand', which isn't yes or no, so it counts as mandatory; write yes or no"
      case "$ckd" in
        not) skip_gate "the config marks it not runnable here ($chk)"; continue ;;
        '?') say "note: gate $name — its Checked cell says '$chk', which isn't ✓ or ✗; running it anyway (write ✓ <date> once it runs cleanly here, or ✗ <why> if it can't)" ;;
      esac
      if ! gate_safe "$side" "$needs" "$hascol"; then
        extra=""; [ "$needs" = "-" ] || extra=" · needs: $needs"
        if [ "$hascol" != 1 ]; then
          old=1
          skip_gate "the Gates table has no Side effects column (an older layout), so nothing says it is safe to run unasked. Run it by name once the user agrees: council gate $(qname "$name")"
        elif [ "$side" = "-" ]; then
          skip_gate "side effects not recorded. Fill the cell, or run it by name once the user agrees: council gate $(qname "$name")"
        else
          skip_gate "side effects: $side$extra. Run it by name once the user agrees: council gate $(qname "$name")"
        fi
        continue
      fi
      if gate_backslash "$cmd"; then say "note: gate $name — its command $(backslash_note)"; fi
      if gate_winswitch "$cmd"; then say "note: gate $name — its command $(winswitch_note)"; fi
      ran=$((ran + 1))
      if run_gate "$run" "$name" "$cmd" "$top"; then
        passed=$((passed + 1))
        [ "$GATE_EMPTY" != 1 ] || { empty=$((empty + 1)); noth="${noth:+$noth, }$name"; }
      else
        red="${red:+$red, }$name"       # already delimited: a gate name may contain spaces
        [ "$ismand" -eq 0 ] || failed=1
      fi
    done <<GATES
$gates
GATES
    if [ "$ran" -eq 0 ]; then
      if [ "$old" = 1 ]; then
        say "NOTHING WAS CHECKED — the Gates table in $cfg has no Side effects column (an older layout), so no gate runs unasked; a council-init refresh adds it, or run a gate by name once the user agrees"
      elif [ "$skipped" -eq 0 ]; then
        say "NOTHING WAS CHECKED — no gate in $cfg runs${AT_ARG:+ at '$AT_ARG'}"
      else
        say "NOTHING WAS CHECKED — $skipped gate(s) could not run here${AT_ARG:+ at '$AT_ARG'}; see the reasons above"
      fi
      return 4
    fi
    nfail=$((ran - passed))
    if [ "$skipped" -gt 0 ]; then
      tail=" · $skipped skipped"
      [ "$skipm" -eq 0 ] || tail="$tail ($skipm of them required: $reds — so this run proves less than it looks)"
    fi
    [ "$empty" -eq 0 ] || tail="$tail · $empty had nothing to check ($noth — 0 files matched)"
    if [ "$nfail" -eq 0 ]; then
      say "gates: $ran ran — all pass$tail"
    else
      if [ "$failed" -eq 1 ]; then say "gates: $ran ran — $passed pass, $nfail FAIL ($red — mandatory)$tail"
      else say "gates: $ran ran — $passed pass, $nfail FAIL ($red, not mandatory)$tail"; fi
    fi
    [ "$failed" -eq 0 ] || say "a mandatory gate failed"
    return "$failed"
  fi
  name="${1+$*}"                      # a name with a space may arrive as several words
  [ -n "$name" ] || die "usage: council gate <name> [-- '<command>']   |   council gate --all [--at grounding|verify]"
  cmd="$GATE_CMD"
  if [ -z "$cmd" ]; then
    row="$(config_gates "$cfg" | NAME="$name" awk -F'\t' '$1 == ENVIRON["NAME"] { print; exit }')"
    [ -n "$row" ] || die "no gate named '$name' in council.config.md — pass the command after --"
    cmd="$(printf '%s' "$row" | cut -f2)"; chk="$(printf '%s' "$row" | cut -f6)"; side="$(printf '%s' "$row" | cut -f7)"
    needs="$(printf '%s' "$row" | cut -f8)"; hascol="$(printf '%s' "$row" | cut -f10)"; ckd="$(printf '%s' "$row" | cut -f13)"
    [ "$ckd" != not ] || say "note: the config marks this gate not runnable here ($chk)"
    if ! gate_safe "$side" "$needs" "$hascol"; then
      extra=""; [ "$needs" = "-" ] || extra=" · needs: $needs"
      if [ "$hascol" != 1 ]; then
        say "note: the Gates table has no Side effects column, so this gate's side effects are unknown$extra — run it only with the user's go-ahead"
      elif [ "$side" = "-" ]; then
        say "note: this gate's side effects aren't recorded$extra — run it only with the user's go-ahead"
      else
        say "note: this gate has side effects ($side)$extra — run it only with the user's go-ahead"
      fi
    fi
  fi
  case "$cmd" in *'|'*) say "note: this gate command contains a pipe — its exit code may not be the test runner's" ;; esac
  if gate_backslash "$cmd"; then say "note: this gate command $(backslash_note)"; fi
  if gate_winswitch "$cmd"; then say "note: this gate command $(winswitch_note)"; fi
  run_gate "$run" "$name" "$cmd" "$top"
}

# ------------------------------------------------------------------------------------------------
# Changed files — so a newly fitted check judges only what this change touched
# ------------------------------------------------------------------------------------------------

# council changed [--base <ref>] [--glob '<pattern>' …] [--each] [-- <command> …]
# The files this change touches: committed on this branch since <base>, staged, unstaged, and new
# files git doesn't track yet. With no command it lists them. With one it runs the command over them
# and exits 0 when nothing matched — so a linter fitted to an old project is green on day one and can
# only ever get stricter, instead of printing a thousand complaints about code that was already there.
# --each runs the command once per file, for tools that only read their first argument (bash -n).
# Patterns are git pathspecs, which know no {a,b}: '*.{js,jsx}' is read as '*.js' and '*.jsx'.

# One pattern per line, its first {a,b} group (and the ones after it) spelled out.
glob_expand() {
  local g="$1" pre rest body post item
  case "$g" in *'{'*','*'}'*) ;; *) printf '%s\n' "$g"; return 0 ;; esac
  pre="${g%%\{*}"; rest="${g#*\{}"; body="${rest%%\}*}"; post="${rest#*\}}"
  case "$body" in *,*) ;; *) printf '%s\n' "$g"; return 0 ;; esac
  case "$body" in *'{'*) printf '%s\n' "$g"; return 0 ;; esac       # nested groups stay as written
  while [ -n "$body" ]; do
    item="${body%%,*}"
    glob_expand "$pre$item$post"
    case "$body" in *,*) body="${body#*,}"; [ -n "$body" ] || glob_expand "$pre$post" ;; *) body="" ;; esac
  done
}

cmd_changed() {
  local top ref base each=0 f g worst=0 st len=0 cap alive=0
  local -a globs files chunk
  globs=(); files=(); chunk=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --glob|--glob=*)
        if [ "$1" = --glob ]; then [ $# -ge 2 ] || die "--glob needs a pattern"; g="$2"; shift; else g="${1#--glob=}"; fi
        shift
        while IFS= read -r f; do globs+=("$f"); done <<GLOBS
$(glob_expand "$g")
GLOBS
        ;;
      --each)   each=1; shift ;;
      *) die "usage: council changed [--base <ref>] [--glob '<pattern>'] [--each] -- <command> …" ;;
    esac
  done
  top="${CODE_ROOT_ARG:-$(this_tree)}"
  cd "$top" 2>/dev/null || die "cannot enter the code root: $top"
  git rev-parse --git-dir >/dev/null 2>&1 || die "council changed needs a git repository"
  if [ "${#globs[@]}" -gt 0 ]; then            # a pattern nothing in the project matches could only ever pass
    for g in "${globs[@]}"; do
      if [ -n "$(git -c core.quotePath=false ls-files -- "$g" 2>/dev/null | head -n 1)" ] \
         || [ -n "$(git -c core.quotePath=false ls-files -o --exclude-standard -- "$g" 2>/dev/null | head -n 1)" ]; then
        alive=1; break
      fi
    done
    [ "$alive" = 1 ] || die "the --glob pattern(s) $(printf "'%s' " "${globs[@]}")match no file in this project, so this check could never look at anything — fix the --glob (a git pathspec: case matters, and a pattern with a / in it is anchored at the repo root, so 'src/*.py' covers every folder under a top-level src/ but not web/src/)"
  fi
  if [ -n "$BASE_ARG" ]; then
    ref="$BASE_ARG"
    base="$(git merge-base HEAD "$ref" 2>/dev/null)" \
      || base="$(git rev-parse -q --verify "$ref^{commit}" 2>/dev/null)" \
      || die "council changed: '$ref' is not a ref in this repository — the committed half of the change would be skipped in silence"
  else
    ref="$(default_branch)" || ref="HEAD"
    base="$(git merge-base HEAD "$ref" 2>/dev/null)" || base=""
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in '"'*) f="$(printf '%s' "$f" | sed 's/^"//; s/"$//')" ;; esac   # git quotes odd names
    case "$f" in .council/*) continue ;; esac     # the council's own files are never part of a change (as in the index)
    [ -f "$f" ] || continue                       # deleted, or renamed away: there is nothing to check
    case "$f" in -*) f="./$f" ;; esac             # -v.py is a file, never an option
    files+=("$f")
  done <<FILES
$( { [ -z "$base" ] || git -c core.quotePath=false diff --name-only --diff-filter=ACMR "$base"...HEAD -- ${globs[@]+"${globs[@]}"} 2>/dev/null
     git -c core.quotePath=false diff --name-only --diff-filter=ACMR HEAD -- ${globs[@]+"${globs[@]}"} 2>/dev/null
     git -c core.quotePath=false ls-files -o --exclude-standard -- ${globs[@]+"${globs[@]}"} 2>/dev/null; } | sort -u )
FILES
  if [ "${#files[@]}" -eq 0 ]; then
    say "changed: no files matched — nothing to check (this is a pass, not a skip)"
    return 0
  fi
  if [ "${#AFTER_DD[@]}" -eq 0 ]; then printf '%s\n' "${files[@]}"; return 0; fi
  printf 'changed: %s file(s) to check\n' "${#files[@]}" >&2
  if [ "$each" = 1 ]; then
    for f in "${files[@]}"; do
      "${AFTER_DD[@]}" "$f" || { st=$?; [ "$st" -le "$worst" ] || worst="$st"; }
    done
    return "$worst"
  fi
  # A Windows .cmd tool (eslint.cmd, npx) gets one command line of at most 8,191 characters, so the
  # files go in batches that stay well under it; the worst exit code wins.
  f="${AFTER_DD[*]}"; cap=$((7000 - ${#f}))
  for f in "${files[@]}"; do
    if [ "${#chunk[@]}" -gt 0 ] && [ $((len + ${#f} + 3)) -gt "$cap" ]; then
      "${AFTER_DD[@]}" "${chunk[@]}" || { st=$?; [ "$st" -le "$worst" ] || worst="$st"; }
      chunk=(); len=0
    fi
    chunk+=("$f"); len=$((len + ${#f} + 3))
  done
  "${AFTER_DD[@]}" "${chunk[@]}" || { st=$?; [ "$st" -le "$worst" ] || worst="$st"; }
  return "$worst"
}

# ------------------------------------------------------------------------------------------------
# Seat files and citations
# ------------------------------------------------------------------------------------------------

# The brief's "## Seats" blocks as rows: slug refs out cap. A paired worker's block has one "- ref:"
# line per doc; they come out joined by " ;; ". Backticks and quotes around values are stripped. A key
# may be written "- ref:", "ref:", "- **ref:**", "- Ref:", "- refs:", "- reference:", "- `ref:`",
# "- ref :" or indented: a near-miss spelling must never switch the proof of reading off.
brief_seats() {
  awk '
    function clean(v) { gsub(/[`"\r]/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v); return v }
    function key(l, name) {                        # the value after "name:", or "" with KEY = 0
      KEY = match(tolower(l), "^[ \t]*[-*+]?[ \t]*[`*_]*" name "(s|erence|erences)?[`*_]*[ \t]*:[`*_]*")
      return KEY ? substr(l, RLENGTH + 1) : ""
    }
    /^## / { ins = ($0 ~ /^## Seats[ \t\r]*$/); next }
    !ins { next }
    /^### / {
      if (slug != "") print slug "\t" ref "\t" out "\t" cap
      slug = $0; sub(/^###[ \t]*/, "", slug); sub(/[ \t].*$/, "", slug); gsub(/[`"\r]/, "", slug)
      ref = "none"; out = "seats/" slug ".md"; cap = 8; next
    }
    { v = key($0, "ref") }
    KEY { v = clean(v); if (v != "" && tolower(v) != "none") ref = (ref == "none" ? v : ref " ;; " v); next }
    { v = key($0, "out") }
    KEY { v = clean(v); if (v != "") out = v; next }
    { v = key($0, "cap") }
    KEY { if (match(v, /[0-9]+/)) cap = substr(v, RSTART, RLENGTH); next }
    END { if (slug != "") print slug "\t" ref "\t" out "\t" cap }' "$1"
}

# A reference doc's title as a worker copies it — its first heading, after any front matter; else its
# first line of text — in letters and digits only, lowercased. A title with no letters an ASCII rule
# knows (Hebrew, Chinese) keeps its own letters instead, so it can still be proved.
ref_title() {
  local raw t
  raw="$(awk 'NR == 1 { sub(/^\357\273\277/, ""); if ($0 ~ /^---[ \t\r]*$/) { fm = 1; next } }
       fm { if ($0 ~ /^---[ \t\r]*$/) fm = 0; next }
       /^#+[ \t]/ { sub(/^#+[ \t]*/, ""); t = $0; exit }
       first == "" && /[^ \t\r]/ { first = $0 }
       END { print (t != "" ? t : first) }' "$1" 2>/dev/null)"
  t="$(printf '%s\n' "$raw" | norm)"
  [ -n "$t" ] || t="$(printf '%s\n' "$raw" | norm_wide)"
  printf '%s' "$t"
}

# Item lines — "<n> · <severity> · <principle> · <path:line> · <title>[ · …]" — as rows:
# n sev principle cite title section ("-" for an empty value). The number may be a list item ("- 1 ·"),
# bold ("**1** ·"), dotted ("1. ·"), a cut item's ("C1") or lettered ("3a"). Fields split on " · "; only
# a line with no "·" splits on " | ". The cite comes as written (the citation reader strips its
# decoration); section is the first word of the "## " heading above the line, lowercased.
index_lines() {
  awk '
    function dash(s) { return s == "" ? "-" : s }
    /^## / { sec = tolower($0); sub(/^## +/, "", sec); sub(/[ \t\r].*$/, "", sec); next }
    /^[-*+]?[ \t]*[*_]*C?[0-9]+[a-z]?[*_]*\.?[ \t]+(·|\|)[ \t]/ {
      line = $0; gsub(/\r/, "", line); gsub(/\t/, " ", line); sub(/^[-*+]? */, "", line)
      k = (index(line, "·") ? split(line, f, / +· +/) : split(line, f, / +\| +/))
      if (k < 4) next
      n = f[1]; gsub(/[*_.]/, "", n)
      printf "%s\t%s\t%s\t%s\t%s\t%s\n", n, dash(f[2]), dash(f[3]), dash(f[4]), dash(k >= 5 ? f[5] : ""), dash(sec)
    }' "$1" 2>/dev/null
}

# The shape of a file's item sections — "## Index", or the "## " headings named in $2 ("Kept|Cut") —
# as "<parsed items> <item lines that don't parse> <has a (none) line>". A heading counts as the section
# when it holds that word ("## KEPT", "## Kept:", "## 📋 Index"). Inside a section a "###" heading that
# has item lines under it is a group heading and is skipped; one with prose under it is an item's body,
# and ends the section. An attempted item is a line that starts with a number (after a bullet or bold),
# a table row or a heading that does, or any line holding " · "; it parses with at least four fields (no
# citation, no item). An indented line is a note under an item unless it is written as one. Other prose
# is ignored. hooks/seat-gate.sh keeps a copy of this rule: change both together.
index_shape() {
  SECS="${2:-Index}" awk '
    function item(l) { return l ~ /^[-*+]? *[*_]*C?[0-9]+[a-z]?[*_]*\.? +(·|\|) / }
    BEGIN { secs = "(^|[^a-z])(" tolower(ENVIRON["SECS"]) ")([^a-z]|$)" }
    /^## / { h = tolower($0); sub(/^## +/, "", h); ins = (h ~ secs); pend = 0; next }
    !ins { next }
    {
      l = $0; gsub(/\r/, "", l); gsub(/\t/, " ", l)
      if (l ~ /^###/) {
        pend = 0
        if (l ~ /^#+ *[*_]*C?[0-9]+[a-z]?[*_]* +(·|\|) /) bad++                # an item written as a heading
        else pend = 1                                   # a group heading, or an item body: what follows says
        next
      }
      if (l ~ /^ *$/) next
      if (pend) { pend = 0; if (!item(l) && l !~ /^ *([-*+] +)?[*_]*\([Nn]one\)/) { ins = 0; next } }
      if (l ~ /^ *([-*+] +)?[*_]*\([Nn]one\)/) { none = 1; next }
      if (item(l)) {
        if ((index(l, "·") ? split(l, f, / +· +/) : split(l, f, / +\| +/)) >= 4) ok++; else bad++
        next
      }
      if (l ~ /^[ \t]/) {                                                      # a note under an item
        if (l ~ /^ +([-*+] +)?[*_]*C?[0-9]+[a-z]?[*_]*\.? +(·|\||-|\342\200\224|\342\200\223) /) bad++
        next
      }
      if (l ~ /^([-*+] +)?[*_]*C?[0-9]+/ || l ~ / · / || l ~ /^\| *[*_]*C?[0-9]+[a-z]?[*_]* *\|/) bad++
    }
    END { printf "%d %d %d\n", ok, bad, none }' "$1" 2>/dev/null
}

# The line part of a citation — "12", "7-9", or a comma list of both in any mix, such as "12,40-55" —
# as "start,end" words, one per piece. Fails on an empty or malformed piece and, given the file's line
# count as $2, on any piece that runs past the end. Blanks around a number are fine: "12, 40-55".
cite_ranges() {
  local rest="$1," piece s e out=""
  while [ -n "$rest" ]; do
    piece="${rest%%,*}"; rest="${rest#*,}"
    s="${piece%%-*}"; e="${piece#*-}"                      # a single line gives s = e
    case "$s$e" in *[!0-9[:blank:]]*) return 1 ;; esac      # no signs, no second dash
    # test takes blanks around a number but not inside one: "1 2" is an error, so false.
    [ "$s" -ge 1 ] 2>/dev/null && [ "$e" -ge "$s" ] 2>/dev/null || return 1
    [ $# -lt 2 ] || [ "$e" -le "$2" ] 2>/dev/null || return 1
    out="$out${out:+ }${s//[[:blank:]]/},${e//[[:blank:]]/}"
  done
  printf '%s\n' "$out"
}

# "ok", or "bad-line (<why>)", for a clean line list ($1) against a line count ($2); $3 names the file
# in the reason ("file has" by default).
cite_lines() {
  local piece s e
  if cite_ranges "$1" "$2" >/dev/null; then printf 'ok'; return; fi
  for piece in $(printf '%s' "$1" | tr ',' ' '); do
    s="${piece%%-*}"; e="${piece#*-}"
    if [ "$s" = 0 ] || [ "$e" = 0 ]; then printf 'bad-line (there is no line 0)'; return; fi
    if [ "$e" -lt "$s" ] 2>/dev/null; then printf 'bad-line (%s runs backwards)' "$piece"; return; fi
  done
  printf 'bad-line (the %s %s lines)' "${3:-file has}" "$2"
}

# The citation reader. A citation field, as a model writes it, becomes one row per place it names:
#   L <path> <lines>   a file and its lines, as a clean list ("12", "7-9,40")
#   P <path>           a path with no line ("src/app.py", "src/app.py::run", "src/")
#   U <text>           a place whose line part can't be read ("a.py:5x")
#   N <why>            nothing to check: command, link, no path — or "-" for no citation at all
#   WL/WP …            first, when the whole field is one place whose path has blanks in it
# Decoration goes first: a markdown link's [text](target) (both are read), bold, quotes. A backticked
# command is evidence, not a place: it is dropped, and what follows it is read. Lines may be written
# 12, L12, #L12, 12-14, 12..14, 12–14 and 12:5 (a column), and listed with , ; / + — "a.py:5, :9"
# reuses the path. Only a word that looks like a path counts (a folder, an extension, a Makefile), and
# after the first word a bare path needs a folder too, so the prose around a citation stays prose.
cite_parse() {
  CITE="$1" LC_ALL=C awk '
    function ext(p) { return p ~ /\.[A-Za-z][A-Za-z0-9_-]*$/ && p !~ /(^|\/)[A-Za-z]\.[A-Za-z]$/ }
    function pathy(p) { return p ~ /\// || ext(p) || p ~ /^\.[A-Za-z]/ || p ~ /^[A-Z][A-Za-z]*file$/ }
    function num(t) { sub(/^[Ll]/, "", t); sub(/^0+/, "", t); return t == "" ? "0" : t }
    # "10 and 9999", "10, line 9999", "10 or 12" — a second line joined by a word becomes "10,9999",
    # so it is read and checked like any list. A number followed by more prose ("5 and 9 callers")
    # is prose, and stays as written.
    function joinlines(x,   res, st, k, tail) {
      res = ""
      while (match(x, /[0-9][ \t]*,?[ \t]*(and|or|plus|lines?)[ \t]+:?[Ll]?[0-9]/)) {
        st = RSTART; k = RSTART + RLENGTH - 1                        # the first digit of the next number
        tail = substr(x, k)
        if (match(tail, /^[0-9]+([ \t]*-[ \t]*[0-9]+)?/) && substr(tail, RLENGTH + 1) !~ /^[ \t]+[A-Za-z]/) {
          res = res substr(x, 1, st) ","
        } else res = res substr(x, 1, k - 1)
        x = tail
      }
      return res x
    }
    function lines(t,   rest, out, piece, m) {   # the line part at the start of t; sets USED and ODD
      ODD = 0; USED = 0
      if (!match(t, /^[Ll]?[0-9]+/)) return ""
      piece = num(substr(t, 1, RLENGTH)); rest = substr(t, RLENGTH + 1); out = ""
      while (1) {
        if (match(rest, /^(-|\.\.)[Ll]?[0-9]+/)) {                            # a range
          if (index(piece, "-")) { ODD = 1; break }
          m = substr(rest, 1, RLENGTH); sub(/^[^0-9]+/, "", m)
          piece = piece "-" num(m); rest = substr(rest, RLENGTH + 1); continue
        }
        if (match(rest, /^:[0-9]+/)) { rest = substr(rest, RLENGTH + 1); continue }   # a column
        if (match(rest, /^ *[,;\/+&] *:?[Ll]?[0-9]+/)) {                        # the next piece
          m = substr(rest, 1, RLENGTH); sub(/^[^0-9]+/, "", m)
          out = out (out == "" ? "" : ",") piece; piece = num(m); rest = substr(rest, RLENGTH + 1); continue
        }
        break
      }
      if (rest ~ /^([A-Za-z0-9_]|-|\.\.|\.[0-9])/) ODD = 1
      USED = length(t) - length(rest)
      return out (out == "" ? "" : ",") piece
    }
    function emit(row) { if (!(row in seen)) { seen[row] = 1; print row; got++ } }
    BEGIN {
      s = ENVIRON["CITE"]; gsub(/[\r\t]/, " ", s)
      t = s; gsub(/ /, "", t)
      if (t == "" || t == "-") { print "N\t-"; exit }
      na = tolower(t); gsub(/[.`*_"]/, "", na)                                  # "n/a" is no citation,
      if (na ~ /^(n\/a|na|none|\(none\)|tbd|tba|-|\342\200\224|\342\200\223)$/) { print "N\t-"; exit }  # not a path
      gsub(/\342\200\223|\342\200\224/, "-", s)                                 # en and em dashes
      gsub(/\342\206\222|->|=>/, " ", s)                                        # arrows
      gsub(/\342\200\230|\342\200\231|\342\200\234|\342\200\235/, " ", s)      # curly quotes
      while ((i = index(s, "](")) > 0) {                                        # [text](target) → text target
        a = substr(s, 1, i - 1); b = substr(s, i + 2); j = index(b, ")")
        k = 0; t = a; while ((x = index(t, "[")) > 0) { k += x; t = substr(t, x + 1) }
        if (!j || !k) break
        s = substr(a, 1, k - 1) " " substr(a, k + 1) " " substr(b, 1, j - 1) " " substr(b, j + 1)
      }
      gsub(/\*/, "", s); gsub(/["\[\]]/, " ", s); gsub(/\047/, " ", s)
      s = joinlines(s)                                                          # "…:10 and 9999" → "…:10,9999"
      w = s; gsub(/`/, "", w); sub(/^ +/, "", w); sub(/[ .,;]+$/, "", w)         # the whole field, as one place
      if (w ~ /^[^:]* [^:]*:[Ll]?[0-9]/) {
        p = w; sub(/:[^:]*$/, "", p); l = lines(substr(w, length(p) + 2))
        if (!ODD && l != "" && substr(w, length(p) + 2 + USED) ~ /^[ .,;:+]*$/) print "WL\t" p "\t" l
      } else if (w ~ / / && w !~ /:/ && pathy(w)) print "WP\t" w
      while ((i = index(s, "`")) > 0) {                                         # `a command` is dropped
        t = substr(s, i + 1); j = index(t, "`")
        if (!j) { s = substr(s, 1, i - 1) " " t; break }
        c = substr(t, 1, j - 1); if (c ~ / /) { cmd = 1; c = "" }
        s = substr(s, 1, i - 1) " " c " " substr(t, j + 1)
      }
      if (gsub(/[A-Za-z][A-Za-z0-9+.-]*:\/\/[^ ]*/, " ", s)) link = 1
      k = 0
      while (match(s, /[^ ,;|()<>{}]+/)) {
        wd = substr(s, RSTART, RLENGTH); tail = substr(s, RSTART + RLENGTH); s = tail; k++
        from = (wd ~ /^[A-Za-z]:[\/\\]/) ? 3 : 1                               # a drive letter is not a line
        p = wd; sfx = ""
        if (match(substr(wd, from), /[:#]/)) { p = substr(wd, 1, from + RSTART - 2); sfx = substr(wd, from + RSTART - 1) }
        gsub(/\\/, "/", p)
        if (sfx == "") sub(/[.:]+$/, "", p)
        if (p == "" || !pathy(p)) continue
        # "a.py:5" · "a.py#L5" · "a.py: 12" (any blanks) · "a.py: line 12" · "a.py lines 10-12"
        t = ""
        if (sfx ~ /^(:|#)[Ll]?[0-9]/) t = substr(sfx, 2) tail
        else if (sfx == ":" || sfx == "") {
          pfx = (sfx == ":") ? "^[ \t]+(lines?[ \t]+)?" : "^[ \t]*,?[ \t]*lines?[ \t]+"
          if (match(tail, pfx) && substr(tail, RLENGTH + 1) ~ /^[Ll]?[0-9]/) t = substr(tail, RLENGTH + 1)
        }
        if (t != "") {
          l = lines(t); s = substr(t, USED + 1)
          u = wd; if (sfx !~ /^(:|#)[Ll]?[0-9]/) { m = t; sub(/ .*$/, "", m); u = wd " " m }
          if (ODD) emit("U\t" u)
          else emit("L\t" p "\t" l)
          continue
        }
        if (p ~ /\/$/ || (p ~ /\// && ext(p)) || (k == 1 && tail ~ /^ *($|\(|-)/)) emit("P\t" p)
      }
      if (!got) print "N\t" (cmd ? "command" : link ? "link" : "no path")
    }' </dev/null
}

# The rows cite_parse gives; a whole-field place (WL/WP) is used alone when its path exists.
cite_rows() {
  local rows first p nl='
'
  rows="$(cite_parse "$2")"
  case "$rows" in
    W*)
      first="${rows%%"$nl"*}"; p="${first#*"$TAB"}"; p="${p%%"$TAB"*}"
      case "$p" in /*|[A-Za-z]:*) ;; *) p="$1/$p" ;; esac
      if [ -e "$p" ]; then printf '%s\n' "${first#W}"; else printf '%s\n' "${rows#*"$nl"}"; fi ;;
    *) printf '%s\n' "$rows" ;;
  esac
}

# A cited path as it sits inside the tree $1 — or the path itself when it is outside it. The forms
# Git Bash and Windows print for the same file ("/c/Users/…", "c:/users/…", "C:/Users/…") all resolve,
# so a citation written any of them keeps its real status and origin.
cite_rel() {
  local top="$1" f="$2" d lt lf
  case "$f" in /*|[A-Za-z]:*) ;; *) printf '%s' "$f"; return 0 ;; esac
  case "$f" in "$top"/*) printf '%s' "${f#"$top"/}"; return 0 ;; esac
  case "$top" in
    [A-Za-z]:/*)
      case "$f" in /[A-Za-z]/*) d="${f:1:1}"; f="$d:${f:2}" ;; esac                # the Git Bash form
      case "$f" in "$top"/*) printf '%s' "${f#"$top"/}"; return 0 ;; esac
      lt="$(printf '%s' "$top" | tr 'A-Z' 'a-z')"; lf="$(printf '%s' "$f" | tr 'A-Z' 'a-z')"
      case "$lf" in "$lt"/*) printf '%s' "${f:$((${#top} + 1))}"; return 0 ;; esac ;;
  esac
  printf '%s' "$2"
}

# One place: ok | deleted | no-line | missing-file | area | bad-line (…) | unreadable (…). A path that
# isn't on disk but is in the base ($2; HEAD without one) was deleted by the change: its lines are
# checked against the base's copy. With CITE_AREA=1 (a plan, research or a post-game, where the field
# is "<path or area>"), a bare path that is on disk nowhere is an area or a file still to be written.
cite_place() {
  local top="$1" base="${2:-HEAD}" kind="$3" p="$4" l="${5:-}" f rel n
  if [ "$kind" = U ]; then printf 'unreadable (%s — write it as path:line)' "$p"; return; fi
  case "$p" in /*|[A-Za-z]:*) f="$p" ;; *) f="$top/$p" ;; esac
  if [ "$kind" = P ] && [ -e "$f" ]; then printf 'no-line'; return; fi
  if [ "$kind" = L ] && [ -f "$f" ]; then cite_lines "$l" "$(awk 'END { print NR }' "$f")"; return; fi
  if [ "$kind" = L ] && [ -d "$f" ]; then printf 'bad-line (a folder has no lines)'; return; fi
  rel="$(cite_rel "$top" "$f")"
  if [ "$rel" != "$f" ] && git -C "$top" cat-file -e "$base:${rel%/}" 2>/dev/null; then
    [ "$kind" = L ] || { printf 'deleted'; return; }
    n="$(git -C "$top" show "$base:$rel" 2>/dev/null | awk 'END { print NR }')"
    case "$(cite_lines "$l" "$n")" in ok) printf 'deleted' ;; *) cite_lines "$l" "$n" "deleted file had" ;; esac
    return
  fi
  if [ "$kind" = P ] && [ "${CITE_AREA:-0}" = 1 ]; then printf 'area'; return; fi
  printf 'missing-file'
}

# The verdict on a citation field — ok | deleted (…) | no-line (…) | missing-file | bad-line (…) |
# unreadable (…) | no-citation (…) | n/a [(why)]. Every place the field names is checked (see
# cite_parse); the first that fails gives the verdict, naming the place when the field has several.
# $3 is the change's base. A bare path that isn't there, beside a place that resolved, is a note
# ("src/api.py:40 (extract to src/lib/retry.py)"), not the item's citation. With
# CITE_NEEDS_PLACE=1 (a review, where every item needs a path:line) a field with no place at all is
# not a quiet "n/a" but a problem of its own.
cite_status() {
  local top="$1" base="${3:-}" kind p l v fv="" fp="" fl="" places=0 ok=0 del=0 bare=0 why="" area=0 nv="" np=""
  while IFS="$TAB" read -r kind p l; do
    case "$kind" in N) why="$p"; continue ;; L|P|U) ;; *) continue ;; esac
    places=$((places + 1))
    v="$(cite_place "$top" "$base" "$kind" "$p" "$l")"
    case "$v" in
      ok) ok=$((ok + 1)) ;;
      deleted) del=$((del + 1)) ;;
      no-line) bare=$((bare + 1)) ;;
      area) area=$((area + 1)) ;;
      missing-file) if [ "$kind" = P ]; then [ -n "$nv" ] || { nv="$v"; np="$p"; }
                    else [ -n "$fv" ] || { fv="$v"; fp="$p"; fl="${l:+:$l}"; }; fi ;;
      *) [ -n "$fv" ] || { fv="$v"; fp="$p"; fl="${l:+:$l}"; } ;;
    esac
  done <<ROWS
${CITE_ROWS:-$(cite_rows "$top" "$2")}
ROWS
  if [ -z "$fv" ] && [ -n "$nv" ] && [ "$((ok + del + bare))" -eq 0 ]; then fv="$nv"; fp="$np"; fl=""; fi
  if [ -n "$fv" ]; then
    if [ "$places" -eq 1 ]; then printf '%s' "$fv"
    else
      case "$fv" in
        missing-file) printf 'missing-file (%s)' "$fp" ;;
        "bad-line ("*) printf 'bad-line (%s%s — %s' "$fp" "$fl" "${fv#bad-line (}" ;;
        *) printf '%s' "$fv" ;;
      esac
    fi
  elif [ "$ok" -gt 0 ]; then printf 'ok'
  elif [ "$del" -gt 0 ]; then printf 'deleted (removed by this change — checked against the base)'
  elif [ "$bare" -gt 0 ]; then printf 'no-line (the path exists)'
  elif [ "$area" -gt 0 ]; then printf 'n/a (nothing on disk by that name — an area, or a file still to write)'
  elif [ "${CITE_NEEDS_PLACE:-0}" = 1 ] && { [ -z "$why" ] || [ "$why" = "-" ] || [ "$why" = "no path" ]; }; then
    printf 'no-citation (a review item needs a path:line)'
  elif [ -z "$why" ] || [ "$why" = "-" ]; then printf 'n/a'
  else printf 'n/a (%s)' "$why"
  fi
}

# From a -U0 diff on stdin and the "s,e" ranges in $1: "<a hunk inside or right next to a range>
# <an added line inside a range> <the file is not in the base under this name>", as three 0/1 flags.
# A hunk's new side "+c,0" is lines removed after line c. A file the change added — or only renamed —
# shows as one big added hunk, which says nothing about which lines the change really touched.
cite_hunks() {
  RANGES="$1" awk '
    BEGIN { n = split(ENVIRON["RANGES"], r, " "); for (i = 1; i <= n; i++) { split(r[i], se, ","); S[i] = se[1] + 0; E[i] = se[2] + 0 } }
    /^new file mode / { isnew = 1 }
    /^@@ / {
      h = $3; sub(/^\+/, "", h); c = h + 0; d = 1
      if (index(h, ",")) { c = substr(h, 1, index(h, ",") - 1) + 0; d = substr(h, index(h, ",") + 1) + 0 }
      for (i = 1; i <= n; i++) {
        if (d == 0) { if (c >= S[i] - 1 && c <= E[i]) near = 1; continue }
        if (c <= E[i] + 1 && c + d - 1 >= S[i] - 1) near = 1
        if (c <= E[i] && c + d - 1 >= S[i]) inside = 1
      }
    }
    END { printf "%d %d %d\n", near, inside, isnew }'
}

# introduced | touched | pre-existing | new file | origin unknown [(…)] — for the lines a citation names,
# from git blame against the base ($3) and from the change's own hunks. Lines the change removed or added
# inside or right next to a cited range make it "touched" even when every cited line is old: a removed
# guard can only be cited by the lines around the gap. A file the change deleted is "touched". A list is
# blamed whole (git blame takes one -L per piece). When blame can't read a tracked file, or a line reads
# as new only because its line ending changed, the origin is unknown rather than a guess. In a file the
# change only renamed, the diff calls every line new, so blame alone decides there.
cite_origin() {
  local top="$1" c="$2" base="$3" kind p l f rel real ranges r shas sha old=0 new=0 near=0 unknown=0 crlf=0 untracked=0 po pn d dn di dnew
  while IFS="$TAB" read -r kind p l; do
    [ "$kind" = L ] || continue
    ranges="$(cite_ranges "$l")" || continue
    case "$p" in /*|[A-Za-z]:*) f="$p" ;; *) f="$top/$p" ;; esac
    rel="$(cite_rel "$top" "$f")"
    if [ ! -f "$f" ]; then
      ! git -C "$top" cat-file -e "$base:$rel" 2>/dev/null || near=$((near + 1))   # the change deleted it
      continue
    fi
    [ "$rel" != "$f" ] || { unknown=$((unknown + 1)); continue; }                # outside this repository
    real="$(git -C "$top" -c core.quotePath=false ls-files -- ":(icase,literal)$rel" 2>/dev/null)"
    [ "$(printf '%s\n' "$real" | grep -c .)" != 1 ] || rel="$real"           # its real name, case and all
    set --
    for r in $ranges; do set -- ${1+"$@"} -L "$r"; done                        # digits and commas only
    shas="$(git -C "$top" blame --porcelain "$@" -- "$rel" 2>/dev/null \
      | awk '$1 ~ /^[0-9a-f]+$/ && (length($1) == 40 || length($1) == 64) && NF >= 3 { print $1 }' | sort -u)"
    if [ -z "$shas" ]; then
      if git -C "$top" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then unknown=$((unknown + 1))
      else untracked=$((untracked + 1)); fi
      continue
    fi
    po=0; pn=0
    for sha in $shas; do
      case "$sha" in *[!0]*) ;; *) pn=$((pn + 1)); continue ;; esac
      if git -C "$top" merge-base --is-ancestor "$sha" "$base" 2>/dev/null; then po=$((po + 1)); else pn=$((pn + 1)); fi
    done
    d="$(git -C "$top" diff -U0 --no-color --no-ext-diff --ignore-cr-at-eol "$base" -- "$rel" 2>/dev/null | cite_hunks "$ranges")"
    dn="${d%% *}"; di="${d#* }"; dnew="${di#* }"; di="${di%% *}"
    if [ "$dnew" = 1 ]; then dn=0; di=0; fi           # added or renamed under this name: blame decides
    if [ "$po" -eq 0 ] && [ "$di" = 0 ] && [ "$dnew" != 1 ] \
       && [ "$(git -C "$top" diff -U0 --no-color --no-ext-diff "$base" -- "$rel" 2>/dev/null | cite_hunks "$ranges" | cut -d' ' -f2)" = 1 ]; then
      crlf=$((crlf + 1)); continue                                              # new only by its line endings
    fi
    old=$((old + po)); new=$((new + pn))
    [ "$dn" = 0 ] || near=$((near + 1))
  done <<ROWS
${CITE_ROWS:-$(cite_rows "$top" "$c")}
ROWS
  if [ "$old" -eq 0 ] && [ "$new" -eq 0 ]; then
    if [ "$near" -gt 0 ]; then printf 'touched'
    elif [ "$untracked" -gt 0 ]; then printf 'new file'
    elif [ "$crlf" -gt 0 ]; then printf 'origin unknown (only line endings changed)'
    elif [ "$unknown" -gt 0 ]; then printf 'origin unknown'
    fi
    return 0
  fi
  new=$((new + untracked))
  if [ "$new" -eq 0 ]; then if [ "$near" -eq 0 ]; then printf 'pre-existing'; else printf 'touched'; fi
  elif [ "$old" -eq 0 ]; then printf 'introduced'
  else printf 'touched'
  fi
}

# How a mode's citation field is read. A plan, research and a post-game cite "<path or area>": a name
# that is on disk nowhere is an area, or a file the work would still write — not a broken citation. A
# review item has to name a place ("no evidence, no item").
cite_mode() {
  CITE_AREA=0; CITE_NEEDS_PLACE=0
  case "${1:-}" in
    council-plan|council-research|council-postgame) CITE_AREA=1 ;;
    council-review) CITE_NEEDS_PLACE=1 ;;
  esac
}

# A seat-file problem. It's a hard one unless the seat's worker is still running: its file may just not
# be done yet, so the Chair waits instead of resuming or re-dispatching it. "collect_flag cite" marks a
# problem with citations only: the seat's work is there, so the lines are fixed in place.
collect_flag() { bad=1; [ "${live:-0}" = 1 ] || { hard=1; [ "${1:-}" = cite ] || deep=1; }; }

cmd_collect() {
  local run top base brief seats slug ref out cap f size refok r t got shape items unparsed hasnone okc allc nol unc \
        n sev pr cite title sec tok state bad=0 total=0 note hard=0 deep=0 live=0 sat=0 r2lost=""
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  base="$(field base "$run/session-state.md")"
  cite_mode "$(field mode "$run/session-state.md")"
  brief="$run/brief.md"
  [ -f "$brief" ] || die "no brief.md in $run — write the brief first"
  seats="$(brief_seats "$brief")"
  [ -n "$seats" ] || die "brief.md has no seat blocks under '## Seats' (### <slug> — …)"
  [ ! -f "$run/debate.md" ] || seats="$seats
$(brief_seats "$run/debate.md")"                      # a war room's round-2 files, from debate.md's own ## Seats
  printf '%-16s %-8s %-7s %-4s %-9s %-7s %s\n' seat file items KB ref cites tokens
  while IFS="$TAB" read -r slug ref out cap; do
    [ -n "$slug" ] || continue
    total=$((total + 1)); note=""
    case "$out" in /*|[A-Za-z]:*) f="$out" ;; *) f="$run/$out" ;; esac
    if [ "${slug%-r2}" != "$slug" ] && [ -z "$(seat_field "$run" "$slug" 2)" ]; then
      tok="-"; state="$(seat_field "$run" "${slug%-r2}" 2)"     # round 2 by the round-1 worker, resumed
    else                                                         # (a fresh round-2 worker has its own row)
      tok="$(seat_field "$run" "$slug" 4)"
      if [ -n "$tok" ] && [ "$tok" -gt 0 ] 2>/dev/null; then tok="~$(( (tok + 500) / 1000 ))k"; else tok="-"; fi
      state="$(seat_field "$run" "$slug" 2)"
    fi
    # A fresh round-2 worker (<slug>-r2) took over a lost round-1 worker: judge the round-1 row by its file.
    if [ "${slug%-r2}" = "$slug" ] && [ -n "$(seat_field "$run" "$slug-r2" 2)" ]; then state=done; fi
    # A worker lost in a war room's round 2 (marked failed after a compaction or a new session): the
    # failure is the round-2 row's, which follows it; the round-1 file is done and judged by itself.
    case "$state" in failed|blocked)
      if [ "${slug%-r2}" = "$slug" ] && printf '%s\n' "$seats" | cut -f1 | grep -qxF -- "$slug-r2"; then state=done; fi ;;
    esac
    live=0; case "$state" in running|queued) live=1 ;; esac     # its file may simply not be done yet
    case "$state" in failed|blocked|running|queued) note=" state:$state"; collect_flag ;; esac
    case "$slug:$state" in *-r2:failed|*-r2:blocked) r2lost="$r2lost${r2lost:+, }$slug" ;; esac
    if [ ! -s "$f" ] && [ "$state" = skipped ] && [ "${slug%-r2}" != "$slug" ]; then   # sat round 2 out (war-room.md)
      t="$(seat_field "$run" "$slug" 6)"
      printf '%-16s %-8s %-7s %-4s %-9s %-7s %s%s\n' "$slug" skipped - - - - "$tok" "${t:+ · $t}"; sat=$((sat + 1)); continue
    fi
    if [ ! -s "$f" ]; then
      printf '%-16s %-8s %-7s %-4s %-9s %-7s %s%s\n' "$slug" missing - - - - "$tok" "$note"; collect_flag; continue
    fi
    if sed -n '2,9p' "$f" | grep -q '^BLOCKED'; then
      printf '%-16s %-8s %s\n' "$slug" blocked "$(sed -n '2,9p' "$f" | grep -m 1 '^BLOCKED' | tr -d '\r' | clip 140)"; collect_flag; continue
    fi
    size="$(( ($(wc -c < "$f") + 1023) / 1024 ))"
    refok=ok
    if [ "$ref" = none ]; then
      refok=n/a
    else
      got="$(sed -n '2,9p' "$f" | grep '^ref:' | sed 's/^ref:[[:space:]]*//' | while IFS= read -r l; do
               printf '%s' "$l" | norm; printf '\n'; printf '%s' "$l" | norm_wide; done)"
      while IFS= read -r r; do
        [ -n "$r" ] || continue
        if [ ! -f "$r" ]; then refok=no-doc; collect_flag; break; fi
        t="$(ref_title "$r")"                           # an empty title or no ref: line proves nothing
        if [ -z "$t" ] || ! printf '%s\n' "$got" | grep -qxF "$t"; then refok=MISMATCH; collect_flag; fi
      done <<REFS
$(printf '%s\n' "$ref" | awk -F' ;; ' '{ for (i = 1; i <= NF; i++) print $i }')
REFS
    fi
    shape="$(index_shape "$f")"; items="${shape%% *}"; unparsed="${shape#* }"; hasnone="${unparsed#* }"; unparsed="${unparsed%% *}"
    grep -q '^## Index' "$f" || { note="$note no-index"; collect_flag; }
    [ "${unparsed:-0}" -eq 0 ] || { note="$note unparsed-index($unparsed)"; collect_flag; }
    if [ "${items:-0}" -eq 0 ] && [ "${hasnone:-0}" -eq 0 ] && [ "${unparsed:-0}" -eq 0 ]; then note="$note empty-index"; collect_flag; fi
    [ "${items:-0}" -le "${cap:-8}" ] || { note="$note over-cap"; collect_flag; }
    [ "$size" -le 16 ] || { note="$note over-16KB"; collect_flag; }
    okc=0; allc=0; nol=0; unc=0              # a path with no line counts as found; no path at all as unchecked
    while IFS="$TAB" read -r n sev pr cite title sec; do
      [ -n "$n" ] || continue
      case "$(cite_status "$top" "$cite" "$base")" in
        ok|deleted*) okc=$((okc + 1)); allc=$((allc + 1)) ;;
        no-line*) okc=$((okc + 1)); allc=$((allc + 1)); nol=$((nol + 1)) ;;
        n/a*) unc=$((unc + 1)) ;;
        *) allc=$((allc + 1)) ;;
      esac
    done <<ITEMS
$(index_lines "$f")
ITEMS
    [ "$okc" -eq "$allc" ] || { note="$note broken-cites"; collect_flag cite; }
    [ "$nol" -eq 0 ] || note="$note no-line($nol)"
    [ "$unc" -eq 0 ] || note="$note unchecked($unc)"
    printf '%-16s %-8s %-7s %-4s %-9s %-7s %s%s\n' "$slug" ok "${items:-0}/${cap:-8}" "$size" "$refok" "$okc/$allc" "$tok" "${note:+ ·$note}"
  done <<SEATS
$seats
SEATS
  if [ "$bad" -eq 0 ]; then
    if [ "$sat" -eq 0 ]; then say "collect: all $total seats in order"; else say "collect: all $total seats in order · $sat sat out (skipped)"; fi
    return 0
  fi
  if [ "$hard" -eq 0 ]; then
    say "collect: seats still working — after a compaction, wait for their notifications; if the session that started them has ended they are gone: mark them failed and re-dispatch each once (a war-room round-2 seat gets a fresh <slug>-r2 worker)"; return 1
  fi
  if [ "$deep" -eq 0 ]; then
    say "collect: only citations are wrong — the seats' work is there. 'council check <seat file>' names each bad one: fix those lines in place (ask that worker, or correct an obvious one yourself), then collect again"
    return 1
  fi
  say "collect: fix the rows above — resume that worker (message its agent id) or re-dispatch it once"
  [ -z "$r2lost" ] || say "collect: $r2lost lost round 2 with its worker — dispatch a fresh round-2 worker for each and record it as 'council seat <slug>-r2 running'; round 1 is done, don't re-run it"
  return 1
}

# The first path in a gate command that is a real test file the project keeps: a regular file inside
# the project whose name says test or spec, either tracked by git or present and not ignored (the test a
# build just wrote isn't staged yet). A source file, a directory, a config file or a file outside the
# project is never "a saved test". A path is also tried inside the folder a `cd <dir>`, `--prefix`,
# `--cwd`, `--dir` or `-C` names, a `--flag=<path>` word is read for its path, and Godot's res:// is
# the project root. Globbing off: a command may contain * and we only want its words.
gate_test_path() {
  ( set -f
    cd "$1" 2>/dev/null || exit 1
    hit=""; base=""; sub=""; want=""; away=0; root="$(pwd -P)"
    for tok in $2; do
      tok="$(printf '%s' "$tok" | tr -d "\"'\`")"; tok="${tok%;}"
      tok="${tok#(}"; tok="${tok%)}"   # a subshell: (cd dir && pytest tests/test_x.py)
      if [ -n "$want" ]; then want=""; sub="${tok%/}"; away=0; fi
      case "$tok" in
        cd|pushd|--prefix|--cwd|--dir|-C) want=1; continue ;;
        --prefix=*|--cwd=*|--dir=*) sub="${tok#*=}"; sub="${sub%/}"; away=0 ;;
        -*=*) tok="${tok#*=}" ;;
      esac
      if [ -n "$sub" ] && [ "$away" = 0 ]; then
        # A cd or --prefix out of the project: from here the paths are not this project's, so nothing
        # is confirmed rather than the wrong file being named.
        case "$(cd "$sub" 2>/dev/null && pwd -P)" in "$root"|"$root"/*) ;; *) away=1 ;; esac
      fi
      case "$tok" in cd|pushd|--prefix=*|--cwd=*|--dir=*) continue ;; esac
      case "$tok" in res://*) tok="${tok#res://}" ;; esac
      case "$tok" in *::*) tok="${tok%%::*}" ;; esac
      case "$tok" in -*|.|./|*"*"*|*"?"*) continue ;; *[/.]*) ;; *) continue ;; esac
      base="$(printf '%s' "${tok##*/}" | tr 'A-Z' 'a-z')"
      case "$base" in                 # a config, a log or a report is never the test that was saved
        *.log|*.ini|*.cfg|*.conf|*.toml|*.json|*.yaml|*.yml|*.xml|*.txt|*.md|*.lock|*.csv) continue ;;
      esac
      case "$base" in                 # the file's own name has to say it is a test
        test_*|test-*|*_test.*|*-test.*|*.test.*|*.spec.*|*_spec.*|*-spec.*|spec_*|tests.*|test.*) ;;
        *) continue ;;
      esac
      [ "$away" = 0 ] || continue     # the command left the project before naming this path
      p="$tok"                        # inside the folder the command moved to, if it named one
      case "$tok" in /*|[A-Za-z]:*) ;; *) [ -z "$sub" ] || p="$sub/$tok" ;; esac
      if [ -f "$p" ]; then
        if git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then hit="$p"
        else
          git check-ignore -q -- "$p" >/dev/null 2>&1
          [ $? -ne 1 ] || hit="$p"    # 1 = not ignored; 128 = outside the project
        fi
      fi
      [ -z "$hit" ] || break          # the first real test named wins
    done
    [ -n "$hit" ] || exit 1
    while :; do                       # a path that walks back up: webapp/backend/../../tests/x -> tests/x
      case "$hit" in
        */../*) p="$(printf '%s' "$hit" | sed 's#[^/][^/]*/\.\./##')"; [ "$p" != "$hit" ] || break; hit="$p" ;;
        *) break ;;
      esac
    done
    printf '%s' "${hit#./}" )
}

# A gate verdict json is one line, written by run_gate: {"gate": .., "command": .., "exit": N, ..}
gate_exit() { sed -n 's/.*"exit": *\(-\{0,1\}[0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -n 1; }
gate_cmd()  { sed -n 's/.*"command": "\(.*\)", "exit".*/\1/p' "$1" 2>/dev/null | head -n 1 \
                | sed 's/\\\(.\)/\1/g'; }

cmd_check() {
  local run top base out f lab n sev pr cite title st origin rows=0 bad=0 a req qn=0 qok=0 \
        bf af bex aex bcmd acmd tp pn proofs=0 saved=0 broke=0 note what \
        mode where shape items unread none secs files=0 sec noline=0 unchecked=0 shown q extra="" \
        other=0 unreadt=0 empty=0 gone=0
  run="$(resolve_run)" || exit 2
  top="$(field code-root "$run/session-state.md")"; [ -n "$top" ] || top="$(this_tree)"
  base="${BASE_ARG:-$(field base "$run/session-state.md")}"
  mode="$(field mode "$run/session-state.md")"
  cite_mode "$mode"
  if [ $# -eq 0 ]; then
    if [ -f "$run/synthesis.md" ]; then set -- "$run/synthesis.md"; else set -- "$run"/seats/*.md; fi
    if [ "$(field mode "$run/session-state.md")" = council-implement ]; then
      for f in ${1+"$@"}; do           # a build's diagnosis cites the code before its fix: lines that moved on
        shift; case "${f##*/}" in diagnose-*) ;; *) set -- ${1+"$@"} "$f" ;; esac
      done
    fi
  fi
  # The user's own words — ask.md and the filed request, from "## In your words" on, whitespace
  # collapsed — for the quote: check (a post-game's parts quote the request word for word). Secrets are
  # redacted here as in the filed copy, so a quote can only match words a tracked file may hold.
  req="$run/.request.txt"
  a="$(field ask "$run/session-state.md")"
  [ -n "$a" ] || a="$(field continues "$run/ask.md" | tr -d '`<>' | sed 's/[[:space:]].*$//')"   # not filed yet
  if [ -n "$a" ]; then case "$a" in /*|[A-Za-z]:*) ;; *) a="$(dirname "$(council_home)")/$a" ;; esac; fi
  for f in "$run/ask.md" "$a"; do          # the words only: no headings, no "(no new words)"
    if [ -n "$f" ] && [ -f "$f" ]; then
      awk '/^## In your words/ { on = 1; next }
           on && (/^## Later/ || /^## [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] / || /^\(no new words\)[ \t\r]*$/) { next }
           on' "$f"
    fi
  done > "$req.raw" 2>/dev/null
  redact_copy "$req.raw" "$req.red" >/dev/null 2>&1 || : > "$req.red"
  tr -s ' \t\r\n' '    ' < "$req.red" > "$req" 2>/dev/null
  rm -f "$req.raw" "$req.red"
  out="$run/check.md"
  {
    printf '# Citation check — %s\n' "$(now_sec)"
    printf 'base: %s\n\n' "${base:-unknown — origin not checked}"
    printf '| item | cite | status | origin |\n|---|---|---|---|\n'
  } > "$out"
  for f in ${1+"$@"}; do                                            # ${1+…}: bash 3.2 and an empty list
    if [ ! -f "$f" ]; then
      case "$f" in "$run/seats/*.md") continue ;; esac               # no seat files yet: nothing was named
      gone=$((gone + 1)); other=$((other + 1)); say "check: $f — no such file"; continue
    fi
    files=$((files + 1))
    lab="$(basename "$f" .md)"
    # Item lines it can't read, or none at all, are never a pass: nothing would have been checked.
    if awk '/^##[ \t]/ && tolower($0) ~ /(^|[^a-z])(kept|cut)([^a-z]|$)/ { f = 1; exit } END { exit !f }' "$f"; then
      secs='Kept|Cut'; where='## Kept or ## Cut'
    else secs=Index; where='## Index'; fi
    shape="$(index_shape "$f" "$secs")"; items="${shape%% *}"; unread="${shape#* }"; none="${unread#* }"; unread="${unread%% *}"
    if [ "${unread:-0}" -gt 0 ]; then
      other=$((other + unread)); unreadt=$((unreadt + unread))
      say "$lab: $unread item line(s) check can't read — write each as '<n> · <severity> · <principle> · <path:line> · <title>'"
    fi
    if [ "${items:-0}" -eq 0 ] && [ "${none:-0}" -eq 0 ] && [ "${unread:-0}" -eq 0 ]; then
      other=$((other + 1)); empty=$((empty + 1))
      say "$lab: no items under $where — nothing was checked (write '(none) — <why>' when there is nothing)"
    fi
    while IFS="$TAB" read -r n sev pr cite title sec; do
      [ -n "$n" ] || continue
      rows=$((rows + 1))
      CITE_ROWS="$(cite_rows "$top" "$cite")"        # read once, for the status and the origin alike
      st="$(cite_status "$top" "$cite" "$base")"
      origin=""
      case "$st" in
        ok|deleted*) [ -z "$base" ] || origin="$(cite_origin "$top" "$cite" "$base")" ;;
        no-line*) noline=$((noline + 1)) ;;
        n/a*) unchecked=$((unchecked + 1)) ;;
        *) bad=$((bad + 1)) ;;
      esac
      CITE_ROWS=""
      shown="$(printf '%s' "$cite" | tr -d '`"')"
      printf '| %s#%s | %s | %s | %s |\n' "$lab" "$n" "$shown" "$st" "${origin:--}" >> "$out"
      say "$lab#$n  $shown  $st${origin:+ · $origin}"
    done <<ITEMS
$(index_lines "$f")
ITEMS
    while IFS="$TAB" read -r n st q; do
      [ -n "$n" ] || continue
      qn=$((qn + 1))
      if [ "$st" != ok ] && [ -n "$q" ]; then                   # a secret in a quote would reach a tracked file
        printf '%s\n' "$q" > "$req.q"
        [ "$(redact_copy "$req.q" "$req.q2" 2>/dev/null)" = 0 ] \
          || st="SECRET (it holds a secret-looking string — quote the redacted words the filed request has)"
        rm -f "$req.q" "$req.q2"
      fi
      if [ "$st" = ok ]; then qok=$((qok + 1)); else bad=$((bad + 1)); fi
      printf '| %s#%s | quote | %s | - |\n' "$lab" "$n" "$st" >> "$out"
      say "$lab#$n  quote  $st"
    done <<QUOTES
$(REQF="$req" MODE="$mode" LC_ALL=C awk '
  function alnum(c) { return c ~ /[A-Za-z0-9]/ }
  function repl(s, a, b,   i, o) { o = ""; while ((i = index(s, a)) > 0) { o = o substr(s, 1, i - 1) b; s = substr(s, i + length(a)) } return o s }
  function fold(s) {                               # what a reader can not see: curly quotes, odd spaces
    s = repl(s, "\342\200\230", "\047"); s = repl(s, "\342\200\231", "\047")
    s = repl(s, "\342\200\234", "\""); s = repl(s, "\342\200\235", "\"")
    s = repl(s, "\302\240", " "); s = repl(s, "\342\200\257", " "); s = repl(s, "\342\200\211", " ")
    s = repl(s, "\342\200\213", ""); s = repl(s, "\342\200\214", ""); s = repl(s, "\342\200\215", "")
    s = repl(s, "\342\201\240", ""); s = repl(s, "\357\273\277", "")             # zero-width, joiners, BOM
    s = repl(s, "\342\200\246", "...")                                           # an ellipsis, typed or one glyph
    gsub(/[ \t]+/, " ", s); sub(/^ /, "", s); sub(/ $/, "", s)
    return s
  }
  function loose(s) { gsub(/[*_`]/, "", s); gsub(/ +/, " ", s); return tolower(s) }  # capitals, ** and ` marks too
  function lastidx(s, x,   i, pos, base) {
    pos = 0; base = 0
    while ((i = index(s, x)) > 0) { pos = base + i; base += i + length(x) - 1; s = substr(s, i + length(x)) }
    return pos
  }
  function found(r, q,   s, p, off) {                # q inside r as whole words: "port" never matches "export"
    s = r; off = 0
    while ((p = index(s, q)) > 0) {
      if ((off + p == 1 || !alnum(substr(r, off + p - 1, 1))) && !alnum(substr(r, off + p + length(q), 1))) return 1
      off += p; s = substr(r, off + 1)
    }
    return 0
  }
  FILENAME == ENVIRON["REQF"] { r = r $0; next }
  {
    if (!folded) { R = fold(r); RL = loose(R); folded = 1 }
    line = $0; gsub(/\r/, "", line); gsub(/\t/, " ", line)
    if (line !~ /^[-*+]? *[*_]*C?[0-9]+[a-z]?[*_]*\.? +(·|\|) /) next
    t = line; sub(/^[-*+]? */, "", t)
    k = (index(t, "·") ? split(t, fld, / +· +/) : split(t, fld, / +\| +/))
    n = fld[1]; gsub(/[*_.]/, "", n)
    # A request part: its third field reads "ask"; in a post-game, every must or should line is one.
    part = (tolower(fld[3]) == "ask") || (ENVIRON["MODE"] == "council-postgame" && tolower(fld[2]) ~ /^(must|should)$/)
    if (k < 4 || !part) next
    # The last "quote:" that opens a quote, however it is introduced ("· quote:", "— quote:",
    # "(quote:"). A title may say "Quote:" too, so the word must start a quote to count.
    lo = tolower(line); p = 0; s = lo; off = 0
    while ((i = index(s, "quote:")) > 0) {
      at = off + i; b = (at == 1) ? "" : substr(lo, at - 1, 1)
      r = substr(lo, at + 6); sub(/^[ \t]+/, "", r)
      if (b !~ /[a-z0-9]/ && (substr(r, 1, 1) == "\"" || substr(r, 1, 3) == "\342\200\234")) p = at
      off = at; s = substr(lo, off + 1)
    }
    if (!p) { printf "%s\tNO-QUOTE\n", n; next }
    q = substr(line, p + length("quote:")); sub(/^ +/, "", q); e = 0
    if (substr(q, 1, 1) == "\"") { q = substr(q, 2); e = lastidx(q, "\"") }
    else if (substr(q, 1, 3) == "\342\200\234") { q = substr(q, 4); e = lastidx(q, "\342\200\235") }
    else { printf "%s\tNO-QUOTE\n", n; next }
    if (e) q = substr(q, 1, e - 1)
    raw = q; q = fold(q)
    if (q == "") st = "NO-QUOTE"
    else if (split(q, wd, " ") < 3 && q != R) st = "TOO-SHORT"
    else if (found(R, q)) st = "ok"
    else if (found(RL, loose(q))) st = "NOT-EXACT (only capitals or * _ ` marks differ — copy the words exactly)"
    else st = "NOT-IN-THE-REQUEST"
    printf "%s\t%s\t%s\n", n, st, raw
  }' "$req" "$f" 2>/dev/null)
QUOTES
  done
  rm -f "$req"
  # council-implement: every fix's own proof, checked rather than taken on trust.
  if [ "$(field mode "$run/session-state.md")" = council-implement ]; then
    for bf in "$run"/gates/before-*.json; do
      [ -f "$bf" ] || continue
      pn="${bf##*/}"; pn="${pn%.json}"; pn="${pn#before-}"
      af="$run/gates/after-$pn.json"
      bex="$(gate_exit "$bf")"; bcmd="$(gate_cmd "$bf")"
      proofs=$((proofs + 1)); note="-"; tp=""
      if [ ! -f "$af" ]; then
        st="NO-AFTER"
      else
        aex="$(gate_exit "$af")"; acmd="$(gate_cmd "$af")"
        if [ "${bex:-0}" -eq 0 ] 2>/dev/null; then st="BEFORE-PASSED"
        elif [ "${aex:-1}" -ne 0 ] 2>/dev/null; then st="AFTER-FAILED"
        elif [ -n "$acmd" ] && [ -n "$bcmd" ] && [ "$acmd" != "$bcmd" ]; then st="DIFFERENT-COMMAND"
        else st=ok
        fi
        tp="$(gate_test_path "$top" "${acmd:-$bcmd}")" || tp=""
        if [ -n "$tp" ]; then note="test saved: $tp"; else note="couldn't confirm a saved test"; fi
      fi
      rows=$((rows + 1))
      if [ "$st" = ok ]; then
        [ -z "$tp" ] || saved=$((saved + 1))       # only a proof that held counts as a test kept
      else
        bad=$((bad + 1)); broke=$((broke + 1))
      fi
      printf '| task %s | proof | %s | %s |\n' "$pn" "$st" "$note" >> "$out"
      say "task $pn  proof  $st · $note"
    done
    for af in "$run"/gates/after-*.json; do        # an after-check with nothing before it proves nothing
      [ -f "$af" ] || continue
      pn="${af##*/}"; pn="${pn%.json}"; pn="${pn#after-}"
      [ ! -f "$run/gates/before-$pn.json" ] || continue
      proofs=$((proofs + 1)); rows=$((rows + 1)); bad=$((bad + 1)); broke=$((broke + 1))
      printf '| task %s | proof | %s | %s |\n' "$pn" "NO-BEFORE" "-" >> "$out"
      say "task $pn  proof  NO-BEFORE · nothing showed the problem first"
    done
    if [ "$proofs" -eq 0 ]; then
      bad=$((bad + 1))
      say "check: NO PROOF — this build recorded no before-and-after evidence (council gate before-<n> -- '<check>', then after-<n>)"
    else
      say "check: $((proofs - broke)) of $proofs fix(es) proved · $broke broken · $saved left a test behind in the project"
    fi
  fi
  if [ "$files" -eq 0 ] && [ "$gone" -eq 0 ] && [ "$mode" != council-implement ]; then
    other=$((other + 1)); say "check: nothing to check — no synthesis.md and no seat files"
  fi
  if [ "$qn" -eq 0 ] && [ "$mode" = council-postgame ]; then
    bad=$((bad + 1)); say "check: no quotes found — each part of a post-game quotes the request (quote: \"…\")"
  fi
  if [ "$qn" -gt 0 ] && [ "$proofs" -gt 0 ]; then what="(citations, quotes and proof)"
  elif [ "$qn" -gt 0 ]; then what="(citations and quotes)"
  elif [ "$proofs" -gt 0 ]; then what="(citations and proof)"
  else what="citation(s)"
  fi
  [ "$noline" -eq 0 ] || extra="$extra · $noline name a path but no line"
  [ "$unchecked" -eq 0 ] || extra="$extra · $unchecked not checked (a command, a link, an area or no path)"
  [ "$unreadt" -eq 0 ] || extra="$extra · $unreadt item line(s) check can't read"
  [ "$empty" -eq 0 ] || extra="$extra · $empty section(s) with nothing to check"
  if [ "$qn" -gt 0 ]; then
    say "check: $rows items, $bad broken $what$extra · $qok of $qn quotes found in the request → $out"
  else
    say "check: $rows items, $bad broken $what$extra → $out"
  fi
  [ "$((bad + other))" -eq 0 ]
}

# ------------------------------------------------------------------------------------------------
# Map and drift
# ------------------------------------------------------------------------------------------------

cmd_map() {
  local home map sha behind
  [ "${1:-}" = status ] || die "usage: council map status"
  home="$(council_home)"; map="$home/map.md"
  [ -f "$map" ] || { say "no map yet — council-init builds .council/map.md"; return 0; }
  sha="$(sed -n 's/^map-commit:[[:space:]]*\([0-9a-fA-F]\{7,40\}\).*/\1/p' "$map" | head -n 1)"
  [ -n "$sha" ] || { say "map.md has no map-commit stamp — refresh the map and stamp it"; return 0; }
  git cat-file -e "$sha^{commit}" 2>/dev/null || { say "map-commit $sha isn't in this repo's history — rebuild the map"; return 0; }
  behind="$(git rev-list --count "$sha..HEAD" 2>/dev/null)"
  if [ "${behind:-0}" -eq 0 ]; then say "map: up to date (map-commit $(printf '%.9s' "$sha"))"; return 0; fi
  say "map: $behind commits behind HEAD (map-commit $(printf '%.9s' "$sha")). Files changed since, by area:"
  # The whole repository, from any folder (paths are printed from the top).
  git -c core.quotePath=false -c diff.relative=false diff --name-only "$sha" HEAD 2>/dev/null | grep -v '^\.council/' \
    | awk -F/ '{ a = (NF > 1 ? $1 "/" : $1); c[a]++ } END { for (k in c) printf "  %4d  %s\n", c[k], k }' | sort -rn | head -n 12
}

# The config's Roster table as rows: slug seat reference ("-" for an empty value). Columns are found
# by their header names.
roster_rows() {
  awk -F'|' '
    function trim(s) { gsub(/^[ \t\r]+|[ \t\r]+$/, "", s); gsub(/[`*]/, "", s); return s }
    /^## / { inr = ($0 ~ /^## Roster/); hdr = 0; next }
    inr && /^\|/ {
      if (!hdr) {
        hdr = 1; cs = 2; cl = 0; cr = 0
        for (i = 2; i < NF; i++) { h = tolower(trim($i)); if (h == "seat") cs = i; else if (h == "slug") cl = i; else if (h == "reference") cr = i }
        next
      }
      seat = trim($cs); slug = cl ? trim($cl) : ""; ref = cr ? trim($cr) : ""
      if (seat == "" || seat ~ /^:?-+:?$/ || seat ~ /^</) next
      if (slug ~ /^</) slug = ""
      if (ref ~ /^</ || ref ~ /^:?-+:?$/) ref = ""
      printf "%s\t%s\t%s\n", (slug == "" ? "-" : slug), seat, (ref == "" ? "-" : ref)
    }' "$1" 2>/dev/null
}

# A roster or card reference as a file path: references/… is in the plugin, anything else in the repo ($2).
ref_path() {
  case "$1" in
    references/*) printf '%s/%s' "$COUNCIL_PLUGIN_ROOT" "$1" ;;
    /*|[A-Za-z]:*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$2" "$1" ;;
  esac
}

cmd_doctor() {
  local home root cfg errs=0 warns=0 refs slug seat ref p card src dups gates g gc gat gm gk gchk gside gneeds ghk ghas gst gmd gck dir mode phase croot upd status actual ptr mem size pend stale fp map sha behind rows unk alt k orph skipped i
  home="$(council_home)"; root="$(dirname "$home")"
  finding() {
    printf '%s  %s\n       Fix: %s\n' "$1" "$2" "$3"
    if [ "$1" = ERROR ]; then errs=$((errs + 1)); else warns=$((warns + 1)); fi
  }
  if [ ! -d "$home" ]; then finding ERROR "no council home at $home" "run council-init in this repo"; say "doctor: 1 error(s), 0 warning(s)"; return 1; fi
  cfg="$home/council.config.md"
  if [ ! -f "$cfg" ]; then
    finding ERROR "no council.config.md" "run council-init"
  else
    grep -q '^last-verified:' "$cfg" || finding WARN "the config has no last-verified stamp (an older layout)" "run council-init refresh to migrate it to the current template"
    refs="$(roster_rows "$cfg")"
    if [ -z "$refs" ]; then
      finding WARN "couldn't read a Roster table in council.config.md" "run council-init refresh (older configs list seats instead of a table)"
    else
      [ -d "$home/cards" ] || finding WARN "no seat cards yet (.council/cards/ is missing)" "a council-init refresh writes one per seat — workers read them instead of the generic docs"
      while IFS="$TAB" read -r slug seat ref; do
        [ -n "$seat" ] || continue
        case "$ref" in
          none|n/a|-) ;;
          *) [ -f "$(ref_path "$ref" "$root")" ] || finding ERROR "seat '$seat' points at a reference doc that doesn't exist: $ref" "restore the doc, or point the seat at another one in council.config.md" ;;
        esac
        if [ "$slug" = "-" ]; then
          finding WARN "seat '$seat' has no slug" "give it a lowercase slug in the roster — it names the seat's file and card"
          continue
        fi
        [ -d "$home/cards" ] || continue
        card="$home/cards/$slug.md"
        if [ ! -f "$card" ]; then
          finding WARN "seat '$seat' has no card (cards/$slug.md)" "council-init refresh writes one from references/templates/seat-card.md"
          continue
        fi
        src="$(field source "$card" | sed 's/[[:space:]]*·.*$//' | tr -d '`')"
        if [ -n "$src" ] && [ ! -f "$(ref_path "$src" "$root")" ]; then
          finding ERROR "the card for '$seat' names a source doc that doesn't exist: $src" "point the card's source: line at the seat's reference doc"
        fi
        [ "$(wc -c < "$card" | tr -d ' ')" -le 8192 ] || finding WARN "the card for '$seat' is over 8 KB" "cut it to one line per principle — the full doc holds the detail"
      done <<REFS
$refs
REFS
      dups="$(printf '%s\n' "$refs" | cut -f1 | grep -v '^-$' | sort | uniq -d | paste -sd ' ' -)"
      [ -z "$dups" ] || finding ERROR "the roster repeats a slug: $dups" "give each row its own slug — a lens that covers two areas gets two (dodds-web, dodds-admin)"
    fi
    gates="$(config_gates "$cfg")"
    if [ -z "$gates" ]; then
      if grep -qiE '^[-*[:space:]]*guardrails: *declined' "$cfg" 2>/dev/null; then    # the user's own choice, first
        finding WARN "no gates in council.config.md (guardrails declined) — every council report on this project says NOTHING WAS CHECKED" "delete the 'guardrails: declined' line and run a council-init refresh whenever you want them fitted"
      elif gates_listed "$cfg"; then
        finding ERROR "the Gates section is in an older layout (a list, not a table), so no gate can run — every council report on this project says NOTHING WAS CHECKED until it is migrated" "run a council-init refresh — it moves the listed commands into the Gates table; there is nothing to add by hand"
      else
        finding ERROR "no gates in council.config.md — every council report on this project says NOTHING WAS CHECKED" "add the project's real test / lint / build commands (a council-init refresh detects them, and offers the ones you are missing)"
      fi
    else
      while IFS="$TAB" read -r g gc gat gm gk gchk gside gneeds ghk ghas gst gmd gck; do
        [ -n "$g" ] || continue
        if [ "$gk" != "$ghk" ]; then
          finding WARN "gate '$g' has $gk cells where the header has $ghk — the columns have shifted (an unescaped pipe?)" "wrap the command in backticks and escape any pipe as \\|, or remove it"
        fi
        case "$gc" in *'|'*) finding WARN "gate '$g' pipes its output — its exit code may not be the test runner's" "remove the pipe from that command in council.config.md" ;; esac
        if gate_backslash "$gc"; then
          finding WARN "gate '$g' $(backslash_note)" "gate commands run under bash (Git Bash on Windows): write tools/run.ps1, or put the path in quotes"
        fi
        if gate_winswitch "$gc"; then
          finding WARN "gate '$g' $(winswitch_note)" "write the switch with a dash (-p:Configuration=Release), or as //p:… for a tool that only takes a slash"
        fi
        [ "$gk" = "$ghk" ] || continue       # a shifted row's other cells mean nothing
        case "$gst" in
          *'?'*) finding WARN "gate '$g' has a Run at value that names no stage: '$gat'" "write grounding, verify, both or manual — anything else is left out of council gate --all --at …" ;;
          -)     finding WARN "gate '$g' has an empty Run at cell, so it runs in no set" "write grounding, verify, both or manual" ;;
        esac
        [ "$gmd" != '?' ] || finding WARN "gate '$g' has a Mandatory value that isn't yes or no: '$gm' — it counts as mandatory" "write yes or no"
        [ "$gck" != '?' ] || finding WARN "gate '$g' has a Checked value that isn't ✓ or ✗: '$gchk'" "write ✓ <date> once it has run cleanly here, or ✗ <date>: <why it can't>"
      done <<GATES
$gates
GATES
      # The same has-column answer gate --all uses, so the two can never disagree about a header.
      [ "$(printf '%s\n' "$gates" | awk -F"$TAB" 'NR == 1 { print $10 }')" = 1 ] \
        || finding WARN "the Gates table has no Side effects column (an older layout)" "a council-init refresh adds Probe, Needs and Side effects — until then council gate --all runs none of its gates unasked"
    fi
  fi
  local stale_runs rsess
  stale_runs="$NL$(find "$home/runs" -mindepth 2 -maxdepth 2 -name session-state.md -mtime +2 2>/dev/null)$NL"   # one pass
  while IFS="$TAB" read -r dir mode phase croot upd status actual rsess; do
    [ -n "$dir" ] || continue
    case "$stale_runs" in
      *"$NL$dir/session-state.md$NL"*)
        finding WARN "run ${dir##*/} ($(mode_skill "$(undash "$mode")"), phase $phase) has been open since $upd" "resume it (council run resume --run ${dir##*/}), or: council run close --run \"$dir\" --status abandoned" ;;
    esac
  done <<RUNS
$(list_runs "$home" 1000000 open)
RUNS
  ptr="$home/active-run"
  if [ -s "$ptr" ]; then
    p="$(head -n 1 "$ptr" | tr -d '\r')"
    case "$p" in /*|[A-Za-z]:*) ;; *) p="$root/$p" ;; esac
    if [ -f "$p/session-state.md" ]; then
      case "$(field status "$p/session-state.md")" in
        complete*|abandoned*) finding WARN "active-run still points at a closed run" "empty .council/active-run (0.3 doesn't use it)" ;;
        *) finding WARN "an older run is still marked open: $p" "resume it, or: council run close --run \"$p\" --status abandoned" ;;
      esac
    else
      finding WARN "active-run points at a folder that no longer exists: $p" "empty .council/active-run"
    fi
  fi
  memory_file "$home"; mem="$MEM"
  if [ -f "$mem" ]; then
    [ -z "$MEM_NOTE" ] || finding WARN "$MEM_NOTE" "point the '- conventions:' line under ## Memory in council.config.md at ${mem#"$root"/}"
    rows="$(memory_entries "$mem")"
    if [ -z "$rows" ] && [ "$(memory_idlines "$mem")" -gt 0 ]; then
      finding WARN "memory ($mem) names entry ids, but no entry could be read — nothing in it reaches a seat or a builder" "write each entry as a heading (### AP-1: title) or a bullet (- **AP-1 — title** …), as the plugin's references/templates/conventions.md shows"
    fi
    unk="$(printf '%s\n' "$rows" | awk -F'\t' '$5 == "unknown" { n++ } END { print n + 0 }')"
    [ "$unk" -eq 0 ] || finding WARN "$unk memory entr(ies) sit under a section the council doesn't read as settled, so they never reach a brief (council memory lists them)" "move them under Accepted Patterns, Enforced Conventions or Decisions — or under ## Retired if they no longer hold"
    skipped="$(MEM_SKIP=1 memory_entries "$mem")"
    [ -z "$skipped" ] || finding WARN "memory has line(s) that open like an entry but are not read, so they reach no brief: $skipped" "write each as a heading (### AP-1: title) or a bullet (- **AP-1 — title** …), as references/templates/conventions.md shows"
    inplace="$(printf '%s\n' "$rows" | awk -F'\t' '$5 == "off" && $6 == "marked retired" { n++ } END { print n + 0 }')"
    [ "$inplace" -eq 0 ] || finding WARN "$inplace memory entr(ies) under a settled section are marked retired, so no brief sees them (council memory lists them)" "if they still hold, drop the retired mark; if not, move them under ## Retired"
    [ -z "$MEM_ALT" ] || finding WARN "a second memory file, $MEM_ALT, holds $MEM_ALT_N entries the council never reads (it reads $mem)" "merge the two, or point the '- conventions:' line under ## Memory in council.config.md at the one to keep"
    stale="$(cmd_memory check 2>/dev/null | grep -c '^STALE' || true)"
    [ "${stale:-0}" -eq 0 ] || finding WARN "$stale memory anchor(s) point at code that moved or no longer exists" "council memory check lists them; propose re-anchoring or retiring each at the next Learn"
    orph="$(cmd_memory index 2>/dev/null | grep -c 'matches no file, seat or mode' || true)"
    [ "${orph:-0}" -eq 0 ] || finding WARN "$orph memory scope item(s) match no file, seat or mode (an entry still reaches a brief through its other scope items, if it has any)" "council memory lists them — correct each path or slug, or drop the ones whose folder is gone"
    size="$(wc -c < "$mem" | tr -d ' ')"
    [ "$size" -le 25600 ] || finding WARN "memory is $(( size / 1024 )) KB — past the ~25 KB every run reads" "at the end of the next run, propose a consolidation (merge duplicates, retire superseded entries)"
    pend="$(grep -c '^- PROPOSED' "$mem" 2>/dev/null)"
    pend=$(( ${pend:-0} + $(printf '%s\n' "$rows" | awk -F'\t' '$5 == "off" && tolower($6) ~ /^[#* ]*propos/ { n++ } END { print n + 0 }') ))
    [ "$pend" -eq 0 ] || finding WARN "$pend memory proposal(s) await the user's yes/no" "raise them at the next natural pause"
  elif [ -n "$MEM_CONF" ]; then
    finding WARN "no memory file: the config names $MEM_CONF, which doesn't exist" "if the memory lives elsewhere, point the '- conventions:' line under ## Memory at it; otherwise council-init creates it"
  else
    finding WARN "no memory file found" "council-init creates .council/conventions.md"
  fi
  map="$home/map.md"
  if [ -f "$map" ]; then
    sha="$(sed -n 's/^map-commit:[[:space:]]*\([0-9a-fA-F]\{7,40\}\).*/\1/p' "$map" | head -n 1)"
    if [ -n "$sha" ] && git rev-parse --git-dir >/dev/null 2>&1 && ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      finding WARN "map-commit $(printf '%.9s' "$sha") isn't in this repo's history (a rebase or squash removed it), so nobody can tell what changed since" "rebuild the map with a council-init refresh, and stamp the new map-commit"
    elif [ -n "$sha" ]; then
      behind="$(git rev-list --count "$sha..HEAD" 2>/dev/null)"
      [ "${behind:-0}" -le 50 ] 2>/dev/null || finding WARN "the map is $behind commits behind HEAD" "refresh the changed areas (council map status lists them)"
    else
      finding WARN "map.md has no map-commit stamp" "refresh the map and stamp map-commit"
    fi
  else
    finding WARN "no map.md" "council-init builds it"
  fi
  if [ -f "$cfg" ] && git rev-parse --git-dir >/dev/null 2>&1; then
    fp="$(cmd_fingerprint check 2>/dev/null)"
    case "$fp" in
      "fingerprint: the stack changed"*) fp="${fp#fingerprint: }"; finding WARN "${fp%. Suggest*}" "run a council-init refresh — it re-checks the roster, cards and gates against the new stack" ;;
      "no stack-fingerprint"*) finding WARN "the config has no stack-fingerprint" "a council-init refresh records one, so a changed stack gets noticed" ;;
    esac
  fi
  home_ignores "$home" runs/x || finding WARN ".council/.gitignore doesn't ignore runs/" "add a line 'runs/' to .council/.gitignore"
  if ! home_ignores "$home" asks/x && ! asks_shared "$home"; then
    finding WARN ".council/.gitignore doesn't ignore asks/ — the user's own words would be committed" "the next council run open adds 'asks/'; if the team shares requests on purpose, write '!asks/' instead"
  fi
  say "doctor: $errs error(s), $warns warning(s)"
  [ "$errs" -eq 0 ]
}

# ------------------------------------------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# Stack fingerprint
# ------------------------------------------------------------------------------------------------

# "manifests: a, b · languages: x, y": build manifests up to two folders deep, and the code languages
# with at least 3 tracked files. Everyday edits don't move it; a new language or build system does.
stack_summary() {
  local files man lang
  files="$(cd "$(council_toplevel)" 2>/dev/null && git -c core.quotePath=false ls-files 2>/dev/null)"   # the whole repo, from any folder
  man="$(printf '%s\n' "$files" | awk -F/ 'NF <= 3 { print $NF }' | grep -x -E \
    'package\.json|deno\.json|tsconfig\.json|pyproject\.toml|requirements\.txt|setup\.py|Pipfile|environment\.yml|go\.mod|Cargo\.toml|pom\.xml|build\.gradle(\.kts)?|settings\.gradle(\.kts)?|Gemfile|composer\.json|mix\.exs|rebar\.config|pubspec\.yaml|Package\.swift|project\.pbxproj|Podfile|project\.godot|ProjectVersion\.txt|.*\.uproject|CMakeLists\.txt|meson\.build|Makefile|west\.yml|platformio\.ini|Dockerfile|compose\.ya?ml|docker-compose\.ya?ml|.*\.csproj|.*\.fsproj|.*\.sln|.*\.tf|flake\.nix|BUILD(\.bazel)?|WORKSPACE' \
    | sed -E 's/.*\.(tf|csproj|fsproj|sln|uproject)$/*.\1/' | LC_ALL=C sort -u | paste -sd ',' - | sed 's/,/, /g')"
  lang="$(printf '%s\n' "$files" | sed -n 's/.*\.\([A-Za-z0-9+]\{1,10\}\)$/\1/p' | tr 'A-Z' 'a-z' | grep -x -E \
    'py|pyx|ipynb|ts|tsx|js|jsx|mjs|cjs|vue|svelte|go|rs|java|kt|kts|scala|clj|groovy|swift|m|mm|c|h|cc|cpp|cxx|hh|hpp|cs|fs|vb|rb|php|ex|exs|erl|hrl|dart|lua|gd|r|jl|sql|sh|bash|ps1|tf|hcl|proto|graphql|zig|nim|ml|hs|elm|sol|asm|s|ino|glsl|hlsl|wgsl|shader|tscn|nix' \
    | LC_ALL=C sort | uniq -c | awk '$1 >= 3 { print $2 }' | paste -sd ',' - | sed 's/,/, /g')"
  printf 'manifests: %s · languages: %s' "${man:-none}" "${lang:-none}"
}

# Items in summary $1 that summary $2 lacks.
summary_minus() {
  A="$1" B="$2" awk 'BEGIN {
    n = split(ENVIRON["B"], b, /(, | · |: )/); for (i = 1; i <= n; i++) have[b[i]] = 1
    n = split(ENVIRON["A"], a, /(, | · |: )/)
    for (i = 1; i <= n; i++) if (a[i] != "" && a[i] != "manifests" && a[i] != "languages" && a[i] != "none" && !(a[i] in have)) out = out (out ? ", " : "") a[i]
    print out }'
}

cmd_fingerprint() {
  local sum hash cfg line old added removed
  git rev-parse --git-dir >/dev/null 2>&1 || die "the stack fingerprint needs a git repository"
  sum="$(stack_summary)"
  hash="$(printf '%s' "$sum" | git hash-object --stdin | cut -c1-12)"
  if [ "${1:-}" != check ]; then say "stack-fingerprint: $hash — $sum"; return 0; fi
  cfg="$(council_home)/council.config.md"
  line="$(field stack-fingerprint "$cfg")"
  line="${line#stack-fingerprint: }"                 # a pasted line that repeats the key still reads
  if [ -z "$line" ]; then say "no stack-fingerprint in the config — a council-init refresh records one: stack-fingerprint: $hash — $sum"; return 0; fi
  old="${line%% *}"
  if [ "$old" = "$hash" ]; then say "fingerprint: the stack is unchanged since council-init ($hash)"; return 0; fi
  added="$(summary_minus "$sum" "${line#* — }")"; removed="$(summary_minus "${line#* — }" "$sum")"
  say "fingerprint: the stack changed since council-init — added: ${added:-nothing} · removed: ${removed:-nothing}. Suggest a council-init refresh."
  return 1
}

# ------------------------------------------------------------------------------------------------
# Memory — scoped entries, earlier council work
# ------------------------------------------------------------------------------------------------

# A configured memory path as a path under the repo: "/x" means the repo's root unless that absolute
# file exists, and a relative path hangs off the root.
mem_abs() {
  local root="$1" p="${2//\\//}"
  case "$p" in
    ""|[A-Za-z]:*) ;;
    /*) [ -f "$p" ] || [ ! -f "$root$p" ] || p="$root$p" ;;
    *) p="$root/${p#./}" ;;
  esac
  printf '%s' "$p"
}

# Are these two paths the same file? (The same file may be written C:/x, c:/x or /c/x.)
same_file() { [ "$1" = "$2" ] || [ "$1" -ef "$2" ] 2>/dev/null; }

# The memory file, set in MEM: the "- conventions:" path under the config's ## Memory heading, else
# .council/conventions.md, else a root one. A configured path that doesn't exist gives way to one of
# those that does, and MEM_NOTE says so. MEM_CONF is the configured path, as a path. MEM_ALT names a
# second memory file, with MEM_ALT_N entries, that the council is not reading — nothing a project
# wrote down should sit unread without a word.
memory_file() {
  local home="$1" root alt="" raw full first k
  root="${home%/*}"
  MEM_NOTE=""; MEM_ALT=""; MEM_ALT_N=0
  raw="$(awk '
    /^##[ \t]/ { m = ($0 ~ /^##[ \t]+[Mm][Ee][Mm][Oo][Rr][Yy]([^A-Za-z]|$)/); next }
    m && /^[ \t]*[-*][ \t]*conventions:/ {
      v = $0; sub(/^[ \t]*[-*][ \t]*conventions:[ \t]*/, "", v); gsub(/[\r`"\047]/, "", v)
      sub(/[ \t]+\([^()]*\)[ \t]*$/, "", v)                       # a note after the path
      sub(/[ \t]+(\342\200\224|\342\200\223|-)[ \t].*$/, "", v)
      sub(/[ \t]+$/, "", v); w = v; sub(/[ \t].*$/, "", w)        # a path may hold a blank; a note may follow one
      print v "\t" w; exit
    }' "$home/council.config.md" 2>/dev/null)"
  full="$(mem_abs "$root" "${raw%%"$TAB"*}")"
  first="$(mem_abs "$root" "${raw#*"$TAB"}")"
  [ -n "$raw" ] || { full=""; first=""; }
  MEM_CONF="$full"
  [ -f "$full" ] || [ -z "$first" ] || [ ! -f "$first" ] || MEM_CONF="$first"
  MEM="$MEM_CONF"
  if [ -z "$MEM" ] || [ ! -f "$MEM" ]; then
    if [ -f "$home/conventions.md" ]; then alt="$home/conventions.md"
    elif [ -f "$root/conventions.md" ]; then alt="$root/conventions.md"; fi
    if [ -z "$MEM_CONF" ]; then MEM="${alt:-$home/conventions.md}"
    elif [ -n "$alt" ]; then
      MEM="$alt"; MEM_NOTE="the config's memory path, ${MEM_CONF#"$root"/}, doesn't exist — reading ${alt#"$root"/} instead"
    fi
  fi
  for alt in "$home/conventions.md" "$root/conventions.md"; do
    [ -f "$alt" ] && ! same_file "$alt" "$MEM" || continue
    k="$(memory_entries "$alt" | grep -c . || true)"
    [ "${k:-0}" -eq 0 ] || { MEM_ALT="$alt"; MEM_ALT_N="$k"; break; }
  done
}

# Memory entries as rows: id, title, scope, anchor, state, section ("-" when empty). An entry is a
# heading (## to ####), a top-level bullet or a numbered item whose bold text starts with its id:
# "### AP-3: title", "### **AP-3**: title", "- **AP-3 — title.** text …", "1. **AP-3 — title.**" —
# the id in any case, with or without its dash. Its **Scope:** and **Anchor:** may sit anywhere in its
# body. state is "settled" under Accepted Patterns, Enforced Conventions, Decisions (or a heading that
# says adopted, settled, rulings…) and at the top of the file; "off" under Proposed, Rejected, Retired,
# Superseded… or when the entry is marked retired (a **Retired:** line, a struck-out id); "unknown"
# under any other section. A section name is read by what it calls itself, not by every word in it:
# "## Accepted Patterns — never re-propose these" is settled, and an entry titled "Retired flags stay
# registered" is live. With MEM_SKIP=1 it prints instead the ids of lines that look like entries but
# are not read, so nothing drops out of a memory without a word.
memory_entries() {
  LC_ALL=C awk '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    # A section name: off, settled, or "" (says neither). What the section calls itself — the words
    # before its first aside — decides; an aside only speaks when the name itself says nothing. A
    # sub-heading or a bold label ("### Retired", "**Enforced conventions — always/never.**") is read
    # by its first word alone: a note about a draft never retires the entries beside it.
    function kind(t, strict,   l, h, w, i) {
      l = tolower(t); gsub(/[*_~`#]/, "", l); sub(/^[^a-z0-9]+/, "", l)
      h = l; sub(/[ \t]*(\342\200\224|\342\200\223|-[ \t]|\(|\[|;|:|,).*$/, "", h); h = trim(h)
      if (strict) {
        w = h; sub(/[ \t].*$/, "", w)
        for (i = 1; i <= noff; i++) if (index(w, OFF[i])) return "off"
        if (w ~ /^(ap|ec|d)s?$/) return "settled"
        for (i = 1; i <= nset; i++) if (index(w, SET[i])) return "settled"
        return ""
      }
      for (i = 1; i <= noff; i++) if (index(h, OFF[i])) return "off"
      if (h ~ /^(ap|ec|d)s?$/ || l ~ /\((ap|ec|d)\)/) return "settled"       # "## EC", "## Rules (EC)"
      for (i = 1; i <= nset; i++) if (index(h, SET[i])) return "settled"
      for (i = 1; i <= noff; i++) if (index(l, OFF[i])) return "off"         # only the aside says it
      for (i = 1; i <= nset; i++) if (index(l, SET[i])) return "settled"
      return ""
    }
    function idnorm(s,   t) { t = toupper(s); if (!index(t, "-")) sub(/[0-9]+$/, "-&", t); return t }
    # A line that opens like an entry but is not read as one — a plain bullet, an indented one — so
    # that it can be named rather than dropped.
    function cand(txt, ln,   lo2, rest) {
      lo2 = tolower(txt); sub(/^[*_~`]+/, "", lo2)
      if (!match(lo2, /^(ap|ec|d)-?[0-9]+/)) return
      rest = substr(lo2, RLENGTH + 1)
      if (rest !~ /^[*_~`]*([ \t]*([:.)]|\342\200\224|\342\200\223|-[ \t])|[ \t]*$)/) return
      CID[++ncand] = idnorm(substr(lo2, 1, RLENGTH)); CLN[ncand] = ln
    }
    function flush() {
      if (id != "") {
        READ[id] = 1
        if (!SKIP) printf "%s\t%s\t%s\t%s\t%s\t%s\n", id, (title == "" ? "-" : title), (scope == "" ? "-" : scope),
          (anchor == "" ? "-" : anchor), est, (ewhere == "" ? "-" : ewhere)
      }
      id = ""; pend = 0; bul = 0
    }
    function fieldval(line, name,    v) {
      if (!match(line, "\\*\\*" name ":\\*\\*")) return ""
      v = substr(line, RSTART + RLENGTH); sub(/[ \t]+\302\267[ \t]+\*\*.*$/, "", v)
      gsub(/^[ \t]+|[ \t\r]+$/, "", v); gsub(/`/, "", v); return v
    }
    # A field line of the entry: its scope, its anchor, or a line that retires it. "**Retired:** no"
    # and "**Superseded:** -" retire nothing, and a **Status:** line is read by its first word, so a
    # status of "accepted (proposed 2026-07-01, approved 2026-07-02)" stays accepted.
    function fields(line,   v, lo, w, i) {
      v = fieldval(line, "Scope"); if (v != "") scope = v
      v = fieldval(line, "Anchor"); if (v != "") anchor = v
      lo = tolower(line)
      for (i = 1; i <= nmark; i++) {
        if (!match(lo, "\\*\\*" MARK[i] "( by)?:?\\*\\*:?")) continue
        v = trim(substr(lo, RSTART + RLENGTH)); gsub(/[`*]/, "", v); sub(/[ \t]+\302\267.*$/, "", v); v = trim(v)
        if (v ~ /^(no|none|n\/a|-|false|never|not yet|\342\200\224|\342\200\223)$/) continue
        est = "off"; ewhere = "marked retired"
      }
      v = fieldval(lo, "status")
      if (v != "") { w = v; sub(/[ \t].*$/, "", w); gsub(/[^a-z]/, "", w); if (kind(w) == "off") { est = "off"; ewhere = "marked " v } }
    }
    function cleantitle(t) { gsub(/~~/, "", t); gsub(/[ \t]+/, " ", t); t = trim(t); sub(/[.:]$/, "", t); return t }
    # Is s (a heading text, or a bullet after its dash) an entry? Sets id, title and the entry state.
    function entry(s, bullet,   lo, b, t, rest, dashed, closed, j, mark, lt) {
      lo = tolower(s); b = 0
      while (substr(lo, b + 1, 1) ~ /[*_~]/) b++
      t = substr(lo, b + 1)
      if (!match(t, /^(ap|ec|d)-?[0-9]+/)) return 0
      idt = substr(t, 1, RLENGTH); rest = substr(s, b + RLENGTH + 1)
      dashed = index(idt, "-") > 0
      if (rest ~ /^[A-Za-z0-9_]/ || rest ~ /^-[A-Za-z0-9]/) return 0
      if (!dashed && rest !~ /^([*_~]|[:.)]|[ \t]+(\342\200\224|\342\200\223|-|:)|[ \t]*$)/) return 0
      mark = substr(lo, 1, b)
      if (bullet && mark !~ /\*\*|__/) return 0            # a bullet entry has its id in bold
      flush()
      id = toupper(idt); if (!dashed) sub(/[0-9]+$/, "-&", id)
      bul = bullet; pend = 0; pn = 0; bodyline = 0
      closed = (rest ~ /^[*_~]/); sub(/^[*_~]+/, "", rest)
      sub(/^[ \t]*(\342\200\224|\342\200\223|-|:|\.|\))?[ \t]*/, "", rest)
      if (rest ~ /^(\*\*|__)/) { closed = 1; sub(/^[*_]+[ \t]*/, "", rest) }
      after = ""
      if (mark ~ /\*\*|__/ && !closed) {                   # the bold opened before the id closes after the title
        j = index(rest, "**"); if (!j) j = index(rest, "__")
        if (j) { after = substr(rest, j + 2); rest = substr(rest, 1, j - 1) }
        else if (bullet) { pend = 1; ptitle = rest }       # a bold title that runs on to the next lines
      }
      title = cleantitle(rest)
      scope = ""; anchor = ""
      est = (sub_st != "" ? sub_st : sec); ewhere = (sub_st != "" ? subname : secname)
      lt = tolower(title)
      # A marker, not a word of the title: "(retired 2026-09-01)" at either end, "Retired: …", a
      # struck-out id. "Retired flags stay registered" and "The (retired) v1 route" are titles.
      if (est != "off" && (mark ~ /~~/ \
          || lt ~ /^[(\[](retired|superseded|withdrawn)/ \
          || lt ~ /^(retired|superseded|withdrawn)[ \t]*[-:.\342\200\224\342\200\223]/ \
          || lt ~ /[(\[](retired|superseded|withdrawn)[^)\]]*[)\]][ \t]*$/)) { est = "off"; ewhere = "marked retired" }
      if (bullet) fields(after)
      return 1
    }
    BEGIN {
      SKIP = (ENVIRON["MEM_SKIP"] != "")
      noff = split("propos reject retire supersede deprecat withdraw obsolete archived pending draft declined revoked", OFF, " ")
      nset = split("accepted enforced decision convention pattern adopted settled ruling", SET, " ")
      nmark = split("retired superseded withdrawn", MARK, " ")
      sec = "settled"; secname = ""; sub_st = ""; sublvl = 0; subname = ""; elvl = 0
    }
    { line = $0; sub(/\r$/, "", line); if (FNR == 1) sub(/^\357\273\277/, "", line) }
    incom { if (index(line, "-->")) incom = 0; next }
    line ~ /^[ \t]*<!--/ { if (!index(line, "-->")) incom = 1; next }
    line ~ /^[ \t]*(```|~~~)/ { fence = !fence; next }
    fence { next }
    line ~ /^#+[ \t]/ {
      lvl = 0; while (substr(line, lvl + 1, 1) == "#") lvl++
      txt = trim(substr(line, lvl + 1))
      if (lvl >= 2 && lvl <= 4 && entry(txt, 0)) { elvl = lvl; anyhead = 1; next }
      if (id != "" && !bul && lvl > elvl) { fields(line); bodyline = 1; next }   # a sub-heading inside an entry
      flush()
      k = kind(txt, lvl > 2); name = substr(line, 1, lvl) " " txt
      if (lvl <= 2) {
        if (lvl == 1 && !anyhead) sec = "settled"                    # the file title never retires it
        else sec = (k == "" ? "unknown" : k)
        secname = name; sub_st = ""; sublvl = 0
      } else if (k != "") { sub_st = k; sublvl = lvl; subname = name }
      else if (sub_st != "" && lvl <= sublvl) sub_st = ""
      anyhead = 1
      next
    }
    line ~ /^[-*+][ \t]/ {
      txt = line; sub(/^[-*+][ \t]+/, "", txt)
      # A bullet right under the title of a heading entry is an entry of its own; once that entry has
      # a body, its bullets belong to it — they are the rules it points at, not new entries.
      if (id != "" && !bul && bodyline) { cand(txt, FNR); fields(line); next }
      if (entry(txt, 1)) next
      cand(txt, FNR)
      if (bul) flush(); else if (id != "") fields(line)   # another top-level bullet ends a bullet entry
      next
    }
    line ~ /^[0-9]+[.)][ \t]/ {                          # "1. **AP-3 — title.**" is an entry too
      txt = line; sub(/^[0-9]+[.)][ \t]+/, "", txt)
      if ((id == "" || bul) && entry(txt, 1)) next
      cand(txt, FNR)
      if (id != "") fields(line)
      next
    }
    line ~ /^[ \t]+([-*+]|[0-9]+[.)])[ \t]/ {            # an indented bullet is never an entry: say so
      txt = line; sub(/^[ \t]+([-*+]|[0-9]+[.)])[ \t]+/, "", txt)
      cand(txt, FNR)
      if (id != "") fields(line)
      next
    }
    line ~ /^(\*\*|__)[^*_]/ && (id == "" || bul) {          # a bold line used as a heading
      t = line; sub(/[ \t]+$/, "", t)
      if ((t ~ /^\*\*[^*]+\*\*[.:]?$/ || t ~ /^__[^_]+__[.:]?$/) && t !~ /:(\*\*|__)[.:]?$/) {
        txt = substr(t, 3); sub(/(\*\*|__)[.:]?$/, "", txt); k = kind(txt, 1)
        if (k != "") { flush(); sub_st = k; sublvl = 5; subname = t; next }
      }
    }
    pend {
      j = index(line, "**"); if (!j) j = index(line, "__")
      if (j) { title = cleantitle(ptitle " " substr(line, 1, j - 1)); pend = 0; fields(substr(line, j + 2)); next }
      if (++pn >= 3 || line ~ /^[ \t]*$/) pend = 0; else ptitle = ptitle " " line
    }
    id != "" { fields(line); if (line ~ /[^ 	]/) bodyline = 1 }
    END {
      flush()
      if (!SKIP) exit
      for (i = 1; i <= ncand; i++)
        if (!(CID[i] in READ) && !(CID[i] in said)) { said[CID[i]] = 1; out = out (out == "" ? "" : ", ") CID[i] " (line " CLN[i] ")" }
      if (out != "") print out
    }' "$1" 2>/dev/null
}

# How many lines of a memory file (outside comments) name an entry id — to tell a file with no entries
# yet from one whose entries the council can't read.
memory_idlines() {
  LC_ALL=C awk '
    incom { if (index($0, "-->")) incom = 0; next }
    /^[ \t]*<!--/ { if (!index($0, "-->")) incom = 1; next }
    /(^|[^A-Za-z0-9_])(AP|EC|D)-[0-9]+([^A-Za-z0-9_]|$)/ || /^(#+|[-*+])[ \t]*[*_]*([Aa][Pp]|[Ee][Cc]|D)-?[0-9]+/ { n++ }
    END { print n + 0 }' "$1" 2>/dev/null
}

# The loud line for a memory file whose entries the council can't read — the whole file, or single
# lines that open like an entry (a plain bullet, an indented one) — or nothing when all of it reads.
memory_unread() {
  local skipped
  if [ -z "$(memory_entries "$1")" ]; then
    [ "$(memory_idlines "$1")" -gt 0 ] || return 0
    say "memory: WARNING — $1 names entry ids, but no entry could be read, so nothing in it reaches a seat or a builder. Write each entry as a heading (### AP-1: title) or a bullet (- **AP-1 — title** …), as references/templates/conventions.md shows."
    return 0
  fi
  skipped="$(MEM_SKIP=1 memory_entries "$1")"
  [ -n "$skipped" ] || return 0
  say "memory: WARNING — $1 has line(s) that open like an entry but are not read, so they reach no seat: $skipped. Write each entry as a heading (### AP-1: title) or a bullet (- **AP-1 — title** …), as references/templates/conventions.md shows."
}

# The awk that matches paths and slugs to scope items and areas. items() splits a list at commas and
# semicolons outside braces (and at blanks when every piece looks like a path), drops ./, a leading /,
# backticks, quotes and a trailing note; covers(k, g) is true when key k is g, sits inside folder g, or
# matches glob g — {a,b} is either, **/ may match no folder, and a single * matches STAR (a regex). A
# glob with brackets is tried both as a character class and as literal brackets (app/[id]/**).
AWK_SCOPE='
function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
function normp(x) {
  gsub(/[`"\047]/, "", x); gsub(/\\/, "/", x); x = trim(x)
  sub(/^[Rr][Ee][Ss]:\/\//, "", x)                    # a Godot res:// path names the same file
  while (substr(x, 1, 2) == "./") x = substr(x, 3)
  sub(/^\/+/, "", x); sub(/[.]+$/, "", x); sub(/\/+$/, "", x)
  return x
}
# One scope or areas item. Blank-separated paths ("docs/** webapp/**") are separate items, but a path
# may hold a blank too ("docs/My Notes/**"), and nothing in the text says which: both readings are
# kept, the whole in IWHOLE and its pieces in IPIECE, so a match either way counts and only an item
# that matches under neither reading is ever called an orphan. A quoted item is never split.
function additem(x, out, n,   m, j, p, ok, quoted, w) {
  x = trim(x); quoted = (x ~ /^[`"\047].*[`"\047]$/)
  sub(/[ \t]+\([^()]*\)$/, "", x); sub(/[ \t]+(\342\200\224|\342\200\223|-)[ \t].*$/, "", x)
  if (!quoted && x ~ /[ \t]/) {
    m = split(x, p, /[ \t]+/); ok = 1
    for (j = 1; j <= m; j++) if (p[j] !~ /[\/*]/) ok = 0
    if (ok) {
      w = normp(x); if (w != "") { out[++n] = w; IWHOLE[n] = 1; wn = n }
      for (j = 1; j <= m; j++) if ((p[j] = normp(p[j])) != "") { out[++n] = p[j]; IPIECE[n] = wn }
      return n
    }
  }
  x = normp(x); if (x != "") { out[++n] = x; IWHOLE[n] = 0; IPIECE[n] = 0 }
  return n
}
function items(s, out,   n, i, c, d, cur) {
  n = 0; d = 0; cur = ""; wn = 0; split("", IWHOLE); split("", IPIECE)
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "{") d++; else if (c == "}" && d) d--
    if ((c == "," || c == ";") && !d) { n = additem(cur, out, n); cur = "" } else cur = cur c
  }
  return additem(cur, out, n)
}
function expand(g, out, n,   i, c, d, s, e, alts, na, k, body, cur) {
  s = 0; e = 0; d = 0
  for (i = 1; i <= length(g); i++) {
    c = substr(g, i, 1)
    if (c == "{") { if (!d) s = i; d++ }
    else if (c == "}" && d) { d--; if (!d) { e = i; break } }
  }
  if (!s || !e || n >= 64) { out[++n] = g; return n }
  body = substr(g, s + 1, e - s - 1); na = 0; d = 0; cur = ""
  for (i = 1; i <= length(body); i++) {
    c = substr(body, i, 1)
    if (c == "{") d++; else if (c == "}") d--
    if (c == "," && !d) { alts[++na] = cur; cur = "" } else cur = cur c
  }
  alts[++na] = cur
  if (na < 2) { out[++n] = g; return n }
  for (k = 1; k <= na; k++) n = expand(substr(g, 1, s - 1) alts[k] substr(g, e + 1), out, n)
  return n
}
function glob_re(g, star, lit,   r, i, c, j, cls) {
  r = ""; i = 1
  while (i <= length(g)) {
    if (substr(g, i, 3) == "**/") { r = r "(.*/)?"; i += 3; continue }
    if (substr(g, i, 2) == "**") { r = r ".*"; i += 2; continue }
    c = substr(g, i, 1)
    if (c == "[" && !lit && (j = index(substr(g, i + 1), "]")) > 1 && substr(g, i + 1, j - 1) ~ /^!?[A-Za-z0-9_.-]+$/) {
      cls = substr(g, i + 1, j - 1); sub(/^!/, "^", cls); r = r "[" cls "]"; i += j + 1; continue
    }
    if (c == "*") r = r star
    else if (c == "?") r = r (star == ".*" ? "." : "[^/]")
    else if (index("\\^$.[]|()+{}", c)) r = r "\\" c
    else r = r c
    i++
  }
  return "^" r "$"
}
function prep(g, star,   E, n, i, c) {              # the expansions and regexes of g, once
  c = star SUBSEP g
  if (c in NX) return c
  n = expand(g, E, 0); NX[c] = n
  for (i = 1; i <= n; i++) {
    XG[c, i] = E[i]; XR[c, i] = (E[i] ~ /[*?\[]/) ? glob_re(E[i], star, 0) : ""
    XL[c, i] = (index(E[i], "[") && XR[c, i] != "") ? glob_re(E[i], star, 1) : ""
  }
  return c
}
function covers(k, g, star, dir,   i, e, c) {
  if (k == g || index(k, g "/") == 1) return 1
  if (dir && index(g, k "/") == 1) return 1           # a folder key: the scope sits inside it
  c = prep(g, star)
  for (i = 1; i <= NX[c]; i++) {
    e = XG[c, i]
    if (k == e || index(k, e "/") == 1) return 1
    if (XR[c, i] == "") continue
    if (k ~ XR[c, i] || (dir && (k "/") ~ XR[c, i])) return 1
    if (XL[c, i] != "" && (k ~ XL[c, i] || (dir && (k "/") ~ XL[c, i]))) return 1
  }
  return 0
}
function everyrun(s,   l) {                         # a scope that means every run
  l = tolower(trim(s)); gsub(/[.`]/, "", l)
  return l ~ /^(all|all files|everywhere|every run|always|global|any|repo-wide|project-wide|whole repo|none|n\/a|\(none\)|\*|\*\*|-|\342\200\224|\342\200\223)$/
}
'

# The changed files listed in a run's change index, one per line.
index_paths() { sed -n 's/^## \(.*\)  (.*$/\1/p' "$1/index.md" 2>/dev/null; }

# One item per line from a comma-separated list, trimmed.
split_list() { printf '%s\n' "$1" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'; }

# Every anchor of the memory entries on stdin, as rows the check can work through in one pass:
#   <id> <anchor> C <path> <lines>   a file and the lines it names
#   <id> <anchor> F <path>           a file (it has a folder in it)
#   <id> <anchor> X <name>           a file, or a name written with dots (process.env, request.json)
#   <id> <anchor> N <path> <name>    a name inside that file
#   <id> <anchor> S <name>           a name in the code
# An **Anchor:** list is split at commas and semicolons, except that a piece which is only a line or
# a range ("3", "40-55") belongs to the path:line before it, as it would in a citation. A link gives
# its target; res://, ./ and a trailing . go; #L5 is line 5. "fetch() in a.py", "a.py::fetch",
# "a.py:5 (fetch)", "a.py:fetch", "a.py - fetch" and "a.py fetch" all name a symbol in a file.
anchor_rows() {
  LC_ALL=C awk -F'\t' '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function nm(s) { s = trim(s); sub(/\(.*\)$/, "", s); gsub(/[`"]/, "", s); return trim(s) }
    function clean(p) { p = trim(p); gsub(/\\/, "/", p); sub(/^[Rr][Ee][Ss]:\/\//, "", p)
                        while (substr(p, 1, 2) == "./") p = substr(p, 3); return p }
    function pathy(p) { return p ~ /\// || tolower(p) ~ EXT }
    function named(s) { return s ~ /^[A-Za-z_][A-Za-z0-9_.:#-]*(\(\))?$/ }
    function place(id, raw, p,   l) {
      p = clean(p)
      if (match(p, /#[Ll]?[0-9]+(-[Ll]?[0-9]+)?$/)) { l = substr(p, RSTART + 1); gsub(/[Ll]/, "", l)
        P = substr(p, 1, RSTART - 1); print id "\t" raw "\tC\t" P "\t" l; return }
      sub(/#.*$/, "", p)
      if (match(p, /:[0-9][0-9, \t-]*$/)) { l = substr(p, RSTART + 1); gsub(/[ \t]/, "", l)
        P = substr(p, 1, RSTART - 1); print id "\t" raw "\tC\t" P "\t" l; return }
      P = p
      print id "\t" raw "\t" (p ~ /\// ? "F" : "X") "\t" p       # with no folder it may be a dotted name
    }
    function parse(id, raw,   a, lo, t, p, note, i, w) {
      a = raw; gsub(/\r/, "", a); a = trim(a)
      if (match(a, /\[[^]]*\]\([^)]*\)/)) {
        t = substr(a, RSTART, RLENGTH); sub(/^\[[^]]*\]\(/, "", t); sub(/\)$/, "", t)
        if (t !~ /^[a-z]+:\/\// || t ~ /^res:/) a = t
      }
      gsub(/[`"]/, "", a); sub(/[ \t.,;:]+$/, "", a); a = trim(a)
      lo = tolower(a)
      if (a == "" || lo ~ /^(none|n\/a|na|tbd|-|\342\200\224|\342\200\223|\(none\))$/) return
      gsub(/\342\200\223|\342\200\224/, "-", a)
      gsub(/\342\206\222/, " ", a); gsub(/[ \t]->[ \t]|[ \t]=>[ \t]/, " ", a)    # an arrow joins the two
      note = ""
      if (match(a, /[ \t]+\([^()]*\)$/)) { note = trim(substr(a, RSTART)); a = trim(substr(a, 1, RSTART - 1))
        note = substr(note, 2, length(note) - 2) }
      if (match(a, /[ \t]in[ \t]+[^ \t]+$/)) {
        p = substr(a, RSTART + 1); sub(/^in[ \t]+/, "", p)
        if (pathy(clean(p))) { print id "\t" raw "\tN\t" clean(p) "\t" nm(substr(a, 1, RSTART - 1)); return }
      }
      if ((i = index(a, "::")) > 0 && pathy(clean(substr(a, 1, i - 1)))) {
        place(id, raw, substr(a, 1, i - 1))                      # sets P, and prints the file row
        print id "\t" raw "\tN\t" P "\t" nm(substr(a, i + 2)); return
      }
      if (a ~ /[ \t]/) {                                         # "path - name", "path name"
        w = a; sub(/[ \t]+-?[ \t]*[^ \t]+$/, "", w); t = a; sub(/^.*[ \t]/, "", t)
        if (w !~ /[ \t]/ && pathy(clean(w)) && clean(w) !~ /:[0-9]/ && named(t) && !pathy(t)) {
          place(id, raw, w); print id "\t" raw "\tN\t" P "\t" nm(t); return
        }
      }
      if (match(a, /^[^ \t:]+:[A-Za-z_]/) && pathy(clean(substr(a, 1, index(a, ":") - 1)))) {
        i = index(a, ":")                                        # "scripts/x.gd:_teardown_move"
        place(id, raw, substr(a, 1, i - 1)); print id "\t" raw "\tN\t" P "\t" nm(substr(a, i + 1)); return
      }
      if (a ~ /\// || a ~ /:[0-9]/ || a ~ /#[Ll]?[0-9]/ || pathy(a) || a ~ /^res:/) {
        place(id, raw, a)
        if (note ~ /^[A-Za-z_][A-Za-z0-9_.]*(\(\))?$/) print id "\t" raw "\tN\t" P "\t" nm(note)
        return
      }
      print id "\t" raw "\tS\t" nm(a)
    }
    BEGIN {
      EXT = "\\.(py|pyi|pyx|js|jsx|mjs|cjs|ts|tsx|gd|gdshader|tscn|tres|godot|cs|java|kt|kts|go|rs|rb|php|swift|c|h|cc|cpp|cxx|hpp|sh|bash|ps1|bat|cmd|sql|md|mdx|rst|txt|json|jsonc|yml|yaml|toml|ini|cfg|conf|xml|html|htm|css|scss|sass|less|vue|svelte|lock|csv|ipynb|lua|dart|ex|exs|scala|tf|proto|graphql|gradle|env)$"
    }
    $5 == "settled" && $4 != "-" {
      a = $4; gsub(/;/, ",", a); n = split(a, piece, ","); cur = ""
      for (i = 1; i <= n; i++) {
        p = trim(piece[i]); gsub(/\342\200\223/, "-", p)
        if (p == "") continue
        if (cur ~ /:[0-9]/ && p ~ /^[0-9]+([ \t]*-[ \t]*[0-9]+)?$/) cur = cur "," piece[i]    # as written
        else { if (trim(cur) != "") parse($1, trim(cur)); cur = piece[i] }
      }
      if (trim(cur) != "") parse($1, trim(cur))
    }'
}

# The tracked and untracked files under $1 (outside git: every file), with a newline before each, in
# ANCHOR_FILES; ANCHOR_GIT=1 inside git.
anchor_files() {
  local nl='
'
  if git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then
    ANCHOR_GIT=1
    ANCHOR_FILES="$nl$(git -C "$1" -c core.quotepath=off ls-files -co --exclude-standard 2>/dev/null | grep -v '^\.council/')$nl"
  else
    ANCHOR_GIT=0
    ANCHOR_FILES="$nl$(cd "$1" && find . -type f ! -path './.git/*' ! -path './.council/*' 2>/dev/null | sed 's#^\./##')$nl"
  fi
}

# An anchor's path as it is under $1, in AP_OUT: itself, or the one file or folder whose path ends
# with it ("x.py", "services/risk.py" written short). Fails with AP_OUT empty when there is none.
anchor_path() {
  local top="$1" p="$2" nl='
'
  AP_OUT=""
  [ -n "$p" ] || return 1
  case "$p" in /*|[A-Za-z]:*) [ ! -e "$p" ] || { AP_OUT="$p"; return 0; }; p="${p#"$top"/}" ;; esac
  if [ -e "$top/$p" ]; then AP_OUT="$p"; return 0; fi
  case "$ANCHOR_FILES" in *"/$p$nl"*|*"/$p/"*) ;; *) return 1 ;; esac
  AP_OUT="$(P="$p" awk '
    { f = $0; p = ENVIRON["P"]; n = length(f) - length(p) }
    n > 0 && substr(f, n) == "/" p { print f; exit }
    (i = index(f, "/" p "/")) > 0 { print substr(f, 1, i + length(p)); exit }' <<EOF
$ANCHOR_FILES
EOF
)"
  [ -n "$AP_OUT" ]
}

# Which of the names in the file $2 (one per line) are in the code under $1, as whole words — one
# search for all of them, because one search per name costs seconds on a memory with many anchors.
# Prints each name it found. Untracked files count; outside git, every file.
anchor_find() {
  local top="$1" pat="$2" rc
  [ -s "$pat" ] || return 0
  if [ "${ANCHOR_GIT:-1}" = 1 ]; then
    (cd "$top" && git grep -h -o -w -F -f "$pat" --untracked -- . ':(exclude).council') 2>/dev/null; rc=$?
  else
    (cd "$top" && git grep -h -o -w -F -f "$pat" --no-index -- . ':(exclude).council' ':(exclude).git') 2>/dev/null; rc=$?
  fi
  [ "$rc" -le 1 ] || (cd "$top" && grep -r -h -o -w -F -f "$pat" --exclude-dir=.git --exclude-dir=.council .) 2>/dev/null
  return 0
}

# The same inside named files: for the names in $2 and the files listed in $3, print "<file> <name>"
# (tab separated) for every name that is in that file.
anchor_find_in() {
  local top="$1" pat="$2" files="$3"
  { [ -s "$pat" ] && [ -s "$files" ]; } || return 0
  (cd "$top" && tr '\n' '\0' < "$files" | xargs -0 grep -H -o -w -F -f "$pat" -- 2>/dev/null) \
    | awk -F: 'NF >= 2 { n = $NF; printf "%s\t%s\n", substr($0, 1, length($0) - length(n) - 1), n }'
  return 0
}

# Every scope item that matches no file, seat slug or mode. Rows on stdin are memory entries; $1 is the
# code root, $2 the roster's slugs. (The file list goes through stdin too: it can outgrow a variable.)
scope_orphans() {
  anchor_files "$1"
  { cat; printf '\f\n%s\n' "$ANCHOR_FILES"; } | SLUGS="$2" LC_ALL=C awk "$AWK_SCOPE"'
    BEGIN {
      FS = "\t"; roster = (ENVIRON["SLUGS"] != "")
      ns = split(ENVIRON["SLUGS"] "\ncouncil-review\ncouncil-plan\ncouncil-implement\ncouncil-research\ncouncil-postgame", S, "\n")
    }
    $0 == "\f" { part = 2; next }
    part == 2 { if ($0 != "") F[++nf] = $0; next }
    $5 == "settled" && $3 != "-" && !everyrun($3) { R[++nr] = $0 }
    END {
      for (r = 1; r <= nr; r++) {
        split(R[r], f, "\t"); m = items(f[3], I)
        split("", hit); split("", bare); split("", W); split("", P)
        for (i = 1; i <= m; i++) { W[i] = IWHOLE[i]; P[i] = IPIECE[i] }
        for (i = 1; i <= m; i++) {
          g = I[i]
          for (j = 1; j <= ns && !hit[i]; j++) if (S[j] != "" && S[j] == g) hit[i] = 1
          if (!hit[i] && g !~ /[\/.*?{\[]/ && !roster) { bare[i] = 1; continue }   # no roster to judge a word by
          for (j = 1; j <= nf && !hit[i]; j++) if (covers(F[j], g, ".*", 0)) hit[i] = 1
        }
        for (i = 1; i <= m; i++) {
          if (hit[i] || bare[i]) continue
          if (P[i] && hit[P[i]]) continue                       # the item read whole matches
          if (W[i] && pieceshit(i, m, P, hit)) continue          # its pieces match instead
          g = I[i]; if (g in seen) continue
          seen[g] = 1
          printf "memory: scope item \"%s\" (%s) matches no file, seat or mode — check its spelling, or drop it when the folder is gone\n", g, f[1]
        }
      }
    }
    function pieceshit(w, m, P, hit,   i, any) {
      any = 0
      for (i = 1; i <= m; i++) if (P[i] == w) { if (!hit[i]) return 0; any = 1 }
      return any
    }'
}

cmd_memory() {
  local sub="${1:-index}" home top tree mem entries n=0 stale=0 id title scope anchor state where item k keys run why nl='
' tmpd rows found foundin counts kind p extra parts part f ln st last=""
  home="$(council_home)"; top="${home%/*}"
  memory_file "$home"; mem="$MEM"
  if [ ! -f "$mem" ]; then
    [ -z "$MEM_CONF" ] || die "no memory file: the config names $mem, which doesn't exist — if the memory lives elsewhere, point '- conventions:' under ## Memory at it; otherwise council-init creates it"
    die "no memory file ($mem) — council-init creates .council/conventions.md"
  fi
  [ -z "$MEM_NOTE" ] || printf 'council: %s — fix the - conventions: line under ## Memory in council.config.md\n' "$MEM_NOTE" >&2
  [ -z "$MEM_ALT" ] || printf 'council: WARNING — a second memory file, %s, holds %s entries the council never reads (it reads %s) — merge them, or point the - conventions: line under ## Memory in council.config.md at the one to keep\n' "$MEM_ALT" "$MEM_ALT_N" "$mem" >&2
  entries="$(memory_entries "$mem")"
  [ $# -eq 0 ] || shift
  case "$sub" in
    index)
      if [ -z "$entries" ]; then say "memory: no entries yet in $mem"; memory_unread "$mem"; return 0; fi
      printf '%s\n' "$entries" | LC_ALL=C awk -F'\t' "$AWK_SCOPE"'
        function clip(t) { if (length(t) <= 60) return t; t = substr(t, 1, 60); sub(/ [^ ]*$/, "", t); return t " …" }
        $5 == "settled" {
          printf "%s · %s", $1, $2
          if ($3 != "-" && !everyrun($3)) printf " · scope: %s", $3; else printf " · every run"
          if ($4 != "-") printf " · anchor: %s", $4
          printf "\n"; next }
        $5 == "off" { printf "%s · %s · not served (%s)\n", $1, $2, ($6 ~ /^marked/ ? $6 : "under " clip($6)) ; next }
        { printf "%s · %s · NOT SERVED — its section, %s, is not one the council reads as settled\n", $1, $2, clip($6); u++ }
        END { if (u) printf "memory: WARNING — %d entr%s never reach%s a brief: move %s under Accepted Patterns, Enforced Conventions or Decisions (or under ## Retired if %s no longer hold%s)\n", u, (u == 1 ? "y" : "ies"), (u == 1 ? "es" : ""), (u == 1 ? "it" : "them"), (u == 1 ? "it" : "they"), (u == 1 ? "s" : "") }'
      printf '%s\n' "$entries" | scope_orphans "$(this_tree)" "$(roster_rows "$home/council.config.md" | cut -f1 | grep -v '^-$')"
      memory_unread "$mem"
      ;;
    select)
      memory_unread "$mem" >&2
      tree=""; keys=""
      [ $# -eq 0 ] || tree="$(this_tree)"
      for k in ${1+"$@"}; do
        case "$k" in */) ;; *) [ ! -d "$tree/$k" ] || k="$k/" ;; esac
        keys="$keys$k$nl"
      done
      run=""
      if [ $# -eq 0 ] || [ -n "$RUN_ARG" ]; then
        run="$(resolve_run)" || exit 2
      elif [ -n "${COUNCIL_RUN:-}" ] || [ -d "$home/runs" ]; then   # paths given: a run open here adds its own keys
        if run="$(resolve_run 2>&1)"; then run="${run##*"$nl"}"
        else
          case "$run" in
            *several*) printf 'council: several runs are open — only the paths given count; pass --run <folder> to add a run'"'"'s changed files, seats and mode\n' >&2 ;;
          esac
          run=""
        fi
      fi
      if [ -n "$run" ]; then                       # a run's own keys: its changed files, seats and mode
        keys="$keys$(index_paths "$run"; awk -F'\t' 'NR > 1 && $2 != "skipped" { print $1 }' "$run/seats.tsv" 2>/dev/null
                field mode "$run/session-state.md")"       # a lesson may be scoped to a mode, e.g. council-plan
        if ! awk -F'\t' 'NR > 1 { found = 1 } END { exit !found }' "$run/seats.tsv" 2>/dev/null; then
          keys="$keys
$(roster_rows "$home/council.config.md" | cut -f1 | grep -v '^-$')"            # no seats recorded yet: the whole roster
        fi
      fi
      printf '%s\n\f\n%s\n' "$keys" "$entries" | TOP="$tree" LC_ALL=C awk -F'\t' "$AWK_SCOPE"'
        BEGIN { top = ENVIRON["TOP"] }
        $0 == "\f" { part = 2; next }
        !part {                                     # the keys: paths, slugs, the mode
          k = $0; gsub(/\r/, "", k); gsub(/\\/, "/", k)
          if (k ~ /^\/[A-Za-z]\// && top ~ /^[A-Za-z]:\//) k = substr(k, 2, 1) ":" substr(k, 3)   # Git Bash
          if (top != "" && index(tolower(k), tolower(top) "/") == 1) k = substr(k, length(top) + 2)
          if (k == "." || k == "./" || (top != "" && tolower(k) == tolower(top))) { all = 1; next }  # the whole tree
          d = (k ~ /\/$/); k = normp(k)
          if (k != "") { K[++n] = k; D[n] = d }
          next
        }
        $1 == "" { next }
        $5 == "off" { off++; next }
        $5 != "settled" { unk++; U = U (U == "" ? "" : ", ") $1; next }
        {
          tot++
          if ($3 == "-" || everyrun($3)) { every++; print $1 " · " $2 " · every run"; next }
          m = items($3, I); hit = all                 # "select ." is the whole tree: every scope is in it
          for (i = 1; i <= m && !hit; i++) {
            if (everyrun(I[i])) hit = 1
            for (j = 1; j <= n && !hit; j++) if (covers(K[j], I[i], ".*", D[j])) hit = 1
          }
          if (hit) { sc++; print $1 " · " $2 " · scope: " $3 }
        }
        END {
          printf "memory: %d scoped and %d every-run entries of %d apply — quote them in the brief by id", sc, every, tot
          if (off) printf " (%d retired or not yet accepted, left out)", off
          printf "\n"
          if (unk) printf "memory: WARNING — %s sit%s under a section the council does not read as settled and %s left out; council memory lists %s\n", U, (unk == 1 ? "s" : ""), (unk == 1 ? "is" : "are"), (unk == 1 ? "it" : "them") > "/dev/stderr"
        }'
      ;;
    check)
      memory_unread "$mem"
      anchor_files "$top"
      n="$(printf '%s\n' "$entries" | awk -F'\t' '$5 == "settled" { c++ } END { print c + 0 }')"
      tmpd="$(mktemp -d 2>/dev/null)" || { tmpd="$home/.memcheck.$$"; mkdir -p "$tmpd" || die "cannot write $tmpd"; }
      : > "$tmpd/names"; : > "$tmpd/fsnames"; : > "$tmpd/fsfiles"; : > "$tmpd/files"
      # One pass to see what each anchor names, then one search for every name at once: a search per
      # anchor costs minutes on a memory with hundreds of them.
      rows=""
      while IFS="$TAB" read -r id item kind p extra; do
        [ -n "$id" ] || continue
        f=""; parts="${extra//[.:#]/ }"
        case "$kind" in
          C|F|N) anchor_path "$top" "$p" && f="$AP_OUT" ;;
          X) if anchor_path "$top" "$p"; then f="$AP_OUT"; else printf '%s\n' "$p" >> "$tmpd/names"; fi ;;
          S) for part in ${p//[.:#]/ }; do printf '%s\n' "$part" >> "$tmpd/names"; done ;;
        esac
        case "$kind" in
          C) [ -z "$f" ] || printf '%s\n' "$f" >> "$tmpd/files" ;;
          N) if [ -n "$f" ]; then
               printf '%s\n' "$f" >> "$tmpd/fsfiles"
               for part in ${parts:-}; do printf '%s\n' "$part" >> "$tmpd/fsnames"; done
             fi ;;
        esac
        rows="$rows$id$TAB$item$TAB$kind$TAB${f:--}$TAB$p$TAB${extra:--}
"
      done <<PARSED
$(printf '%s\n' "$entries" | anchor_rows)
PARSED
      for k in names fsnames fsfiles files; do
        sort -u "$tmpd/$k" > "$tmpd/$k.s" 2>/dev/null && mv -f "$tmpd/$k.s" "$tmpd/$k" 2>/dev/null
      done
      found="$nl$(anchor_find "$top" "$tmpd/names" | sort -u)$nl"
      foundin="$nl$(anchor_find_in "$top" "$tmpd/fsnames" "$tmpd/fsfiles" | sort -u)$nl"
      counts="$nl$( (cd "$top" && tr '\n' '\0' < "$tmpd/files" | xargs -0 -n 20 awk \
                   '{ c[FILENAME] = FNR } END { for (f in c) printf "%s\t%s\n", f, c[f] }' 2>/dev/null) )$nl"
      rm -rf "$tmpd" 2>/dev/null
      while IFS="$TAB" read -r id item kind f p extra; do
        [ -n "$id" ] || continue
        why=""; [ "$extra" != "-" ] || extra=""; parts="${extra//[.:#]/ }"
        case "$kind" in
          C) if [ "$f" = "-" ]; then why="anchor $item no longer exists"
             elif [ -d "$top/$f" ]; then why="anchor $item: bad-line (a folder has no lines)"
             else
               ln=0; case "$counts" in *"$nl$f$TAB"*) st="${counts#*"$nl$f$TAB"}"; ln="${st%%"$nl"*}" ;; esac
               if ! cite_ranges "$extra" "$ln" >/dev/null 2>&1; then why="anchor $item: $(cite_lines "$extra" "$ln")"; fi
             fi ;;
          F) [ "$f" != "-" ] || why="anchor $item no longer exists" ;;
          X) if [ "$f" = "-" ]; then
               case "$found" in *"$nl$p$nl"*) ;; *) why="anchor $item no longer exists" ;; esac
             fi ;;
          N) if [ "$f" = "-" ]; then why="anchor $item no longer exists"
             else
               for part in ${parts:-}; do
                 case "$foundin" in *"$nl$f$TAB$part$nl"*) ;; *) why="nothing in $f is named $extra any more"; break ;; esac
               done
             fi ;;
          S) for part in ${p//[.:#]/ }; do
               case "$found" in *"$nl$part$nl"*) ;; *) why="nothing in the code is named $p any more"; break ;; esac
             done ;;
        esac
        [ -z "$why" ] || [ "$id$TAB$item" = "$last" ] || { stale=$((stale + 1)); last="$id$TAB$item"; say "STALE  $id — $why"; }
      done <<RESOLVED
$rows
RESOLVED
      [ "$stale" -eq 0 ] || say "→ at the next Learn, propose re-anchoring or retiring each stale entry — the user decides"
      say "memory check: $stale stale anchor(s) across $n entries"
      [ "$stale" -eq 0 ]
      ;;
    *) die "usage: council memory [index | select [path|slug …] | check]" ;;
  esac
}

# Earlier council work that mentions these paths (one per line on stdin): tracked deliverables in
# reviews/, logs/, research/, plans/ and postgames/ that name a path, or whose frontmatter areas: cover
# it. Rows: path · deliverable[:line] · the matching line or area.
prior_hits() {
  local home="$1" paths dir f
  paths="$(cat)"
  [ -n "$paths" ] || return 0
  set --
  for dir in reviews logs research plans postgames; do
    for f in "$home/$dir"/*.md; do [ -f "$f" ] && set -- ${1+"$@"} "$f"; done
  done
  [ $# -gt 0 ] || return 0
  # One pass over every deliverable. A path counts where it appears whole — not inside a longer path
  # or name (api.py.bak), though ./, res:// or the repo's own absolute path may come before it, and
  # backslashes read as slashes — else where the frontmatter's areas: (inline, [bracketed] or a - list;
  # commas, semicolons or blanks between; # comments dropped) cover it.
  PATHS="$paths" TOP="${home%/*}" LC_ALL=C awk "$AWK_SCOPE"'
    function clip(t) { if (length(t) <= 120) return t; t = substr(t, 1, 120); sub(/ [^ ]*$/, "", t); return t " …" }
    function add_areas(x,   k, t, i) {
      sub(/(^|[ \t])#.*$/, "", x); gsub(/\[|\]/, "", x)
      k = items(x, t); for (i = 1; i <= k; i++) A[++na] = t[i]
    }
    function flush(   i, j) {
      if (disp == "") return
      for (i = 1; i <= np; i++) {
        if (P[i] == "") continue
        if (hit[i] != "") { print ORIG[i] "\t" hit[i]; continue }
        for (j = 1; j <= na; j++) if (covers(P[i], A[j], "[^/]*", 0)) { print ORIG[i] "\t" disp "\t(its areas cover " A[j] ")"; break }
      }
    }
    function boundary(s, at,   pre) {                # may a mention start at s[at]?
      if (at == 1 || substr(s, at - 1, 1) !~ /[A-Za-z0-9_.\/-]/) return 1
      pre = tolower(substr(s, 1, at - 1))
      if (pre ~ /(^|[^A-Za-z0-9_.\/-])(\.\/)+$/ || pre ~ /res:\/\/$/) return 1
      return top != "" && length(pre) >= length(top) + 1 && substr(pre, length(pre) - length(top)) == top "/"
    }
    BEGIN {
      np = split(ENVIRON["PATHS"], ORIG, "\n"); top = tolower(ENVIRON["TOP"])
      for (i = 1; i <= np; i++) { P[i] = ORIG[i]; gsub(/\r/, "", P[i]); P[i] = normp(P[i]); ORIG[i] = P[i] }
    }
    FNR == 1 {
      flush(); m = split(FILENAME, fp, "/"); disp = fp[m - 1] "/" fp[m]; na = 0; infm = 0; inareas = 0
      for (i = 1; i <= np; i++) hit[i] = ""
    }
    { line = $0; sub(/\r$/, "", line); if (FNR == 1) sub(/^\357\273\277/, "", line) }
    FNR == 1 && line == "---" { infm = 1; next }
    infm {
      if (line == "---") { infm = 0; next }
      if (line ~ /^areas:/) {
        v = line; sub(/^areas:[ \t]*/, "", v)
        if (v == "" || v ~ /^#/) inareas = 1
        else { inareas = 0; add_areas(v) }
        next
      }
      if (inareas && line ~ /^[ \t]*-/) { x = line; sub(/^[ \t]*-[ \t]*/, "", x); add_areas(x); next }
      if (inareas && line ~ /^[ \t]*(#|$)/) next
      inareas = 0; next
    }
    {
      s0 = line; gsub(/\\/, "/", s0)
      for (i = 1; i <= np; i++) {
        if (P[i] == "" || hit[i] != "") continue
        s = s0; base = 0
        while ((pos = index(s, P[i])) > 0) {
          at = base + pos
          after = substr(s0, at + length(P[i]), 2)
          if (boundary(s0, at) && after !~ /^[A-Za-z0-9_\/-]/ && after !~ /^\.[A-Za-z0-9_]/) {
            txt = line; sub(/^[ \t]+/, "", txt); hit[i] = disp ":" FNR "\t" clip(txt); break
          }
          base = at; s = substr(s0, at + 1)
        }
      }
    }
    END { flush() }' "$@"
}

cmd_prior() {
  local home run hits total
  home="$(council_home)"
  if [ $# -gt 0 ]; then
    hits="$(printf '%s\n' "$@" | prior_hits "$home")"
  else
    run="$(resolve_run)" || exit 2
    [ -f "$run/index.md" ] || die "no paths given and no change index in this run — pass them: council prior <path> …"
    hits="$(index_paths "$run" | prior_hits "$home")"
  fi
  if [ -z "$hits" ]; then say "prior: no earlier council work mentions these paths"; return 0; fi
  total="$(printf '%s\n' "$hits" | grep -c .)"
  printf '%s\n' "$hits" | head -n 40 | awk -F'\t' '{ printf "%s — %s — %s\n", $1, $2, $3 }'
  if [ "$total" -gt 40 ]; then
    say "prior: 40 of $total mention(s) shown — list them in the brief's Landscape as ids plus one line; pass fewer paths to see the rest"
  else
    say "prior: $total mention(s) — list them in the brief's Landscape as ids plus one line"
  fi
}

# ------------------------------------------------------------------------------------------------
# The user's request, word for word — filed where later runs, and a post-game, can find it
# ------------------------------------------------------------------------------------------------

# A case-insensitive pattern for a word: token → [tT][oO][kK][eE][nN] (BSD sed has no I flag).
ci() {
  printf '%s' "$1" | awk '{ for (i = 1; i <= length($0); i++) { c = substr($0, i, 1); l = tolower(c); u = toupper(c)
    printf "%s", (l != u) ? "[" l u "]" : c } }'
}

# Copy $1 to $2 with secret-looking strings redacted, and print how many were. It knows common shapes, not
# every secret — the caller says so. One sed -E pass, in this order:
#  - private-key blocks, at any indent: the BEGIN line becomes [redacted private key]; the key lines under it
#    go until the END line or the first line that isn't key-shaped, so the text after a snipped key stays. A
#    short key-shaped line waits in the hold space (P<line>) and goes only if the END line follows it. An
#    armour header (Comment:, Version: …) stays; a line with one key's END and the next one's BEGIN goes on;
#  - tokens by their prefix (sk-, sk_live_, whsec_, ghp_, glpat-, npm_, hf_, pypi-, GOCSPX-, AKIA/ASIA,
#    AIza, xoxb-/xapp-, SG., bot tokens, JWTs, Slack webhook paths, a URL's password) — a lowercase
#    word-list such as sk-learn-compat-… is shielded first (\005), only when every part of it is a word;
#  - values named by what's around them (Authorization, Bearer/Basic, "password is", key = value for
#    password-, token-, secret- and …key-names) are marked (\004 for passwords, \002 for the rest), then
#    unmarked when they read as ordinary text: a date, an ${ENV} name, a path made of words, code such as
#    a.b.get( or getpass() — for a password also a short plain word; for the rest also a count of up to 10
#    digits, a call, a dotted name, words joined by - _ . or /, a CamelCase name, or a value with no digit.
#    What stays marked becomes [redacted].
# Not awk: old macOS awk has no {n,} bounds, and Git Bash's sed and awk drop carriage returns unless sed gets
# -b (GNU sed takes it everywhere; BSD sed has no text mode to switch off). LC_ALL=C passes every byte through
# untouched. Labels and braces sit in their own -e, as BSD sed needs.
sed_b() { if sed -b -e '' </dev/null >/dev/null 2>&1; then printf '%s' '-b'; fi; }

# An ask.md's "In your words" body, and its "Later" lines — straight to stdout, byte for byte. Only
# those two headings end a section, so a pasted PR or issue with its own "## Summary" stays whole. Write
# them to files directly: Git Bash's $(…) drops carriage returns, so a variable is only good for tests.
ask_words() { LC_ALL=C sed $(sed_b) -n -e '/^## In your words/,/^## Later/{' -e '/^## In your words/d' -e '/^## Later/d' -e 'p' -e '}' "$1"; }
ask_later() { LC_ALL=C sed $(sed_b) -n -e '/^## Later/,${' -e '/^## Later/d' -e '/^[[:space:]]*$/d' -e 'p' -e '}' "$1"; }

# Line numbers of the sections continuing runs add to a filed request ("## <date> — <mode>, run <folder>");
# $2, a run's folder name, keeps only that run's — the whole name, so run …-review never matches …-review-2.
# Only a run folder's name (<date>-<time>-<mode>) counts: a dated heading in the user's own words is no section.
ask_sections() {
  local who any='[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-[A-Za-z0-9-]+'
  who="$(printf '%s' "${2:-}" | sed 's/[.[()*+?{|^$\]/\\&/g')"
  LC_ALL=C grep -n -E "^## [0-9]{4}-[0-9]{2}-[0-9]{2} .*, run ${who:-$any}[[:space:]]*\$" "$1" 2>/dev/null | cut -d: -f1
}

redact_copy() {
  local pw tk q v ve lo st dash key end b64 id wp arg dcall call pcall ps path w l sep joined camel fw prose sedb before after
  pw="[A-Za-z0-9_]*($(ci passwd)|$(ci password)|$(ci passphrase)|$(ci passcode)|[_-]$(ci pass)|[_-]$(ci pwd))"
  tk="[A-Za-z0-9_]*($(ci secret)|$(ci token)|$(ci credentials)|$(ci credential)|($(ci api)|$(ci access)|$(ci account)|$(ci encryption)|$(ci private)|$(ci signing)|$(ci master)|$(ci client)|$(ci app)|$(ci auth)|$(ci session)|$(ci shared)|$(ci license)|$(ci secret))[_-]?$(ci key))"
  q="[\"'\`]"                                   # a quote around a key or a value
  lo="$(printf '\002')"; st="$(printf '\004')"; dash="$(printf '\005')"
  v="[^[:space:]\"'\`,;}${lo}${st}]"            # one character of an unquoted value …
  ve="[^[:space:]\"'\`,;}.${lo}${st}]"          # … and its last: a full stop after it ends the sentence
  key="-----BEGIN [A-Z0-9 ]*PRIVATE KEY( BLOCK)?-----"
  end="-----END [A-Z0-9 ]*PRIVATE KEY( BLOCK)?-----"
  b64='[A-Za-z0-9+\/]'
  # What a marked value may be and still read as ordinary text (these rules use # as the delimiter).
  id='[A-Za-z_][A-Za-z0-9_]*'
  wp='(_*[a-z]+[0-9]*(_+[a-z]*[0-9]*)*|_*[A-Z]+[0-9]*(_+[A-Z]*[0-9]*)*|[A-Z]?[a-z]+([A-Z][a-z]+)*[0-9]*)'   # snake, CONST, Camel
  arg='(\\([A-Za-z0-9_.]*\\))?'                                                    # (), (x), (a.b) — or cut at a quote
  dcall="${id}(\\.${id})+\\(([A-Za-z0-9_.]*\\))?(\\.${id}${arg})*"                 # a.b(…), a.b.get(
  call="${id}\\(([A-Za-z0-9_.]*\\))?(\\.${id}${arg})*|${dcall}"                   # f(x) too
  pcall="${id}\\((\\)|_*[A-Z]+[0-9]*(_+[A-Z]*[0-9]*)*\\))?"                        # a password's f(, f(), f(NAME)
  ps='(([A-Z]?[a-z_.-]+[0-9]*)+|[A-Z0-9_.-]+)'                                    # a path part made of words
  path="(/${ps}){2,}/?|(\\.{1,2}|~)(/${ps})+/?|[A-Za-z]:[\\\\/][^${lo}${st}]*|([A-Za-z0-9_.-]+/)+[A-Za-z0-9_.-]+\\.[A-Za-z0-9]{1,5}"
  w='(([A-Z]?[a-z]+|[A-Z]+)[0-9]*|[0-9]+)'; l='([A-Z]?[a-z]{2,}|[A-Z]{3,})[0-9]*'; sep='[-_./]'
  joined="(${w}${sep})*${l}${sep}(${w}${sep})*${l}(${sep}${w})*"                 # two words or more
  camel='([A-Z][a-z]+){2,}[0-9]{0,2}|[a-z]+([A-Z][a-z]+)+[0-9]{0,2}'
  # A password described in hyphenated words: two small joining words make it prose. A passphrase of
  # random words ("correct-horse-battery-staple") has none, so it stays redacted.
  fw='(the|a|an|to|of|in|on|at|by|for|with|before|after|from|into|we|our|us|it|its|is|are|be|and|or|not|as|same|every|each|all)'
  prose="([a-z]+-)*${fw}-([a-z]+-)*${fw}(-[a-z]+)+"                              # hashed-with-bcrypt-before-storage
  sedb="$(sed_b)"
  LC_ALL=C sed $sedb -E \
    -e 'x' \
    -e '/^P/{' -e 'x' \
    -e "/${end}/{" -e 'x' -e 's/.*/K/' -e 'x' -e 'b inkey' -e '}' \
    -e "/^[[:space:]>]*=${b64}{4}[[:space:]]*\$/d" \
    -e 'x' -e 's/^P//' -e 's/(^|[^A-Za-z0-9])((AKIA|ASIA)[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})/\1[redacted]/g' \
    -e 'p' -e 's/.*//' -e 'x' -e 'b shapes' -e '}' \
    -e '/^K$/!{' -e 'x' -e 'b shapes' -e '}' -e 'x' \
    -e ':inkey' \
    -e "/${end}/{" -e 'x' -e 's/.*//' -e 'x' -e "/${end}.*${key}/!d" -e "s/${end}/${lo}/" -e "s/^[^${lo}]*${lo}//" -e 'b shapes' -e '}' \
    -e '/^[[:space:]]*$/b' \
    -e '/^[[:space:]>]*(Proc-Type|DEK-Info|Version|Comment|Hash|Charset):/b shapes' \
    -e "/^[[:space:]>]*=${b64}{4}[[:space:]]*\$/d" \
    -e "/^[[:space:]>]*${b64}*={1,2}[[:space:]]*\$/d" \
    -e "/^[[:space:]>]*${b64}{40,}[[:space:]]*\$/{" -e '/[A-Z]/{' -e '/[a-z]/{' -e '/[0-9]/d' -e '}' -e '}' -e '}' \
    -e "/^[[:space:]>]*${b64}{1,39}[[:space:]]*\$/{" -e '$b close' -e 's/^/P/' -e 'h' -e 'd' -e '}' \
    -e ':close' \
    -e 'x' -e 's/.*//' -e 'x' \
    -e ':shapes' \
    -e "s/${key}.*${end}/[redacted private key]/g" \
    -e "/${key}/{" -e "s/${key}[A-Za-z0-9+\\/=\\\\]*/[redacted private key]/" -e 'x' -e 's/.*/K/' -e 'x' -e '}' \
    -e "s/(^|[^A-Za-z0-9_-])(sk|rk)(-[a-z]{1,16}[0-9]{0,4}(-[a-z]{1,16}[0-9]{0,4}){2,})([^A-Za-z0-9_-]|\$)/\\1\\2${dash}\\3\\5/g" \
    -e 's/(^|[^A-Za-z0-9_-])((sk|rk)(-|_live_|_test_)|whsec_)[A-Za-z0-9_-]{20,}/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9_])(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{22,}|gl(pat|dt|rt|ptt|cbt|soat)-[A-Za-z0-9_-]{20,}|npm_[A-Za-z0-9]{30,}|hf_[A-Za-z0-9]{30,}|pypi-[A-Za-z0-9_-]{40,}|GOCSPX-[A-Za-z0-9_-]{20,})/\1[redacted]/g' \
    -e 's/(AKIA|ASIA)[0-9A-Z]{16}([,;[:space:]]+)[A-Za-z0-9+\/]{40}([^A-Za-z0-9+\/]|$)/[redacted]\2[redacted]\3/g' \
    -e 's/(^|[^A-Za-z0-9])((AKIA|ASIA)[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9_-])(xox[abeoprs]|xapp)-[A-Za-z0-9-]{10,}/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9_-])SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}/\1[redacted]/g' \
    -e 's/(^|[^A-Za-z0-9])[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}/\1[redacted]/g' \
    -e 's/eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/[redacted]/g' \
    -e 's#(hooks\.slack\.com/(services|workflows|triggers)/)[A-Za-z0-9_/-]{16,}#\1[redacted]#g' \
    -e 's#(://[^/:@[:space:]]*:)[^/@[:space:]]+@#\1[redacted]@#g' \
    -e "s/($(ci authorization)${q}?[[:space:]]*[:=][[:space:]]*${q}?[A-Za-z][A-Za-z0-9_-]*[[:space:]]+)(${v}{7,}${ve})/\\1${lo}\\2${lo}/g" \
    -e "s/([Bb]earer[[:space:]]+|[Bb]asic[[:space:]]+)([A-Za-z0-9._~+\\/=-]{15,}[A-Za-z0-9_~+\\/=-])/\\1${lo}\\2${lo}/g" \
    -e "s/(($(ci password)|$(ci passwd)|$(ci passphrase))[[:space:]]+($(ci is)|$(ci was))[[:space:]]*:?[[:space:]]+)(${v}{5,}${ve})/\\1${st}\\4${st}/g" \
    -e "s/(($(ci secret)[[:space:]A-Za-z]{0,12}|$(ci token)|($(ci api)|$(ci access))[[:space:]_-]?$(ci key))[[:space:]]+($(ci is)|$(ci was))[[:space:]]*:?[[:space:]]+)(${v}{7,}${ve})/\\1${lo}\\5${lo}/g" \
    -e "s/(${pw}${q}?[[:space:]]*[:=][[:space:]]*)\"([^\"${lo}${st}]{6,})\"/\\1\"${st}\\3${st}\"/g" \
    -e "s/(${pw}${q}?[[:space:]]*[:=][[:space:]]*)'([^'${lo}${st}]{6,})'/\\1'${st}\\3${st}'/g" \
    -e "s/(${pw}${q}?[[:space:]]*[:=][[:space:]]*${q}?)(${v}{5,}${ve})/\\1${st}\\3${st}/g" \
    -e "s/(${tk}${q}?[[:space:]]*[:=][[:space:]]*)\"([^\"${lo}${st}]{8,})\"/\\1\"${lo}\\4${lo}\"/g" \
    -e "s/(${tk}${q}?[[:space:]]*[:=][[:space:]]*)'([^'${lo}${st}]{8,})'/\\1'${lo}\\4${lo}'/g" \
    -e "s/(${tk}${q}?[[:space:]]*[:=][[:space:]]*${q}?)(${v}{7,}${ve})/\\1${lo}\\4${lo}/g" \
    -e "s/[${lo}${st}]([0-9]{4}-[0-9]{2}-[0-9]{2}[T0-9:.Z+-]*|\\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?|%[A-Za-z_][A-Za-z0-9_]*%)[${lo}${st}]/\\1/g" \
    -e "s#${st}([A-Za-z._-]{1,19}|${dcall}|${pcall}|${path}|${prose})${st}#\\1#g" \
    -e "s#${lo}([0-9]{1,10}|${call}|${path}|${wp}(\\.${wp})+|${joined}|${camel})${lo}#\\1#g" \
    -e "s/${lo}([^0-9A-Z+=${lo}]+|[^0-9a-z+=${lo}]+|[^0-9+=${lo}]{1,19})${lo}/\\1/g" \
    -e "s/[${lo}${st}][^${lo}${st}]*[${lo}${st}]/[redacted]/g" \
    -e "s/${dash}//g" "$1" > "$2" || return 1
  before="$(LC_ALL=C grep -o '\[redacted' "$1" 2>/dev/null | wc -l | tr -d ' ')"
  after="$(LC_ALL=C grep -o '\[redacted' "$2" 2>/dev/null | wc -l | tr -d ' ')"
  printf '%s' "$(( ${after:-0} - ${before:-0} ))"
}

# council ask save [slug] — file <run>/ask.md. A new request becomes .council/asks/<date>-<slug>.md
# (line 1, then run: and mode:, then the rest of ask.md as written); a run that continues one (the
# state's ask:) appends its new words under a dated heading. Either way the state records ask=.
cmd_ask() {
  local sub="${1:-}" slug run name st ask home root mode cur target base n=2 rel tmp red=0 status body later nowords="" own="" \
        rdir rasks at next keep
  [ "$sub" = save ] || die "usage: council ask save [slug]   (after writing the user's words to <run>/ask.md)"
  shift
  slug="${1:-}"
  run="$(resolve_run)" || exit 2
  name="${run##*/}"; st="$run/session-state.md"; ask="$run/ask.md"
  [ -f "$ask" ] || die "no ask.md in $run — write the user's words there first"
  body="$(ask_words "$ask")"; later="$(ask_later "$ask")"          # for the checks below only
  printf '%s' "$body" | grep -q '[^[:space:]]' || die "ask.md has no words under '## In your words'"
  [ "$(printf '%s\n' "$body" | tr -d '\r' | grep -v '^[[:space:]]*$')" != "(no new words)" ] || nowords=1
  home="$(council_home)"; root="$(dirname "$home")"
  # Requests live in a real asks/ folder: a link there (a committed symlink, a junction) could lead anywhere.
  if [ -L "$home/asks" ] || { [ -e "$home/asks" ] \
       && [ "$(cd -P "$home/asks" 2>/dev/null && here)" != "$(cd -P "$home" 2>/dev/null && here)/asks" ]; }; then
    die "$home/asks is a link or a file, not a folder — requests are filed only in a real asks/ folder; replace it with one"
  fi
  mode="$(field mode "$st")"
  # The request this run continues: the state's ask=, else ask.md's own continues: line.
  cur="$(field ask "$st")"
  [ -n "$cur" ] || cur="$(field continues "$ask" | tr -d '`<>' | sed 's/[[:space:]].*$//')"
  if [ -n "$cur" ]; then
    cur="$(printf '%s' "$cur" | tr '\\' '/')"
    case "$cur" in /*|[A-Za-z]:*) target="$cur" ;; *) target="$root/$cur" ;; esac
    # Only a real file inside asks/: no ".." step, no link, and the folder it resolves to is asks/ (or
    # below it) — compared after resolving both, so C:/…, /c/… and a relative path all work.
    case "/$cur/" in */../*) die "a request is filed under $home/asks/, not $cur — copy the words into ask.md instead" ;; esac
    rdir="$(cd -P "$(dirname "$target")" 2>/dev/null && here)"
    rasks="$(cd -P "$home/asks" 2>/dev/null && here)"
    case "$rdir/" in
      "$rasks"/*) [ -n "$rasks" ] || die "the request this run continues is missing: $cur"
                  target="$home/asks${rdir#"$rasks"}/${target##*/}" ;;
      *) die "a request is filed under $home/asks/, not $cur — copy the words into ask.md instead" ;;
    esac
    [ -f "$target" ] || die "the request this run continues is missing: $cur"
    [ ! -L "$target" ] || die "a request is filed under $home/asks/, not $cur (a link) — copy the words into ask.md instead"
    [ "$(sed -n '2p' "$target" | tr -d '\r')" != "run: $name" ] || own=1        # this run filed it: re-file its words
  elif [ -n "$nowords" ]; then
    die "ask.md says (no new words) but names no request to continue — add continues: <path> to it, or run council state ask=<path>"
  fi
  ensure_ignored "$home"                            # the user's own words stay on their machine
  mkdir -p "$home/asks" 2>/dev/null || die "cannot create $home/asks"
  tmp="$run/.ask.tmp"
  rm -f "$tmp" "$tmp.2" "$tmp.3"
  if [ -z "$cur" ] || [ -n "$own" ]; then
   if [ -z "$cur" ]; then
    if [ -z "$slug" ]; then                           # from the title as filed, so a pasted key never names the file
      head -n 1 "$ask" > "$tmp.3" && redact_copy "$tmp.3" "$tmp.2" >/dev/null
      slug="$(sed 's/^#[[:space:]]*[Aa]sk//; s/\[redacted[^]]*\]//g' "$tmp.2" 2>/dev/null)"
    fi
    slug="$(printf '%s' "$slug" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9]+/-/g; s/^-+//' | cut -c1-40 | sed 's/-*$//')"
    [ -n "$slug" ] || slug=request
    base="$home/asks/$(date '+%Y-%m-%d')-$slug"; target="$base.md"
    while [ -e "$target" ] || [ -L "$target" ]; do target="$base-$n.md"; n=$((n + 1)); done
   fi
    { head -n 1 "$ask"; printf 'run: %s\nmode: %s\n' "${run##*/}" "${mode:--}"; tail -n +2 "$ask"; } > "$tmp" || die "cannot write $tmp"
    red="$(redact_copy "$tmp" "$tmp.2")" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot write $target"; }
    if [ -n "$own" ]; then                            # re-filed: the sections later runs added stay, as written
      at="$(ask_sections "$target" | head -n 1)"
      if [ -n "$at" ]; then printf '\n' >> "$tmp.2"; LC_ALL=C sed $(sed_b) -n "$at,\$p" "$target" >> "$tmp.2"; fi
    fi
    cat "$tmp.2" > "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot write $target"; }
    status=new
  else
    # A continuing request: this run's words go in one dated section — replaced where it stands, if this run
    # saved before; every other run's section stays.
    : > "$tmp.2"
    if [ -n "$nowords" ] && [ -z "$later" ]; then
      status="no new words"
    else
      { printf '\n## %s — %s, run %s\n' "$(date '+%Y-%m-%d')" "${mode:--}" "${run##*/}"
        ask_words "$ask"; ask_later "$ask"; } > "$tmp" || die "cannot write $tmp"
      red="$(redact_copy "$tmp" "$tmp.2")" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot append to $target"; }
      status=continued
    fi
    at=""                                              # no new words: this run's earlier section stays as it is
    [ "$status" = "no new words" ] || at="$(ask_sections "$target" "$name" | head -n 1)"
    if [ -n "$at" ]; then
      next="$(ask_sections "$target" | awk -v at="$at" '$1 > at + 0 { print; exit }')"
      keep=$((at - 1))                                 # the blank line before the heading goes with it
      if [ "$keep" -ge 1 ] && [ -z "$(sed -n "${keep}p" "$target" | tr -d '[:space:]')" ]; then keep=$((keep - 1)); fi
      { [ "$keep" -lt 1 ] || LC_ALL=C sed $(sed_b) -n "1,${keep}p" "$target"
        cat "$tmp.2"
        if [ -n "$next" ]; then printf '\n'; LC_ALL=C sed $(sed_b) -n "$next,\$p" "$target"; fi
      } > "$tmp.3" && cat "$tmp.3" > "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot update $target"; }
    elif [ -s "$tmp.2" ]; then
      cat "$tmp.2" >> "$target" || { rm -f "$tmp" "$tmp.2" "$tmp.3"; die "cannot append to $target"; }
    fi
  fi
  rm -f "$tmp" "$tmp.2" "$tmp.3"
  case "$target" in "$root"/*) rel="${target#"$root"/}" ;; *) rel="$target" ;; esac
  RUN_ARG="$run" cmd_state ask="$rel" ask-saved="$(now_min)" >/dev/null
  [ "${red:-0}" -eq 0 ] 2>/dev/null \
    || say "ask: redacted $red secret-looking string(s) — tell the user; it catches common shapes only, so check $rel for others before sharing it"
  say "ask: $rel ($status)"
}

# ------------------------------------------------------------------------------------------------
# Seat ledger — one row per seat per completed run, tracked in the council home
# ------------------------------------------------------------------------------------------------

# A seat's output file, from its brief block (default seats/<slug>.md).
seat_out() {
  local out
  out="$(brief_seats "$1/brief.md" 2>/dev/null | SLUG="$2" awk -F'\t' '$1 == ENVIRON["SLUG"] { print $3; exit }')"
  [ -n "$out" ] || out="seats/$2.md"
  case "$out" in /*|[A-Za-z]:*) printf '%s' "$out" ;; *) printf '%s/%s' "$1" "$out" ;; esac
}

# Per-seat kept / cut / refuted counts for a run, from synthesis.md's "from:" provenance and the
# REFUTED rows of its verify-*.md tables. Rows: slug kept cut refuted. Provenance is the item line's
# last "from:" field, however it is introduced (" · from:", "— from:", "(from:"); a title may say
# "from:" too, so the last one wins. It is read as seat#item tokens — "hunt#1, #2", "beck#1,2",
# "hunt#3 and beck#3", "hunt#4/beck#4" and "hunt #1" all name every item, and each item counts once
# however often it is named. A bare seat name counts as one item of that seat's, and only for a seat
# the run really had, so the words of a sentence never become seats; inside brackets only "seat#n"
# counts ("(merged with hunt#2)" names hunt#2, not "with"). A verdict counts by its first word, in any
# case and with any mark before it ("❌ Refuted (latent)"); the # cell may read "1.", "#1" or "C1".
synthesis_counts() {
  local run="$1"
  [ -f "$run/synthesis.md" ] || return 0
  set -- "$run"/verify-*.md
  [ -e "$1" ] || set --
  SYN="$run/synthesis.md" \
  SLUGS="$(awk -F'\t' 'NR > 1 && $1 != "" { print $1 }' "$run/seats.tsv" 2>/dev/null | paste -sd ' ' -)" awk '
    function count(sl, key,   gk) {                  # one item of one seat, however often it is named
      seen[sl] = 1; gk = sec "\t" key
      if (!(gk in once)) { once[gk] = 1; if (sec == "k") kept[sl]++; else cut[sl]++ }
      if (sec == "k") owners[n] = owners[n] " " sl   # one entry per item named: a REFUTED verdict on a
    }                                                # merged item refutes each of the items merged into it
    function known(w) { return (nslug == 0 || (w in SLUG)) }
    function flush() { if (carry != "" && pendnum == 0 && known(carry)) count(carry, carry "#" n); carry = ""; pendnum = 0 }
    function credit(w, d) {
      sub(/[.,:;]+$/, "", w)
      if (w ~ /^[A-Za-z][A-Za-z0-9._-]*#C?[0-9]+[a-z]?$/) {
        flush(); carry = substr(w, 1, index(w, "#") - 1); pendnum = 1; count(carry, w); return
      }
      if (w ~ /^#?C?[0-9]+[a-z]?$/ && carry != "") { sub(/^#/, "", w); pendnum = 1; if (known(carry)) count(carry, carry "#" w); return }
      if (d == 0 && w ~ /^[A-Za-z][A-Za-z0-9._-]*$/) { flush(); carry = w; pendnum = 0; return }
      flush()
    }
    BEGIN { nslug = split(ENVIRON["SLUGS"], S, " "); for (i = 1; i <= nslug; i++) SLUG[S[i]] = 1 }
    FNR == 1 { sec = ""; vcol = 0; ncol = 2 }
    FILENAME == ENVIRON["SYN"] {
      if ($0 ~ /^## /) { sec = ($0 ~ /^## Kept/) ? "k" : (($0 ~ /^## Cut/) ? "c" : ""); next }
      line = $0; gsub(/[\r`*]/, "", line); gsub(/\t/, " ", line)
      if (sec == "" || line !~ /^[-+]? *_*C?[0-9]+[a-z]?_*\.? +(·|\|) /) next
      n = line; sub(/^[-+]? */, "", n); sub(/ .*$/, "", n); gsub(/[_.]/, "", n); n = tolower(n)
      # The provenance field: the last "· from:", the way the format writes it. Only when the line has
      # none of those is a "from:" introduced another way read (— from:, (from:), so that a title
      # saying "why: repeats from: beck" can never take the field over.
      lo = tolower(line); p = 0; q = 0; off = 0; t = lo
      while ((i = index(t, "from:")) > 0) {
        at = off + i; pre = substr(lo, 1, at - 1); sub(/[ \t]+$/, "", pre)
        if (pre ~ /·$/) { p = at; q = 1 }                           # the field separator: a real field
        else if (!q && (pre == "" || pre !~ /[a-z0-9]$/)) p = at    # "— from:", "(from:"
        off = at; t = substr(lo, off + 1)
      }
      if (!p) next
      f = substr(line, p + length("from:")); sub(/ +· .*$/, "", f)
      carry = ""; pendnum = 0; depth = 0; tok = ""
      for (j = 1; j <= length(f) + 1; j++) {
        ch = (j <= length(f)) ? substr(f, j, 1) : " "
        if (ch ~ /[][(){} ,;&+\/]/) {
          if (tok != "") credit(tok, depth)
          tok = ""
          if (ch ~ /[[({]/) depth++
          else if (ch ~ /[])}]/ && depth > 0) depth--
          continue
        }
        tok = tok ch
      }
      flush()
      next
    }
    /^\|/ {                                          # a verify table: find its # and Verdict columns, then read them
      k = split($0, c, "|")
      if (!vcol) {
        for (i = 2; i < k; i++) { h = c[i]; gsub(/[ \t\r*]/, "", h); h = tolower(h); if (h == "verdict") vcol = i; else if (h == "#") ncol = i }
        next
      }
      v = c[vcol]; sub(/^[^A-Za-z]*/, "", v); v = (match(v, /^[A-Za-z]+/) ? toupper(substr(v, 1, RLENGTH)) : "")
      num = c[ncol]; gsub(/[ \t\r*#.]/, "", num); num = tolower(num)
      if (v == "REFUTED" && num ~ /^c?[0-9]+[a-z]?$/) refd[num] = 1
    }
    END {
      for (v in refd) { k = split(owners[v], o, " "); for (i = 1; i <= k; i++) if (o[i] != "") refuted[o[i]]++ }
      for (s in seen) printf "%s\t%d\t%d\t%d\n", s, kept[s], cut[s], refuted[s]
    }' "$run/synthesis.md" ${1+"$@"}
}

# Record a completed run's seats in the ledger; re-recording a run replaces its rows. Prints the count.
ledger_record() {
  local run="$1" home ledger name mode date counts new="" slug tok f raised line rows=0 vt=0
  case "$run" in */runs/*) home="${run%/runs/*}" ;; *) home="$(council_home)" ;; esac   # the run's own council home
  ledger="$home/ledger.tsv"
  [ -f "$run/seats.tsv" ] || { printf '0'; return 0; }
  name="${run##*/}"; mode="$(field mode "$run/session-state.md")"; date="$(printf '%s' "$name" | cut -c1-10)"
  counts="$(synthesis_counts "$run")"
  while IFS="$TAB" read -r slug tok; do
    [ -n "$slug" ] || continue
    case "$slug" in verify-*|diagnose-*) vt=$((vt + tok)); continue ;; esac
    f="$(seat_out "$run" "$slug")"
    case "$slug" in
      *-r[0-9]*) raised=0 ;;                           # a war room's round 2 raises nothing new: from: cites round 1
      *) raised="$(index_lines "$f" | awk -F'\t' '$6 == "index"' | grep -c . || true)" ;;   # the Index's items only
    esac
    line="$(printf '%s\n' "$counts" | SLUG="$slug" awk -F'\t' '$1 == ENVIRON["SLUG"] { print $2 "\t" $3 "\t" $4; exit }')"
    [ -n "$line" ] || line="$(printf '0\t0\t0')"
    new="$new$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' "$date" "$name" "${mode:--}" "$slug" "${raised:-0}" "$line" "$tok")
"
    rows=$((rows + 1))
  done <<SEATS
$(awk -F'\t' 'NR > 1 && $2 != "skipped" && $2 != "queued" { print $1 "\t" (($4 ~ /^[0-9]+$/) ? $4 : 0) }' "$run/seats.tsv")
SEATS
  [ "$vt" -eq 0 ] || new="$new$(printf '%s\t%s\t%s\t(verifiers)\t-\t-\t-\t-\t%s' "$date" "$name" "${mode:--}" "$vt")
"
  [ -n "$new" ] || { printf '0'; return 0; }
  if [ ! -f "$ledger" ] && ! printf 'date\trun\tmode\tseat\traised\tkept\tcut\trefuted\ttokens\n' > "$ledger" 2>/dev/null; then
    printf 'council: could not write %s — the ledger was not updated\n' "$ledger" >&2; printf '0'; return 0
  fi
  if { RUN="$name" awk -F'\t' '$2 != ENVIRON["RUN"]' "$ledger"; printf '%s' "$new"; } > "$ledger.tmp$$" 2>/dev/null \
     && mv "$ledger.tmp$$" "$ledger" 2>/dev/null; then
    printf '%s' "$rows"
  else
    rm -f "$ledger.tmp$$" 2>/dev/null
    printf 'council: could not write %s — the ledger was not updated\n' "$ledger" >&2; printf '0'
  fi
}

cmd_ledger() {
  local ledger last="${1:-10}"
  ledger="$(council_home)/ledger.tsv"
  case "$last" in ''|*[!0-9]*) die "usage: council ledger [how many recent runs, default 10]" ;; esac
  [ -f "$ledger" ] || { say "no ledger yet — every completed run adds its seats to $ledger"; return 0; }
  LAST="$last" awk -F'\t' '
    NR == 1 { next }
    { row[NR] = $0; if (!($2 in seen)) { seen[$2] = 1; order[++nr] = $2 } }
    END {
      if (nr == 0) { print "the ledger has no runs yet"; exit }
      first = nr - ENVIRON["LAST"] + 1; if (first < 1) first = 1
      for (i = first; i <= nr; i++) keep[order[i]] = 1
      for (r = 2; r <= NR; r++) {
        if (!(r in row)) continue
        split(row[r], f, "\t"); if (!(f[2] in keep)) continue
        s = f[4]; sub(/-(r[0-9]+|[a-z])$/, "", s)        # a split worker (hunt-a) or a fresh round-2 one (hunt-r2) is its seat
        if (!(s in runs)) { names[++ns] = s; runs[s] = 0 }
        if (!((f[2], s) in counted)) { counted[f[2], s] = 1; runs[s]++ }
        raised[s] += f[5]; kept[s] += f[6]; cut[s] += f[7]; refd[s] += f[8]; tok[s] += f[9]
      }
      printf "%-16s %4s %6s %5s %4s %7s %8s %9s\n", "seat", "runs", "raised", "kept", "cut", "refuted", "~k/run", "shipped"
      for (i = 1; i <= ns; i++) {
        s = names[i]; ship = kept[s] - refd[s]
        pct = (raised[s] > 0) ? int(100 * ship / raised[s] + 0.5) "%" : "-"
        printf "%-16s %4d %6d %5d %4d %7d %8d %9s\n", s, runs[s], raised[s], kept[s], cut[s], refd[s], int(tok[s] / runs[s] / 1000 + 0.5), pct
      }
      printf "over the last %d completed run(s) · shipped = kept and not refuted, as a share of items raised\n", nr - first + 1
    }' "$ledger"
}

# ------------------------------------------------------------------------------------------------

usage() {
  cat <<'EOF'
council — the Small Council's helper (bash + git)

  council home                           where the council lives (.council/ of the main checkout)
  council run open <mode> [--alongside] [--session=ID]
                                         open a run for a mode, e.g. council-review; prints its folder
  council run status [--all]             open runs, this tree's first (the last 20 with --all)
  council run close [--status complete|abandoned|paused]
  council run resume [--run <folder>]    carry on with an open run (a paused one too) in this session:
                                         in progress again, this session recorded as its driver
  council state [key=value …]            show or update the run's session-state header
  council seat <slug> <state> [agent=ID] [tokens=N] [note=TEXT]
                                         record a worker: queued|running|done|failed|blocked|skipped
  council index [--base REF]             change index → <run>/index.md (hunks, symbols, callers, tests)
  council gate <name> [-- '<command>']   run one gate — quote the whole command, so && and quotes stay
                                         inside it; output and exit code → <run>/gates/
  council gate --all [--at grounding|verify]
                                         run the configured gates
  council gates                          list the configured gates
  council changed [--glob '<pat>'] [--each] -- <cmd>
                                         run <cmd> over just the files this change touches (0 when none)
  council collect                        check every seat file named in the brief (and a war room's debate.md)
  council check [file …] [--base REF]    check citations and origin (default: synthesis.md)
  council map status                     how far the map is behind HEAD, by area
  council fingerprint [check]            the stack's fingerprint; check compares it with the config
  council memory [index|check]           memory's one-line index · anchors that went stale
  council memory select [path|slug …]    the entries in scope (default: the run's files and seats)
  council prior [path …]                 earlier council work on these paths (default: the index)
  council ask save [slug]                file the run's ask.md — the user's words — under .council/asks/;
                                         secret-looking strings are redacted; records ask= in the state
  council ledger [N]                     each seat's record over the last N completed runs (default 10)
  council doctor                         drift scan; every finding comes with a fix

Run-scoped commands act on the one in-progress run on this working tree; otherwise pass --run <folder>
(a path, or a folder name under runs/). Every flag also takes the --flag=value form. A command refuses
any word or flag it doesn't take.
EOF
}

# A command given a flag it never reads fails loudly rather than doing something else. --run is taken
# everywhere (the Chair passes it to every command when several runs are open); "--" means the command
# takes a command of its own after --.
takes_flags() {
  local label="$1" f ok
  shift
  ok=" run ${1+$*} "                    # ${1+…}: bash 3.2 calls an empty "$@" or $* unbound under set -u
  for f in $FLAGS; do
    case "$ok" in *" $f "*) ;; *) die "$label doesn't take --$f — see: council help" ;; esac
  done
  case "$ok" in *" -- "*) ;; *) [ "${#AFTER_DD[@]}" -eq 0 ] || die "$label takes nothing after -- — see: council help" ;; esac
}

no_words() { local label="$1"; shift; [ $# -eq 0 ] || die "$label doesn't take '$*' — see: council help"; }

main() {
  RUN_ARG="" CODE_ROOT_ARG="" STATUS_ARG="" BASE_ARG="" AT_ARG="" ALL=0 GATE_CMD="" SESSION_ARG="" ALONGSIDE=0 FLAGS=""
  AFTER_DD=()
  local -a pos
  local cmd sub flag val w
  pos=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --run|--code-root|--status|--base|--at|--session)
                   flag="${1#--}"
                   [ $# -ge 2 ] || case "$flag" in
                     run|code-root) die "--$flag needs a folder" ;;
                     base) die "--base needs a ref" ;;
                     at) die "--at needs grounding or verify" ;;
                     *) die "--$flag needs a value" ;;
                   esac
                   val="$2"; shift 2 ;;
      --run=*|--code-root=*|--status=*|--base=*|--at=*|--session=*)
                   flag="${1%%=*}"; flag="${flag#--}"; val="${1#*=}"; shift ;;
      --alongside|--all) flag="${1#--}"; val=1; shift ;;
      --alongside=*|--all=*) die "${1%%=*} takes no value" ;;
      --glob)      pos+=("$1"); shift                                   # council changed reads its own options
                   [ $# -eq 0 ] || { pos+=("$1"); shift; }
                   continue ;;
      --glob=*|--each) pos+=("$1"); shift; continue ;;
      --)          shift
                   AFTER_DD=(${1+"$@"})                                 # the words themselves, for council changed
                   if [ $# -eq 1 ]; then GATE_CMD="$1"                  # one quoted string: a shell command, as written
                   elif [ $# -gt 1 ]; then GATE_CMD="$(printf '%q ' "$@")"; GATE_CMD="${GATE_CMD% }"   # separate words: kept intact
                   fi
                   break ;;
      -h|--help)   usage; exit 0 ;;
      -?*)         die "unknown option '$1' — see: council help" ;;
      *)           pos+=("$1"); shift; continue ;;
    esac
    [ -n "$val" ] || die "--$flag needs a value"
    case "$flag" in
      run) RUN_ARG="$val" ;;       code-root) CODE_ROOT_ARG="$val" ;;  status) STATUS_ARG="$val" ;;
      base) BASE_ARG="$val" ;;     at) AT_ARG="$val" ;;                session) SESSION_ARG="$val" ;;
      alongside) ALONGSIDE=1 ;;    all) ALL=1 ;;
    esac
    FLAGS="$FLAGS $flag"
  done
  set -- "${pos[@]+"${pos[@]}"}"
  [ $# -gt 0 ] || { [ -z "$FLAGS" ] || die "a flag needs a command — see: council help"; usage; exit 0; }
  cmd="$1"; shift
  case "$cmd" in
    home)    takes_flags home; no_words home ${1+"$@"}; council_home ;;
    run)
      sub="${1:-}"; [ $# -eq 0 ] || shift
      case "$sub" in
        open)   takes_flags "run open" alongside session code-root
                [ $# -le 1 ] || die "run open takes one mode (got: $*)"
                cmd_run_open ${1+"$@"} ;;
        close)  takes_flags "run close" status; no_words "run close" ${1+"$@"}; cmd_run_close ;;
        status) takes_flags "run status" all; no_words "run status" ${1+"$@"}; cmd_run_status ;;
        resume) takes_flags "run resume" session; no_words "run resume" ${1+"$@"}; cmd_run_resume ;;
        *) die "usage: council run open <mode> | run status [--all] | run close [--status …] | run resume [--run <folder>]" ;;
      esac ;;
    state)   takes_flags state; cmd_state ${1+"$@"} ;;
    seat)    takes_flags seat; cmd_seat ${1+"$@"} ;;
    index)   takes_flags index base; no_words index ${1+"$@"}; cmd_index ;;
    gate)    takes_flags gate all at --
             if [ "$ALL" = 1 ]; then
               no_words "gate --all" ${1+"$@"}
               [ -z "$GATE_CMD" ] || die "gate --all runs the configured gates — it takes no command after --"
             else
               [ -z "$AT_ARG" ] || die "--at works only with gate --all"
             fi
             cmd_gate ${1+"$@"} ;;
    gates)   takes_flags gates; no_words gates ${1+"$@"}; cmd_gates ;;
    changed) takes_flags changed base code-root --; cmd_changed ${1+"$@"} ;;
    collect) takes_flags collect; no_words collect ${1+"$@"}; cmd_collect ;;
    check)   takes_flags check base
             for w in ${1+"$@"}; do [ -f "$w" ] || die "check: no such file: $w"; done
             cmd_check ${1+"$@"} ;;
    map)     takes_flags map; [ $# -le 1 ] || die "usage: council map status"; cmd_map ${1+"$@"} ;;
    fingerprint) takes_flags fingerprint
             [ $# -le 1 ] || die "usage: council fingerprint [check]"
             case "${1:-}" in ''|check) ;; *) die "usage: council fingerprint [check]" ;; esac
             cmd_fingerprint ${1+"$@"} ;;
    memory)  takes_flags memory
             case "${1:-index}" in select) ;; *) [ $# -le 1 ] || die "usage: council memory [index | select [path|slug …] | check]" ;; esac
             cmd_memory ${1+"$@"} ;;
    prior)   takes_flags prior; cmd_prior ${1+"$@"} ;;
    ask)     takes_flags ask; [ $# -le 2 ] || die "usage: council ask save [slug]"; cmd_ask ${1+"$@"} ;;
    ledger)  takes_flags ledger; [ $# -le 1 ] || die "usage: council ledger [N]"; cmd_ledger ${1+"$@"} ;;
    doctor)  takes_flags doctor; no_words doctor ${1+"$@"}; cmd_doctor ;;
    version) takes_flags version; no_words version ${1+"$@"}; say "council $COUNCIL_VERSION" ;;
    help)    takes_flags help; no_words help ${1+"$@"}; usage ;;
    *) die "unknown command '$cmd' — see: council help" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main ${1+"$@"}; fi
